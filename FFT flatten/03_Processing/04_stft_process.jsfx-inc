// Surround FFT Flattener - STFT processing (analysis/synthesis)

function sff_display_write_mag_db(bin, mag_lin) (
  (bin < SFF_DISPLAY_BINS) ? (
    sff_display_mag_db[bin] = sff_linear_to_db(max(mag_lin, EPS));
  ) : 0;
);

function sff_display_write_gain_db(bin, gain_db, is_right) (
  (bin < SFF_DISPLAY_BINS) ? (
    is_right ? (
      sff_display_gain_db[bin] = 0.5 * (sff_display_gain_db[bin] + gain_db);
    ) : (
      sff_display_gain_db[bin] = gain_db;
    );
  ) : 0;
);

function sff_fill_spec_from_ring(spec_base, in_ring_base) local(n, i, ri, ts) (
  n = fft_size|0;
  i = 0;
  loop(n,
    ri = (sff_ring_pos + i) % n;
    ts = in_ring_base[ri] * sff_window[i];
    spec_base[i*2] = ts;
    spec_base[i*2 + 1] = 0;
    i += 1;
  );
);

function sff_compute_mag_cache_from_spec(mag_cache_base, spec_base) local(k, re, im, mag) (
  k = 0;
  loop(pos_bin_count,
    re = spec_base[k*2];
    im = spec_base[k*2 + 1];
    mag = sqrt(re*re + im*im);
    mag_cache_base[k] = mag;
    k += 1;
  );
);

function sff_copy_dry_spectra(n) (
  memcpy(sff_spec_dry_L, sff_spec_L, 2*n);
  memcpy(sff_spec_dry_R, sff_spec_R, 2*n);
);

function sff_blend_processed_band_with_dry(spec_base, dry_base) local(n, k, kn, mix, re, im) (
  n = fft_size|0;
  mix = band_wet * 0.01;
  mix >= 0.999 ? 0 :
  mix <= 0.001 ? (
    // Fully dry: restore dry spectrum quickly
    memcpy(spec_base, dry_base, 2*n);
  ) : (
    k = low_cut_bin;
    loop(max(high_cut_bin - low_cut_bin + 1, 0),
      // pos bin
      re = spec_base[k*2];
      im = spec_base[k*2 + 1];
      spec_base[k*2] = dry_base[k*2] + (re - dry_base[k*2]) * mix;
      spec_base[k*2 + 1] = dry_base[k*2 + 1] + (im - dry_base[k*2 + 1]) * mix;

      // neg bin
      (k > 0 && k < (pos_bin_count-1)) ? (
        kn = (n - k)|0;
        re = spec_base[kn*2];
        im = spec_base[kn*2 + 1];
        spec_base[kn*2] = dry_base[kn*2] + (re - dry_base[kn*2]) * mix;
        spec_base[kn*2 + 1] = dry_base[kn*2 + 1] + (im - dry_base[kn*2 + 1]) * mix;
      ) : 0;

      k += 1;
    );
  );
);

function sff_recompute_deltas_with_stride(magL_base, magR_base, radius, stride) local(npos, k, step, lastk, nextk, a, b, t, vL, vR, vM, maxk, interp_i) (
  npos = pos_bin_count|0;
  step = max(stride, 1)|0;

  // First pass: compute at stride points
  k = 0;
  loop(npos,
    (k % step) == 0 ? (
      sff_delta_db_L[k] = sff_compute_delta_db_for_bin(magL_base, k, radius);
      sff_delta_db_R[k] = sff_compute_delta_db_for_bin(magR_base, k, radius);
      sff_delta_db_link[k] = sff_compute_delta_db_for_bin_link(magL_base, magR_base, k, radius);
    ) : 0;

    // Always refresh display bins while we're here
    (k < SFF_DISPLAY_BINS) ? (
      vM = 0.5 * (magL_base[k] + magR_base[k]);
      sff_display_write_mag_db(k, vM);
    ) : 0;

    k += 1;
  );

  // Second pass: fill gaps by linear interpolation between stride points
  step > 1 ? (
    lastk = 0;
    // Ensure first anchor exists
    (lastk % step) != 0 ? (lastk = 0;) : 0;
    k = 1;
    loop(npos-1,
      (k % step) == 0 ? (
        // interpolate (lastk..k)
        interp_i = lastk + 1;
        loop(k - lastk - 1,
          t = (interp_i - lastk) / ((k - lastk) + EPS);
          sff_delta_db_L[interp_i] = sff_delta_db_L[lastk] + (sff_delta_db_L[k] - sff_delta_db_L[lastk]) * t;
          sff_delta_db_R[interp_i] = sff_delta_db_R[lastk] + (sff_delta_db_R[k] - sff_delta_db_R[lastk]) * t;
          sff_delta_db_link[interp_i] = sff_delta_db_link[lastk] + (sff_delta_db_link[k] - sff_delta_db_link[lastk]) * t;
          interp_i += 1;
        );
        lastk = k;
      ) : 0;
      k += 1;
    );

    // Tail fill: hold last anchor to end
    k = lastk + 1;
    loop(npos - lastk - 1,
      sff_delta_db_L[k] = sff_delta_db_L[lastk];
      sff_delta_db_R[k] = sff_delta_db_R[lastk];
      sff_delta_db_link[k] = sff_delta_db_link[lastk];
      k += 1;
    );
  ) : 0;
);

function sff_apply_gains_to_spec(spec_base, gain_db_base, delta_db_base, mag_base, is_right) local(n, k, kn, band, hz, target_gain_db, smooth_gain_db, g_lin, link, ind_delta, link_delta, delta, str_eff, active) (
  n = fft_size|0;
  link = stereo_link * 0.01;

  k = 0;
  loop(pos_bin_count,
    // Avoid stale delta usage (eco interval / parameter changes):
    // If this bin is currently bypassed by cutoff/band gates, force target gain to 0.
    active = sff_bin_is_active(k, mag_base[k]);

    hz = k * bin_hz;
    band = sff_get_band_index_for_hz(hz);

    // Effective strength includes per-band mul + transient scaling
    str_eff = strength * sff_get_band_strength_mul(band) * transient_strength_scale;

    ind_delta = delta_db_base[k];
    link_delta = sff_delta_db_link[k];
    delta = ind_delta * (1 - link) + link_delta * link;

    target_gain_db = active ? sff_clamp(delta * str_eff, -max_adjust_db, max_adjust_db) : 0;
    smooth_gain_db = sff_smooth_gain_db(gain_db_base, k, target_gain_db);
    g_lin = sff_db_to_linear(smooth_gain_db);

    spec_base[k*2] *= g_lin;
    spec_base[k*2 + 1] *= g_lin;

    (k > 0 && k < (pos_bin_count-1)) ? (
      kn = (n - k)|0;
      spec_base[kn*2] *= g_lin;
      spec_base[kn*2 + 1] *= g_lin;
    ) : 0;

    sff_display_write_gain_db(k, smooth_gain_db, is_right);

    k += 1;
  );
);

function sff_overlap_add_from_spec(out_ring_base, spec_base) local(n, outn, out_write_base, i, w) (
  n = fft_size|0;
  outn = out_buf_size|0;
  out_write_base = (sff_out_read_pos + sff_latency) % outn;

  i = 0;
  loop(n,
    w = sff_window[i];
    out_ring_base[(out_write_base + i) % outn] += (spec_base[i*2] * ifft_scale) * w;
    i += 1;
  );
);

function sff_apply_linked_gains_to_specs() local(n, k, kn, hz, band, str_eff, target_gain_db, smooth_gain_db, g_lin) (
  n = fft_size|0;

  // Clear display gain accumulator each hop (we overwrite)
  memset(sff_display_gain_db, 0, SFF_DISPLAY_BINS);

  k = 0;
  loop(pos_bin_count,
    hz = k * bin_hz;
    band = sff_get_band_index_for_hz(hz);
    str_eff = strength * sff_get_band_strength_mul(band) * transient_strength_scale;

    // Same stale-safe gating for linked mode (use avg mag for cutoff/band range)
    target_gain_db = sff_bin_is_active(k, 0.5 * (magL_base[k] + magR_base[k])) ? (
      sff_clamp(sff_delta_db_link[k] * str_eff, -max_adjust_db, max_adjust_db)
    ) : 0;
    smooth_gain_db = sff_smooth_gain_db(sff_gain_db_link, k, target_gain_db);
    g_lin = sff_db_to_linear(smooth_gain_db);

    // Apply same gain to both channels
    sff_spec_L[k*2] *= g_lin; sff_spec_L[k*2 + 1] *= g_lin;
    sff_spec_R[k*2] *= g_lin; sff_spec_R[k*2 + 1] *= g_lin;

    (k > 0 && k < (pos_bin_count-1)) ? (
      kn = (n - k)|0;
      sff_spec_L[kn*2] *= g_lin; sff_spec_L[kn*2 + 1] *= g_lin;
      sff_spec_R[kn*2] *= g_lin; sff_spec_R[kn*2 + 1] *= g_lin;
    ) : 0;

    sff_display_write_gain_db(k, smooth_gain_db, 0);
    k += 1;
  );
);

function sff_process_stereo_frame() local(n, k, do_recompute, radius, mag_avg_lin, i, ri, m, s, w, outn, out_write_base) (
  n = fft_size|0;
  radius = neighbor_radius|0;

  // Build + FFT (LR or MS domain)
  ms_mode ? (
    // Spec L = Mid, Spec R = Side
    i = 0;
    loop(n,
      ri = (sff_ring_pos + i) % n;
      m = 0.5 * (sff_in_ring_L[ri] + sff_in_ring_R[ri]);
      s = 0.5 * (sff_in_ring_L[ri] - sff_in_ring_R[ri]);
      w = sff_window[i];
      sff_spec_L[i*2] = m * w;
      sff_spec_L[i*2 + 1] = 0;
      sff_spec_R[i*2] = s * w;
      sff_spec_R[i*2 + 1] = 0;
      i += 1;
    );
  ) : (
    sff_fill_spec_from_ring(sff_spec_L, sff_in_ring_L);
    sff_fill_spec_from_ring(sff_spec_R, sff_in_ring_R);
  );
  fft(sff_spec_L, n);
  fft(sff_spec_R, n);

  // Magnitude caches (linear)
  sff_compute_mag_cache_from_spec(sff_mag_cache_L, sff_spec_L);
  sff_compute_mag_cache_from_spec(sff_mag_cache_R, sff_spec_R);

  // Eco magnitude smoothing
  eco_mode ? (
    k = 0;
    loop(pos_bin_count,
      sff_mag_eco_L[k] += (sff_mag_cache_L[k] - sff_mag_eco_L[k]) * eco_blend;
      sff_mag_eco_R[k] += (sff_mag_cache_R[k] - sff_mag_eco_R[k]) * eco_blend;
      k += 1;
    );
  );

  magL_base = eco_mode ? sff_mag_eco_L : sff_mag_cache_L;
  magR_base = eco_mode ? sff_mag_eco_R : sff_mag_cache_R;

  // Preserve dry spectra for band wet/dry blending
  sff_copy_dry_spectra(n);

  // Decide whether to recompute heavy deltas this hop
  do_recompute = eco_mode ? (
    sff_eco_hop_index += 1;
    (sff_eco_hop_index % max(eco_interval, 1)) == 0 ? 1 : 0;
  ) : 1;

  // Force delta refresh on relevant parameter changes
  sff_force_recompute_deltas ? (
    do_recompute = 1;
    sff_force_recompute_deltas = 0;
  ) : 0;

  do_recompute ? (
    sff_recompute_deltas_with_stride(magL_base, magR_base, radius, eco_stride);
  ) : (
    // Still update UI magnitudes cheaply
    k = 0;
    loop(SFF_DISPLAY_BINS,
      mag_avg_lin = 0.5 * (magL_base[k] + magR_base[k]);
      sff_display_write_mag_db(k, mag_avg_lin);
      k += 1;
    );
  );

  // Apply gains (uses cached deltas + smoothing every hop)
  stereo_link >= 99.5 ? (
    sff_apply_linked_gains_to_specs();
  ) : (
    // Clear display gain accumulator each hop (we overwrite then average with R)
    memset(sff_display_gain_db, 0, SFF_DISPLAY_BINS);
    sff_apply_gains_to_spec(sff_spec_L, sff_gain_db_L, sff_delta_db_L, magL_base, 0);
    sff_apply_gains_to_spec(sff_spec_R, sff_gain_db_R, sff_delta_db_R, magR_base, 1);
  );

  // Band wet/dry (frequency-domain) for the processed band only
  sff_blend_processed_band_with_dry(sff_spec_L, sff_spec_dry_L);
  sff_blend_processed_band_with_dry(sff_spec_R, sff_spec_dry_R);

  // IFFT + OLA
  ifft(sff_spec_L, n);
  ifft(sff_spec_R, n);
  ms_mode ? (
    // Spec L = Mid, Spec R = Side -> convert to L/R during overlap-add
    outn = out_buf_size|0;
    out_write_base = (sff_out_read_pos + sff_latency) % outn;
    i = 0;
    loop(n,
      w = sff_window[i];
      m = (sff_spec_L[i*2] * ifft_scale) * w;
      s = (sff_spec_R[i*2] * ifft_scale) * w;
      sff_out_ring_L[(out_write_base + i) % outn] += (m + s);
      sff_out_ring_R[(out_write_base + i) % outn] += (m - s);
      i += 1;
    );
  ) : (
    sff_overlap_add_from_spec(sff_out_ring_L, sff_spec_L);
    sff_overlap_add_from_spec(sff_out_ring_R, sff_spec_R);
  );
);

