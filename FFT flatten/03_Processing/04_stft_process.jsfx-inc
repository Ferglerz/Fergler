// Surround FFT Flattener - STFT processing (analysis/synthesis)

function sff_display_write_mag_db(bin, mag_lin) (
  (bin < SFF_DISPLAY_BINS) ? (
    sff_display_mag_db[bin] = sff_linear_to_db(max(mag_lin, EPS));
  ) : 0;
);

function sff_display_write_gain_db(bin, gain_db, is_right) (
  (bin < SFF_DISPLAY_BINS) ? (
    is_right ? (
      sff_display_gain_db[bin] = 0.5 * (sff_display_gain_db[bin] + gain_db);
    ) : (
      sff_display_gain_db[bin] = gain_db;
    );
  ) : 0;
);

function sff_fill_spec_from_ring(spec_base, in_ring_base) local(n, i, ri, ts) (
  n = fft_size|0;
  i = 0;
  loop(n,
    ri = (sff_ring_pos + i) % n;
    ts = in_ring_base[ri] * sff_window[i];
    spec_base[i*2] = ts;
    spec_base[i*2 + 1] = 0;
    i += 1;
  );
);

function sff_compute_mag_cache_from_spec(mag_cache_base, spec_base) local(k, re, im, mag) (
  k = 0;
  loop(pos_bin_count,
    re = spec_base[k*2];
    im = spec_base[k*2 + 1];
    mag = sqrt(re*re + im*im);
    mag_cache_base[k] = mag;
    k += 1;
  );
);

function sff_apply_gains_to_spec(spec_base, gain_db_base, delta_db_base, is_right) local(n, k, kn, band, hz, target_gain_db, smooth_gain_db, g_lin, link, ind_delta, link_delta, delta, str_eff) (
  n = fft_size|0;
  link = stereo_link * 0.01;

  k = 0;
  loop(pos_bin_count,
    hz = k * bin_hz;
    band = sff_get_band_index_for_hz(hz);

    // Effective strength includes per-band mul + transient scaling
    str_eff = strength * sff_get_band_strength_mul(band) * transient_strength_scale;

    ind_delta = delta_db_base[k];
    link_delta = sff_delta_db_link[k];
    delta = ind_delta * (1 - link) + link_delta * link;

    target_gain_db = sff_clamp(delta * str_eff, -max_adjust_db, max_adjust_db);
    smooth_gain_db = sff_smooth_gain_db(gain_db_base, k, target_gain_db);
    g_lin = sff_db_to_linear(smooth_gain_db);

    spec_base[k*2] *= g_lin;
    spec_base[k*2 + 1] *= g_lin;

    (k > 0 && k < (pos_bin_count-1)) ? (
      kn = (n - k)|0;
      spec_base[kn*2] *= g_lin;
      spec_base[kn*2 + 1] *= g_lin;
    ) : 0;

    sff_display_write_gain_db(k, smooth_gain_db, is_right);

    k += 1;
  );
);

function sff_overlap_add_from_spec(out_ring_base, spec_base) local(n, outn, out_write_base, i, w) (
  n = fft_size|0;
  outn = out_buf_size|0;
  out_write_base = (sff_out_read_pos + sff_latency) % outn;

  i = 0;
  loop(n,
    w = sff_window[i];
    out_ring_base[(out_write_base + i) % outn] += (spec_base[i*2] * ifft_scale) * w;
    i += 1;
  );
);

function sff_apply_linked_gains_to_specs() local(n, k, kn, hz, band, str_eff, target_gain_db, smooth_gain_db, g_lin) (
  n = fft_size|0;

  // Clear display gain accumulator each hop (we overwrite)
  memset(sff_display_gain_db, 0, SFF_DISPLAY_BINS);

  k = 0;
  loop(pos_bin_count,
    hz = k * bin_hz;
    band = sff_get_band_index_for_hz(hz);
    str_eff = strength * sff_get_band_strength_mul(band) * transient_strength_scale;

    target_gain_db = sff_clamp(sff_delta_db_link[k] * str_eff, -max_adjust_db, max_adjust_db);
    smooth_gain_db = sff_smooth_gain_db(sff_gain_db_link, k, target_gain_db);
    g_lin = sff_db_to_linear(smooth_gain_db);

    // Apply same gain to both channels
    sff_spec_L[k*2] *= g_lin; sff_spec_L[k*2 + 1] *= g_lin;
    sff_spec_R[k*2] *= g_lin; sff_spec_R[k*2 + 1] *= g_lin;

    (k > 0 && k < (pos_bin_count-1)) ? (
      kn = (n - k)|0;
      sff_spec_L[kn*2] *= g_lin; sff_spec_L[kn*2 + 1] *= g_lin;
      sff_spec_R[kn*2] *= g_lin; sff_spec_R[kn*2 + 1] *= g_lin;
    ) : 0;

    sff_display_write_gain_db(k, smooth_gain_db, 0);
    k += 1;
  );
);

function sff_process_stereo_frame() local(n, k, do_recompute, radius, mag_avg_lin) (
  n = fft_size|0;
  radius = neighbor_radius|0;

  // Build + FFT
  sff_fill_spec_from_ring(sff_spec_L, sff_in_ring_L);
  sff_fill_spec_from_ring(sff_spec_R, sff_in_ring_R);
  fft(sff_spec_L, n);
  fft(sff_spec_R, n);

  // Magnitude caches (linear)
  sff_compute_mag_cache_from_spec(sff_mag_cache_L, sff_spec_L);
  sff_compute_mag_cache_from_spec(sff_mag_cache_R, sff_spec_R);

  // Eco magnitude smoothing
  eco_mode ? (
    k = 0;
    loop(pos_bin_count,
      sff_mag_eco_L[k] += (sff_mag_cache_L[k] - sff_mag_eco_L[k]) * eco_blend;
      sff_mag_eco_R[k] += (sff_mag_cache_R[k] - sff_mag_eco_R[k]) * eco_blend;
      k += 1;
    );
  );

  magL_base = eco_mode ? sff_mag_eco_L : sff_mag_cache_L;
  magR_base = eco_mode ? sff_mag_eco_R : sff_mag_cache_R;

  // Decide whether to recompute heavy deltas this hop
  do_recompute = eco_mode ? (
    sff_eco_hop_index += 1;
    (sff_eco_hop_index % max(eco_interval, 1)) == 0 ? 1 : 0;
  ) : 1;

  do_recompute ? (
    k = 0;
    loop(pos_bin_count,
      // Per-channel deltas
      sff_delta_db_L[k] = sff_compute_delta_db_for_bin(magL_base, k, radius);
      sff_delta_db_R[k] = sff_compute_delta_db_for_bin(magR_base, k, radius);
      sff_delta_db_link[k] = sff_compute_delta_db_for_bin_link(magL_base, magR_base, k, radius);

      mag_avg_lin = 0.5 * (magL_base[k] + magR_base[k]);
      sff_display_write_mag_db(k, mag_avg_lin);

      k += 1;
    );
  ) : (
    // Still update UI magnitudes cheaply
    k = 0;
    loop(SFF_DISPLAY_BINS,
      mag_avg_lin = 0.5 * (magL_base[k] + magR_base[k]);
      sff_display_write_mag_db(k, mag_avg_lin);
      k += 1;
    );
  );

  // Apply gains (uses cached deltas + smoothing every hop)
  stereo_link >= 99.5 ? (
    sff_apply_linked_gains_to_specs();
  ) : (
    // Clear display gain accumulator each hop (we overwrite then average with R)
    memset(sff_display_gain_db, 0, SFF_DISPLAY_BINS);
    sff_apply_gains_to_spec(sff_spec_L, sff_gain_db_L, sff_delta_db_L, 0);
    sff_apply_gains_to_spec(sff_spec_R, sff_gain_db_R, sff_delta_db_R, 1);
  );

  // IFFT + OLA
  ifft(sff_spec_L, n);
  ifft(sff_spec_R, n);
  sff_overlap_add_from_spec(sff_out_ring_L, sff_spec_L);
  sff_overlap_add_from_spec(sff_out_ring_R, sff_spec_R);
);

