desc:FFT Surround Flattener (WIP)
// Frequency-domain "surround leveling" based on adjacent FFT bins.
// Pre (feedforward) analysis only. Modular includes live under this folder.

options:gfx_hz=30

// --- User parameters ---
slider1:fft_size_sel=3<0,5,1{64,128,256,512,1024,2048}>FFT Size
slider2:strength=1<0,2,0.01>Strength
slider3:attack_ms=10<0.1,200,0.1>Attack (ms)
slider4:release_ms=100<1,2000,1>Release (ms)
slider5:min_operate_db=-80<-120,0,0.1>Operate Min (dB)
slider6:max_operate_db=0<-120,0,0.1>Operate Max (dB)
slider7:max_adjust_db=12<0,48,0.1>Max Adjust (dB)
slider8:eco_mode=0<0,1,1{Off,On}>Eco Mode (cache)
slider9:eco_blend=0.25<0,1,0.01>Eco Blend

// --- Future 4-band split points (hidden for now, but editable) ---
slider10:band_split1_hz=100<20,20000,1>-Band Split 1 (Hz)
slider11:band_split2_hz=1000<20,20000,1>-Band Split 2 (Hz)
slider12:band_split3_hz=2000<20,20000,1>-Band Split 3 (Hz)

// Per-band operate ranges (hidden; currently use same defaults)
slider13:band1_min_db=-80<-120,0,0.1>-Band1 Min (dB)
slider14:band1_max_db=0<-120,0,0.1>-Band1 Max (dB)
slider15:band2_min_db=-80<-120,0,0.1>-Band2 Min (dB)
slider16:band2_max_db=0<-120,0,0.1>-Band2 Max (dB)
slider17:band3_min_db=-80<-120,0,0.1>-Band3 Min (dB)
slider18:band3_max_db=0<-120,0,0.1>-Band3 Max (dB)
slider19:band4_min_db=-80<-120,0,0.1>-Band4 Min (dB)
slider20:band4_max_db=0<-120,0,0.1>-Band4 Max (dB)

// --- Imports (relative to this .jsfx file) ---
import 01_Utils/01_constants.jsfx-inc
import 01_Utils/02_math_utils.jsfx-inc

import 02_FFT/01_fft_memory.jsfx-inc
import 02_FFT/02_fft_core.jsfx-inc

import 03_Processing/01_band_config.jsfx-inc
import 03_Processing/02_attack_release.jsfx-inc
import 03_Processing/03_surround_logic.jsfx-inc
import 03_Processing/04_stft_process.jsfx-inc

import 04_UI/01_ui.jsfx-inc

@init
  sff_allocate_memory();

  // Set initial FFT size from enum selection
  sff_set_fft_size(64 << (fft_size_sel|0));

  // Latency/pipeline: keep simple fixed latency = fft_size samples
  sff_latency = fft_size|0;

@slider
  // Derive FFT size from selection
  desired_fft = 64 << (fft_size_sel|0);
  desired_fft != (fft_size|0) ? (
    sff_set_fft_size(desired_fft);
    sff_latency = fft_size|0;
  );

  // Map single operate range sliders into all band ranges for now
  band1_min_db = band2_min_db = band3_min_db = band4_min_db = min_operate_db;
  band1_max_db = band2_max_db = band3_max_db = band4_max_db = max_operate_db;

  // Keep split points ordered (simple guard)
  band_split2_hz < band_split1_hz ? (band_split2_hz = band_split1_hz;) : 0;
  band_split3_hz < band_split2_hz ? (band_split3_hz = band_split2_hz;) : 0;

  // PDC (unconditional, per rules)
  pdc_delay = sff_latency|0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

@block
  // Update hop-time-based smoothing coeffs
  sff_update_time_coeffs();

@sample
  // Read scheduled output and clear slot (overlap-add accumulator)
  outn = out_buf_size|0;
  outL = sff_out_ring_L[sff_out_read_pos];
  outR = sff_out_ring_R[sff_out_read_pos];
  sff_out_ring_L[sff_out_read_pos] = 0;
  sff_out_ring_R[sff_out_read_pos] = 0;

  // Push new input into analysis ring
  n = fft_size|0;
  sff_in_ring_L[sff_ring_pos] = spl0;
  sff_in_ring_R[sff_ring_pos] = spl1;

  // Advance positions
  sff_ring_pos = (sff_ring_pos + 1) % n;
  sff_out_read_pos = (sff_out_read_pos + 1) % outn;

  // Hop trigger
  sff_hop_counter += 1;
  sff_hop_counter >= hop_size ? (
    sff_hop_counter = 0;
    sff_process_frame_for_channel(sff_in_ring_L, sff_out_ring_L, sff_gain_db_L, sff_mag_cache_L, sff_mag_eco_L);
    sff_process_frame_for_channel(sff_in_ring_R, sff_out_ring_R, sff_gain_db_R, sff_mag_cache_R, sff_mag_eco_R);
  );

  // Output
  spl0 = outL;
  spl1 = outR;

@gfx 900 260
  sff_ui_draw();

