// UI Orchestration Module
// Main interface coordination and rendering orchestration

@init

//==============================================================================
// BLUR HELPER FUNCTIONS
//==============================================================================

// Apply blur to a rectangular region
function apply_blur_region(start_x, start_y, end_x, end_y) (
  gfx_x = start_x; gfx_y = start_y;
  gfx_blurto(end_x, end_y);
);

// Apply page blur for graph area
function apply_page_blur_graph_area() (
  apply_blur_region(GRAPH_X - 10, GRAPH_Y - 10, GRAPH_X + GRAPH_SIZE + 10, GRAPH_Y + GRAPH_SIZE + 10);
);

// Apply reflection blur (always active)
function apply_reflection_blur(meter_x, meter_w) (
  gfx_x = GRAPH_X - 10;
  gfx_y = GRAPH_Y + GRAPH_SIZE + 61;
  gfx_blurto(meter_x + meter_w + 10, gfx_y + 5);
);

//==============================================================================
// MAIN INTERFACE ORCHESTRATION
//==============================================================================

// Render Graph page content
function render_graph_page() local(clamped_input_db) (
  draw_graph_background();
  draw_input_histogram(INPUT_HISTOGRAM_OPACITY);
  draw_histogram(HISTOGRAM_OPACITY);
  
  draw_grid();
  draw_mixed_curves();
  draw_graph_points();
  update_and_render_trail_dots();
  
  is_audio_active ? (
    clamped_input_db = clamp(input_histogram_db, GRAPH_MIN_DB, GRAPH_MAX_DB);
    draw_indicator_circle(db_to_graph_x(clamped_input_db), db_to_graph_y(clamped_input_db), 4, 0.5, 0.9, 0.5, 0.8, 1);
  );
  
  draw_threshold_lines_on_graph();
  draw_labels_and_info();
  draw_compression_threshold_overlay();
  draw_ctrl_hint();
  gfx_a = 1.0;
);

// Render Filters page content
function render_filters_page_with_blur() (
  !should_render_page(PAGE_FILTERS) || page_fade_amounts[PAGE_FILTERS] > 0.01 ? (
    render_filters_page_buttons();
  );
);

function render_background_image() (
  gfx_x = 0; gfx_y = 0;
  gfx_blit(0, 1, 0);
);

function render_complete_interface() local(m_x, m_y, m_w, m_h) (
  m_x = get_meter_x(); m_y = get_meter_y(); m_w = get_meter_w(); m_h = get_meter_h();
  gfx_clear = 0x202020;

  menu_controls_hidden < 0.5 ? (
    (active_page == 0 || active_page == 1) ? draw_group(active_page, page_fade_amounts[active_page]);
    draw_group(3, 1.0);
    draw_group(2, 1.0);
    render_all_controls_with_page_filtering();
  );

  render_graph_page();
  render_filters_page_with_blur();
  
  draw_gain_reduction_meter();
  update_and_render_meter_trail_lines();
  apply_reflection_blur(m_x, m_w);
  
  draw_debug_performance_counters();
  render_custom_buttons();
  update_cursor();
);
