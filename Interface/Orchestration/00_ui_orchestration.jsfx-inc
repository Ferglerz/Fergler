// UI Orchestration Module
// Main interface coordination and rendering orchestration

@init

//==============================================================================
// BLUR HELPER FUNCTIONS
//==============================================================================

// Apply blur to a rectangular region
function apply_blur_region(start_x, start_y, end_x, end_y) (
  gfx_x = start_x; gfx_y = start_y;
  gfx_blurto(end_x, end_y);
);

// Apply page blur for graph area
function apply_page_blur_graph_area() (
  apply_blur_region(GRAPH_X - 10, GRAPH_Y - 10, GRAPH_X + GRAPH_SIZE + 10, GRAPH_Y + GRAPH_SIZE + 10);
);

// Apply reflection blur (always active)
function apply_reflection_blur(meter_x, meter_w) (
  gfx_x = GRAPH_X - 10;
  gfx_y = GRAPH_Y + GRAPH_SIZE + 20;  // Adjusted to match reflection position
  gfx_blurto(meter_x + meter_w + 10, gfx_y + 7);
);

//==============================================================================
// CONTROL READOUT DISPLAY
//==============================================================================

// Display control value readout when a control is being adjusted
function draw_control_readout() local(
  control_index, type, param_index, current_value, slider_config, formatting, format_options,
  suffix_str, formatted_str
) (
  ui_drag_control >= 0 ? (
    control_index = ui_drag_control;
    type = control_defs[control_index*11 + 0];
    
    // Only show readout for knobs (type 4) and faders/sliders (type 0, 3)
    (type == 0 || type == 3 || type == 4) ? (
      param_index = control_defs[control_index*11 + 5];
      current_value = slider(param_index);
      
      // Get suffix string
      get_control_suffix(control_index);
      suffix_str = #value_str;
      
      // Get formatting and format_options from slider_config
      type == 3 ? (
        // Parallax fader: get config from separate array
        slider_config = parallax_slider_configs[control_index];
        formatting = slider_config & 0xFF;
        format_options = (slider_config >> 8) & 0xFF;
      ) : (
        // Slider or knob: get config from control_defs
        slider_config = control_defs[control_index*11 + 8];
        formatting = (slider_config >> 24) & 0xFF;
        format_options = (slider_config >> 32) & 0xFF;
      );
      
      // Format the value
      format_slider_value(param_index, current_value, suffix_str, formatting, format_options);
      formatted_str = #temp_display_str;
      
      // Display at x194 y278 with size 18 font and transparent grey
      gfx_set(0.6, 0.6, 0.6, 0.8);  // Same transparent grey as Ctrl hints
      gfx_setfont(1, "Arial", 18);  // Size 18 font
      gfx_x = 194;
      gfx_y = 278;
      gfx_drawstr(formatted_str);
    );
  );
);

//==============================================================================
// MAIN INTERFACE ORCHESTRATION
//==============================================================================

// Render Graph page content
function render_graph_page() local(clamped_input_db) (
  draw_graph_background();
  draw_input_histogram(INPUT_HISTOGRAM_OPACITY);
  draw_histogram(HISTOGRAM_OPACITY);
  
  draw_grid();
  draw_mixed_curves();
  draw_graph_points();
  update_and_render_trail_dots();
  
  is_audio_active ? (
    clamped_input_db = clamp(input_histogram_db, GRAPH_MIN_DB, GRAPH_MAX_DB);
    draw_indicator_circle(db_to_graph_x(clamped_input_db), db_to_graph_y(clamped_input_db), 4, 0.5, 0.9, 0.5, 0.8, 1);
  );
  
  draw_threshold_lines_on_graph();
  draw_labels_and_info();
  draw_compression_threshold_overlay();
  gfx_a = 1.0;
);

// Render Filters page content
function render_filters_page_with_blur() (
  !should_render_page(PAGE_FILTERS) || page_fade_amounts[PAGE_FILTERS] > 0.01 ? (
    render_filters_page_buttons();
  );
);

function render_background_image() (
  gfx_x = 0; gfx_y = 0;
  gfx_blit(0, 0.29, 0);  // Render BG.png at 32% scale (3693x1576 -> 1182x504)
);

function render_complete_interface() local(m_x, m_y, m_w, m_h, m_x_right) (
  m_x = get_meter_x(); m_y = get_meter_y(); m_w = get_meter_w(); m_h = get_meter_h();
  m_x_right = get_meter_x_right();
  gfx_clear = 0x202020;
  
  // Render background image first
  render_background_image();

  menu_controls_hidden < 0.5 ? (
    draw_group(0, 1.0);   // Merged Input/Settings panel always visible
    draw_group(3, 1.0);
    draw_group(2, 1.0);
    draw_group(4, 1.0);  // Toolbar (Strength, Input Dep/GR Dep, RMS, Input Offset)
    render_all_controls_with_page_filtering();
    render_custom_buttons();
  );

  render_graph_page();
  render_filters_page_with_blur();
  
  draw_gain_reduction_meter();
  draw_gain_reduction_meter_right();  // Second meter for stereo
  update_and_render_meter_trail_lines();
  apply_reflection_blur(m_x_right + m_w, m_w);  // Blur extends to cover both meters
  
  // Overlays last: control readout (when dragging) and graph hint (when hovering)
  // Both set custom fonts; we restore default afterward so font state doesn't leak
  draw_control_readout();
  draw_ctrl_hint();
  gfx_setfont(0);
);