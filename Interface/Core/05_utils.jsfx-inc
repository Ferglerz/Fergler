// get_slider_config(), get_control_position_with_group_offset(), 
// get_control_x_with_group_offset(), get_control_y_with_group_offset(),
// calculate_normalized_position(), calculate_knob_normalized_position(),
// is_point_in_control() are provided by the library

// Step-point array base addresses (allocated inline in 04_UI_Controls/02_step_points.jsfx-inc init_step_points())
// These are declared here for early access by helper functions
// Variables default to 0 in JSFX, no initialization needed

// Step-point counts (initialized in 04_UI_Controls/02_step_points.jsfx-inc)
// Variables default to 0 in JSFX, no initialization needed

// Step-point and control utility functions use library versions from FerglerUI library
// get_step_point_count(), get_step_points_base(), find_step_point_index(), find_closest_step_point(),
// update_slider_value(), get_slider_config(), calculate_normalized_position(), etc. are provided by the library

//==============================================================================
// COORDINATE CLAMPING HELPERS
//==============================================================================

// Note: Graph coordinate conversion functions (db_to_graph_x, db_to_graph_y, etc.)
// are now defined in Interface/Services/00_coordinate_conversion.jsfx-inc

// Clamp x coordinate to graph bounds
// Parameters: x (coordinate), graph_x (left edge), graph_size (graph size)
function clamp_x_to_graph(x, graph_x, graph_size) (
  max(graph_x, min(graph_x + graph_size, x))
);

// Clamp y coordinate to graph bounds
// Parameters: y (coordinate), graph_y (top edge), graph_size (graph size)
function clamp_y_to_graph(y, graph_y, graph_size) (
  max(graph_y, min(graph_y + graph_size, y))
);

//==============================================================================
// DRAWING HELPERS
//==============================================================================

function draw_indicator_circle(x, y, radius, r, g, b, alpha, filled) (
  gfx_set(r, g, b, alpha);
  gfx_circle(x, y, radius, filled, 1); 
);

// Draw formatted text at position with color
function draw_text_at(r, g, b, a, x, y, format_str, value) (
  gfx_set(r, g, b, a);
  gfx_x = x;
  gfx_y = y;
  gfx_printf(format_str, value);
);

