// UI utility functions and coordinate conversions
// Relies on constants and control_defs from external includes

@init

//---- Slider config extraction (sets slider_config, slider_orientation, format_options) ----
function get_slider_config(control_index, control_type) (
  control_type == 3 ? (
    slider_config = parallax_slider_configs[control_index];
    format_options = (slider_config >> 8) & 0xFF;
    slider_orientation = ORIENTATION_HORIZONTAL;
  ) : (
    slider_config = control_defs[control_index*11 + 8];
    slider_orientation = (control_type==4) ? ORIENTATION_HORIZONTAL : slider_config & 0xFF;
    format_options = (slider_config >> 32) & 0xFF;
  );
);

//---- Control position with group offset ----
function get_control_position_with_group_offset(control_index) local(group_idx) (
  ctrl_x = control_defs[control_index*11 + 1];
  ctrl_y = control_defs[control_index*11 + 2];
  group_idx = control_defs[control_index*11 + 10];
  group_idx >= 0 ? (
    ctrl_x += group_defs[group_idx*6 + 0];
    ctrl_y += group_defs[group_idx*6 + 1];
  );
);
function get_control_x_with_group_offset(control_index) local(group_idx, x) (
  x = control_defs[control_index*11 + 1];
  group_idx = control_defs[control_index*11 + 10];
  group_idx >= 0 ? x + group_defs[group_idx*6 + 0] : x;
);
function get_control_y_with_group_offset(control_index) local(group_idx, y) (
  y = control_defs[control_index*11 + 2];
  group_idx = control_defs[control_index*11 + 10];
  group_idx >= 0 ? y + group_defs[group_idx*6 + 1] : y;
);

//---- Normalized position (0-1) from mouse coordinates ----
function calculate_normalized_position(control_index, mouse_x, mouse_y, slider_orientation, format_options)
local(x, y, w, h, pos) (
  slider_orientation == ORIENTATION_VERTICAL ? (
    y = get_control_y_with_group_offset(control_index);
    h = control_defs[control_index*11 + 4];
    pos = (mouse_y - y) / h;
    max(0, min(1, 1 - pos)); // 0 at top, 1 at bottom
  ) : (
    x = get_control_x_with_group_offset(control_index);
    w = control_defs[control_index*11 + 3];
    pos = (mouse_x - x) / w;
    pos = max(0, min(1, pos));
    format_options & OPTION_REVERSE ? 1.0 - pos : pos;
  )
);
// Knob normalized position (clock style 7:30-4:30)
function calculate_knob_normalized_position(control_index, mouse_x, mouse_y, format_options)
local(ctrl_w, cx, cy, dx, dy, a_deg, val) (
  get_control_position_with_group_offset(control_index);
  ctrl_w = control_defs[control_index*11 + 3];
  cx = ctrl_x + ctrl_w * 0.5;
  cy = ctrl_y + ctrl_w * 0.5;
  dx = mouse_x - cx;
  dy = mouse_y - cy;
  a_deg = atan2(dy, dx) * 180 / $pi;
  val =      a_deg < -135 ? 0
        : (a_deg >  45 ? 1
        : ((a_deg + 135) / 270));
  format_options & OPTION_REVERSE ? 1.0 - val : val;
);

//---- UI utilities ----
function is_point_in_control(x, y, control_index) (
  get_control_position_with_group_offset(control_index);
  ctrl_w = control_defs[control_index*11 + 3];
  ctrl_h = control_defs[control_index*11 + 4];
  x >= ctrl_x && x <= ctrl_x + ctrl_w && y >= ctrl_y && y <= ctrl_y + ctrl_h;
);

// Step-point functions use library versions from UI_Sliders/Core/05_step_points.jsfx-inc

//---- Slider value from mouse ----
function update_slider_value(control_index, mouse_x, mouse_y)
local(control_type, param_index, step_count, option_count, total_options, option_index, slider_orientation, format_options, slider_config, min_val, max_val, normalized_pos, ctrl_w, ctrl_x, raw_value, increment, pixels_per_option, mouse_pos_in_slider, step_points_base)
(
  control_type = control_defs[control_index*11 + 0];
  get_slider_config(control_index, control_type);
  min_val = control_defs[control_index*11 + 6];
  max_val = control_defs[control_index*11 + 7];
  param_index = control_defs[control_index*11 + 5];
  normalized_pos = calculate_normalized_position(control_index, mouse_x, mouse_y, slider_orientation, format_options);

  option_count = get_dropdown_option_count(param_index);
  step_count = get_step_point_count(param_index);
  total_options = option_count > 0 ? option_count : step_count;

  total_options > 0 ? (
    // Stepped/enum slider
    slider_orientation == ORIENTATION_VERTICAL ?
      option_index = floor(normalized_pos * total_options)
    :
      (ctrl_x = get_control_x_with_group_offset(control_index);
       ctrl_w = control_defs[control_index*11 + 3];
       pixels_per_option = ctrl_w / total_options;
       mouse_pos_in_slider = mouse_x - ctrl_x;
       option_index = floor(mouse_pos_in_slider / pixels_per_option);
      );
    option_index = max(0, min(total_options - 1, option_index));
    option_count > 0 ? option_index : (
      step_points_base = get_step_points_base(param_index);
      step_points_base[option_index];
    )
  ) : (
    raw_value = min_val + normalized_pos * (max_val - min_val);
    increment = get_slider_increment(param_index);
    increment > 0 ? floor(raw_value / increment + 0.5) * increment : raw_value;
  )
);

// Step-point search functions use library versions from UI_Sliders/Core/05_step_points.jsfx-inc

//---- Graph coordinate clamping ----
function clamp_x_to_graph(x, gx, s) (max(gx, min(gx+s, x)));
function clamp_y_to_graph(y, gy, s) (max(gy, min(gy+s, y)));

//---- Drawing helpers ----
function draw_indicator_circle(x, y, r, R, G, B, a, fill) (
  gfx_set(R,G,B,a);
  gfx_circle(x,y,r,fill,1);
);
function draw_text_at(R, G, B, a, x, y, fmt, val) (
  gfx_set(R,G,B,a);
  gfx_x=x; gfx_y=y; gfx_printf(fmt, val);
);
