// UI Configuration Module (Part 2 of UI Constants)
// Colors, menu configuration, group configuration, and debug panel constants
// Dependencies: UI_General/00_ui_constants.jsfx-inc (for layout constants)

@init

// Colors
UI_BG_R = 0.15; UI_BG_G = 0.15; UI_BG_B = 0.15;
SLIDER_BG_R = 0.3; SLIDER_BG_G = 0.3; SLIDER_BG_B = 0.3;
SLIDER_FILL_R = 0.8; SLIDER_FILL_G = 0.6; SLIDER_FILL_B = 0.2;
// Reverse slider colors (yellow fill for higher values)
SLIDER_FILL_REVERSE_R = 1.0; SLIDER_FILL_REVERSE_G = 1.0; SLIDER_FILL_REVERSE_B = 0.0;
SLIDER_BG_REVERSE_R = 0.8; SLIDER_BG_REVERSE_G = 0.8; SLIDER_BG_REVERSE_B = 0.2;
BUTTON_OFF_R = 0.4; BUTTON_OFF_G = 0.4; BUTTON_OFF_B = 0.4;
BUTTON_ON_R = 0.2; BUTTON_ON_G = 0.8; BUTTON_ON_B = 0.2;
TEXT_R = 1.0; TEXT_G = 1.0; TEXT_B = 1.0;
VALUE_COLOR_R = 0.3333; VALUE_COLOR_G = 0.3333; VALUE_COLOR_B = 0.3333;  // #555555

// Menu Button Configuration (75% of original)
MENU_BUTTON_SIZE = 15;  // 20 * 0.75
MENU_BUTTON_X = 8;      // 10 * 0.75 = 7.5 rounded up
MENU_BUTTON_Y = 4;      // 5 * 0.75 = 3.75 rounded up
MENU_BUTTON_LINE_WIDTH = 2;  // Keep at 2 for visibility
MENU_BUTTON_LINE_SPACING = 2; // 3 * 0.75 = 2.25 rounded down

// Menu Button Colors
MENU_BUTTON_BG_R = 0.4; MENU_BUTTON_BG_G = 0.4; MENU_BUTTON_BG_B = 0.4;  // Dark gray background
MENU_BUTTON_LINE_R = 0.9; MENU_BUTTON_LINE_G = 0.9; MENU_BUTTON_LINE_B = 0.9;  // Light gray lines
MENU_BUTTON_HOVER_R = 0.6; MENU_BUTTON_HOVER_G = 0.6; MENU_BUTTON_HOVER_B = 0.6;  // Lighter gray on hover
MENU_BUTTON_HOVER_LINE_R = 1.0; MENU_BUTTON_HOVER_LINE_G = 1.0; MENU_BUTTON_HOVER_LINE_B = 1.0;  // White lines on hover

// Custom Menu Configuration (75% of original)
MENU_WIDTH = 90;           // 120 * 0.75
MENU_ITEM_HEIGHT = 19;     // 25 * 0.75 = 18.75 rounded up
MENU_BG_R = 0.2; MENU_BG_G = 0.2; MENU_BG_B = 0.2;  // Dark background
MENU_BORDER_R = 0.6; MENU_BORDER_G = 0.6; MENU_BORDER_B = 0.6;  // Gray border
MENU_TEXT_R = 0.9; MENU_TEXT_G = 0.9; MENU_TEXT_B = 0.9;  // Light text
MENU_HOVER_R = 0.4; MENU_HOVER_G = 0.4; MENU_HOVER_B = 0.4;  // Hover background
MENU_CHECKMARK_R = 0.0; MENU_CHECKMARK_G = 1.0; MENU_CHECKMARK_B = 0.0;  // Green checkmark

// Group Configuration
NUM_GROUPS = 7;  // Total number of groups (Attack, Envelope, Release, Harmonics, Input, Settings)
GROUP_BORDER_RADIUS = 5;  // Rounded corner radius
GROUP_TITLE_HEIGHT = 22;  // Height of title area
GROUP_TITLE_PADDING = 8;  // Horizontal padding around title text
GROUP_PADDING = 10;  // Internal padding for controls

// Group Colors
GROUP_BG_R = 0.18; GROUP_BG_G = 0.18; GROUP_BG_B = 0.18;  // Slightly lighter than UI background
GROUP_BORDER_R = 0.4; GROUP_BORDER_G = 0.4; GROUP_BORDER_B = 0.4;  // Gray border
GROUP_TITLE_BG_R = 0.22; GROUP_TITLE_BG_G = 0.22; GROUP_TITLE_BG_B = 0.22;  // Slightly lighter for title area
GROUP_TITLE_TEXT_R = 0.85; GROUP_TITLE_TEXT_G = 0.85; GROUP_TITLE_TEXT_B = 0.85;  // Light gray text

//==============================================================================
// DEBUG PANEL LAYOUT CONSTANTS
//==============================================================================

// Debug panel column positions
DEBUG_PANEL_RIGHT_COLUMN_X = 573;  // Right stack: UI, Math, Program Release (moved 100px left)
DEBUG_PANEL_LEFT_COLUMN_X = 820;   // Left stack: Detection, Envelope, Effects (moved 100px left)

// Debug panel dimensions
DEBUG_PANEL_WIDTH = 200;
DEBUG_PANEL_LINE_HEIGHT = 16;
DEBUG_PANEL_TITLE_HEIGHT = 28;
DEBUG_PANEL_PADDING_X = 10;  // Horizontal padding for title
DEBUG_PANEL_PADDING_Y = 8;   // Vertical padding for title
DEBUG_PANEL_TEXT_OFFSET_X = 8;  // Text start offset from panel edge
DEBUG_PANEL_VALUE_OFFSET_X = 70;  // Value offset from right edge
DEBUG_PANEL_GAP_Y = 10;  // Vertical gap between panels

// Debug panel colors
DEBUG_PANEL_BG_R = 0.1; DEBUG_PANEL_BG_G = 0.1; DEBUG_PANEL_BG_B = 0.1; DEBUG_PANEL_BG_A = 0.85;
DEBUG_PANEL_BORDER_R = 0.6; DEBUG_PANEL_BORDER_G = 0.6; DEBUG_PANEL_BORDER_B = 0.6;
DEBUG_PANEL_TEXT_R = 0.9; DEBUG_PANEL_TEXT_G = 0.9; DEBUG_PANEL_TEXT_B = 0.9;

// Debug panel start position
DEBUG_PANEL_START_Y = 390;
