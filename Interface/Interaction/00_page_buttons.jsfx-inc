@init

PAGE_GRAPH = 0;      // Graph page
PAGE_FILTERS = 1;    // Input page (formerly Filters)
PAGE_SETTINGS = 2;   // Settings page
PAGE_BLANK = 3;      // Blank placeholder page

NUM_PAGES = 4;       // Total number of pages

PAGE_FADE_OUT_DURATION = 0.100;  // 100ms fade out
PAGE_DELAY_DURATION = 0.075;     // 75ms delay between fade out and fade in
PAGE_FADE_IN_DURATION = 0.100;   // 100ms fade in
PAGE_TOTAL_DURATION = PAGE_FADE_OUT_DURATION + PAGE_DELAY_DURATION + PAGE_FADE_IN_DURATION;  // 275ms total

button_state = 0;       // [page_idx, is_active, transition_active, start_time] per button
page_fade_amounts = 0;  // Fade amounts per page
page_blur_amounts = 0;  // Blur amounts per page (during fade-out)

function init_page_buttons() (
  i=0; while(i<16)(
    button_state[i*4+0] = -1;
    button_state[i*4+1] = 0;
    button_state[i*4+2] = 0;
    button_state[i*4+3] = 0;
    i+=1;
  );
  i=0; while(i<NUM_PAGES)(
    page_fade_amounts[i] = 0;
    page_blur_amounts[i] = 0;
    i+=1;
  );
  page_fade_amounts[PAGE_GRAPH] = 1;
  page_blur_amounts[PAGE_GRAPH] = 0;
);

function register_page_button(i, page_idx) (
  button_state[i*4+0] = page_idx;
  button_state[i*4+1] = 0;
  button_state[i*4+2] = 0;
  button_state[i*4+3] = 0;
);

function turn_off_page_button(i) local(page_idx) (
  page_idx = button_state[i*4+0];
  page_idx >= 0 && button_state[i*4+1] > 0.5 ? (
    button_state[i*4+1] = 0;
    button_state[i*4+2] = 1;
    button_state[i*4+3] = time_precise();
  );
);

function turn_off_other_radio_buttons(active_i, total_buttons) local(i) (
  i=0; while(i<total_buttons)(
    (i != active_i && button_state[i*4+1] > 0.5) ? turn_off_page_button(i);
    i+=1;
  );
);

function turn_on_page_button(i) local(page_idx) (
  page_idx = button_state[i*4+0];
  page_idx >= 0 && !(button_state[i*4+1] > 0.5 || button_state[i*4+2] > 0.5) ? (
    turn_off_other_radio_buttons(i, 16);
    button_state[i*4+1] = 1;
    button_state[i*4+2] = 1;
    button_state[i*4+3] = time_precise();
  );
);

function update_button_transition(i) local(page_idx,active,trans,start,t,elapsed,fade_in_elapsed,fade_in_progress,fade_out_progress) (
  page_idx = button_state[i*4+0];
  page_idx >= 0 ? (
    active = button_state[i*4+1];
    trans = button_state[i*4+2];
    start = button_state[i*4+3];
    trans > 0.5 ? (
      t = time_precise(); elapsed = t - start;
      elapsed >= PAGE_TOTAL_DURATION ? (
        button_state[i*4+2] = 0; button_state[i*4+3] = 0;
        active > 0.5 ? (page_fade_amounts[page_idx] = 1;) : (page_fade_amounts[page_idx] = 0;);
        page_blur_amounts[page_idx] = 0;
      ) : active > 0.5 ? (
        elapsed < (PAGE_FADE_OUT_DURATION + PAGE_DELAY_DURATION) ? (
          page_fade_amounts[page_idx] = 0; page_blur_amounts[page_idx] = 0;
        ) : (
          fade_in_elapsed = elapsed - (PAGE_FADE_OUT_DURATION + PAGE_DELAY_DURATION);
          fade_in_progress = fade_in_elapsed / PAGE_FADE_IN_DURATION;
          page_fade_amounts[page_idx] = fade_in_progress;
          page_blur_amounts[page_idx] = 0;
        );
      ) : (
        elapsed < PAGE_FADE_OUT_DURATION ? (
          fade_out_progress = elapsed / PAGE_FADE_OUT_DURATION;
          page_fade_amounts[page_idx] = 1 - fade_out_progress;
          page_blur_amounts[page_idx] = fade_out_progress;
        ) : (
          page_fade_amounts[page_idx] = 0; page_blur_amounts[page_idx] = 0;
        );
      );
    );
  );
);

function update_all_page_transitions() (
  i=0; while(i<16)(update_button_transition(i); i+=1;);
);

function get_page_fade_amount(page_index) (
  page_fade_amounts[page_index];
);

function should_render_page(page_index) (
  page_fade_amounts[page_index] > 0.01;
);

function is_button_active(button_index) (
  button_state[button_index*4 + 1] > 0.5;
);

function get_page_blur_amount(page_index) (
  page_blur_amounts[page_index];
);

function should_blur_page(page_index) (
  page_blur_amounts[page_index] > 0.01;
);

