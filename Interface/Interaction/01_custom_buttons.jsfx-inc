@init

NUM_PAGE_BUTTONS = 0;  // Input/Settings merged into one panel, no page switcher

page_button_x_base = 0;
page_button_y_base = 0;
page_button_w = 38;
page_button_h = 38;
page_button_spacing = 50;
page_button_label_offset_y = -35;

#page_button_label_0 = 60;
#page_button_label_1 = 61;
#page_button_label_2 = 62;
#page_button_label_3 = 63;

function init_custom_button_state() (
  init_page_buttons();
  // Merged Input/Settings panel always visible (no radio buttons)
  page_fade_amounts[PAGE_FILTERS] = 1;
  page_fade_amounts[PAGE_SETTINGS] = 1;
);

function update_page_button_positions() local(i) (
  start_x = GRAPH_X;
  button_y = GRAPH_Y + GRAPH_SIZE + 73;
  i=0; while(i<NUM_PAGE_BUTTONS)(
    page_button_x_base[i] = start_x + i * (page_button_w + page_button_spacing);
    page_button_y_base[i] = button_y;
    i+=1;
  );
);

function draw_page_button(button_index, x, y, w, h, is_pressed, label) local() (
  draw_momentary_button(x, y, w, h, is_pressed, 12, 13, label, page_button_label_offset_y);
);

function render_custom_buttons() (
  update_all_page_transitions();
  gfx_w > 0 ? (
    update_page_button_positions();
    i = 0; while (i < NUM_PAGE_BUTTONS) (
      is_pressed = (custom_button_pressed_index == i && MOUSE_LEFT_BUTTON) ? 1 : 0;
      label_slot = (i == 0) ? #page_button_label_0 : #page_button_label_1;
      draw_page_button(i, page_button_x_base[i], page_button_y_base[i], page_button_w, page_button_h, is_pressed, label_slot);
      i += 1;
    );
  );
);

function is_point_in_page_button(x, y, button_index) (
  page_button_x_base[button_index] >= 0 && page_button_y_base[button_index] >= 0 ? (
    x >= page_button_x_base[button_index] && x <= page_button_x_base[button_index] + page_button_w &&
    y >= page_button_y_base[button_index] && y <= page_button_y_base[button_index] + page_button_h;
  ) : (
    0;
  );
);

function handle_page_button_click(button_index) (
  turn_on_page_button(button_index);
);

custom_button_mouse_down = 0;
custom_button_pressed_index = -1;

function process_custom_button_input() local(clicked, i) (
  clicked = 0;
  gfx_w > 0 ? (
    update_page_button_positions();
    MOUSE_LEFT_BUTTON ? (
      !custom_button_mouse_down ? (
        custom_button_mouse_down = 1;
        custom_button_pressed_index = -1;
        i=0; while(i<NUM_PAGE_BUTTONS && !clicked)(
          is_point_in_page_button(mouse_x, mouse_y, i) ? (
            custom_button_pressed_index = i; handle_page_button_click(i); clicked = 1;
          );
          i+=1;
        );
      ) : (
        custom_button_pressed_index >= 0 ? (
          is_point_in_page_button(mouse_x, mouse_y, custom_button_pressed_index) ? 0 : (custom_button_pressed_index = -1;);
        );
      );
    ) : (
      custom_button_mouse_down = 0;
      custom_button_pressed_index = -1;
    );
  );
  clicked;
);
