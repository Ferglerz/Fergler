// Input Page Module
// Input page with Preview Filters custom button
// Dependencies: UI_General/00_ui_constants.jsfx-inc, UI_General/01_drawing_primitives.jsfx-inc, UI_General/12_page_buttons.jsfx-inc

@init

//==============================================================================
// PREVIEW FILTERS BUTTON DEFINITIONS
//==============================================================================

// Preview Filters button (custom button, not a slider)
// Button dimensions - match three-button row width
// FILTER_THREE_BUTTON_W = 75 (from control_layout.jsfx-inc)
INPUT_PAGE_BUTTON_W = 75;  // Same as FILTER_THREE_BUTTON_W
INPUT_PAGE_BUTTON_H = 27;
FILTER_THREE_BUTTON_GAP = 10;  // Same gap as three-button row

// Button position (will be calculated in @gfx based on Listen button position)
preview_filters_button_x = 0;
preview_filters_button_y = 0;

// Button label string (use string slot 70)
#preview_filters_button_label = 70;  // "Auto-preview"

//==============================================================================
// STATE INITIALIZATION
//==============================================================================

function init_input_page() (
  // Initialize button label
  strcpy(#preview_filters_button_label, "Auto-preview");
  // Initialize auto preview to enabled by default
  menu_preview_filters_enabled = 1;
);

//==============================================================================
// BUTTON POSITIONING
//==============================================================================

// Calculate Auto-preview button position (between Listen and Use Sidechain buttons)
function update_preview_filters_button_position() (
  // Manual position update for Auto-preview button
  // Should follow Listen (control 18) and precede Use Sidechain (control 19)
  // Indices: Listen = 18, Sidechain = 19
  listen_x = get_control_x_with_group_offset(18);
  listen_y = get_control_y_with_group_offset(18);
  listen_w = control_defs[18*11 + 3]; // Direct access to avoid undefined function error
  gap = 5;
  
  preview_filters_button_x = listen_x + listen_w + gap;
  preview_filters_button_y = listen_y;
  preview_filters_button_w = listen_w; // Same width as others (3-column layout)
  preview_filters_button_h = 27;
);


//==============================================================================
// BUTTON RENDERING
//==============================================================================

// Draw Preview Filters button
// Parameters:
//   is_enabled: 1 = enabled/on, 0 = disabled/off
function draw_preview_filters_button(is_enabled) local() (
  draw_button_background(preview_filters_button_x, preview_filters_button_y, preview_filters_button_w, preview_filters_button_h, is_enabled);
  draw_button_border(preview_filters_button_x, preview_filters_button_y, preview_filters_button_w, preview_filters_button_h);
  draw_button_text(preview_filters_button_x, preview_filters_button_y, #preview_filters_button_label);
  
  // Draw checkmark if enabled
  is_enabled ? (
    gfx_set(button_style_on_r, button_style_on_g, button_style_on_b, 1);
    gfx_x = preview_filters_button_x + preview_filters_button_w - 15;
    gfx_y = preview_filters_button_y + 8;
    gfx_drawstr("v");  // Checkmark
  );
);

// Render Preview Filters button only
function render_filters_page_buttons() (
  // Only render if Input page should be visible
  should_render_page(PAGE_FILTERS) ? (
    // Get page opacity for fade transitions
    page_opacity = page_fade_amounts[PAGE_FILTERS];
    page_opacity > 0.01 ? (
      // Update position
      gfx_w > 0 ? (
        update_preview_filters_button_position();
        
        // Apply opacity
        gfx_a = page_opacity;
        
        // Draw Preview Filters button
        preview_enabled = menu_preview_filters_enabled > 0.5;
        draw_preview_filters_button(preview_enabled);
        
        // Reset opacity
        gfx_a = 1.0;
      );
    );
  );
);

//==============================================================================
// BUTTON INTERACTION
//==============================================================================

// Check if point is inside Preview Filters button
function is_point_in_preview_filters_button(x, y) (
  preview_filters_button_x >= 0 && preview_filters_button_y >= 0 ? (
    x >= preview_filters_button_x && x <= preview_filters_button_x + preview_filters_button_w &&
    y >= preview_filters_button_y && y <= preview_filters_button_y + preview_filters_button_h;
  ) : (
    0;
  );
);

// Handle click on Preview Filters button
function handle_preview_filters_button_click() (
  // Toggle preview filters
  menu_preview_filters_enabled = menu_preview_filters_enabled > 0.5 ? 0 : 1;
);

// Process mouse input for Preview Filters button
// Returns: 1 if Preview Filters button was clicked, 0 otherwise
function process_filters_page_button_input() local(clicked) (
  clicked = 0;
  // Only process if Input page should be visible
  should_render_page(PAGE_FILTERS) ? (
    gfx_w > 0 ? (
      update_preview_filters_button_position();
      
      MOUSE_LEFT_BUTTON && !filters_page_mouse_down ? (
        filters_page_mouse_down = 1;
        
        // Check Preview Filters button
        is_point_in_preview_filters_button(mouse_x, mouse_y) ? (
          handle_preview_filters_button_click();
          clicked = 1;
        );
      ) : !MOUSE_LEFT_BUTTON ? (
        filters_page_mouse_down = 0;
      );
    );
  );
  clicked;
);

// Filters page button mouse state
filters_page_mouse_down = 0;
