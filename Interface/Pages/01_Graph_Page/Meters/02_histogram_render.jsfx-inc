// UI Graph Histogram Render Module
// Depends on UI constants, graph pixel conversion, histogram state, clamp, graph data

@init

// ===================
// Reflections & Helpers
// ===================

// Reflection alpha with smooth falloff
function calc_reflection_alpha(y, ref_y, max_dist, opacity) (
  d = abs(y - ref_y);
  f = max(0, min(1, 1 - (d / max_dist)));
  opacity * (f * f);
);

// Draws small vertical gradient (reflection shimmer) at pixel
function draw_reflection_gradient(x, y, r, g, b, alpha) (
  r = min(1.0, r / max(alpha, 0.001));
  g = min(1.0, g / max(alpha, 0.001));
  b = min(1.0, b / max(alpha, 0.001));
  alpha = min(1, alpha);
  gfx_set(r, g, b, 0.5 * alpha); gfx_rect(x, y,     1, 1);
  gfx_set(r, g, b, 0.75 * alpha); gfx_rect(x, y+1,  1, 1);
  gfx_set(r, g, b, alpha);        gfx_rect(x, y+2,  1, 1);
  gfx_set(r, g, b, alpha);        gfx_rect(x, y+3,  1, 1);
  gfx_set(r, g, b, alpha);        gfx_rect(x, y+4,  1, 1);
  gfx_set(r, g, b, 0.75 * alpha); gfx_rect(x, y+5,  1, 1);
  gfx_set(r, g, b, 0.5 * alpha);  gfx_rect(x, y+6,  1, 1);
);

// Unified histogram reflection: merges all colors and curve points
function draw_histogram_reflection_unified_pixel(opacity) (
  // Reflection reference
  ref_y = GRAPH_Y + GRAPH_SIZE * 0.75;
  max_dist = GRAPH_SIZE * 0.75;
  refl_y = GRAPH_Y + GRAPH_SIZE + 20;
  w = GRAPH_SIZE;
  hist_size = histogram_pixel_max_samples;

  base_op = opacity * 0.234375;
  hist_op = base_op * 0.65;

  i = 0;
  loop(w,
    acc_r = acc_g = acc_b = acc_a = 0;

    // Negative GR (orange)
    histogram_pixel_initialized ? (
      age = floor((w-1-i) * (hist_size-1) / max(w-1,1));
      bi = (histogram_pixel_idx - age + hist_size) % hist_size;
      gr = histogram_pixel_buffer[bi];
      gr < 0 ? (
        y0 = min(GRAPH_Y + abs(gr) * GR_PIXELS_PER_DB, GRAPH_Y + GRAPH_SIZE);
        a0 = calc_reflection_alpha(y0, ref_y, max_dist, hist_op);
        a0 > 0.001 ? (
          acc_r += (0.7+0.3)*a0;
          acc_g += (0.5*0.7+1*0.3)*a0;
          acc_b += (1*0.3)*a0;
          acc_a += a0;
        );
      );
    );

    // Positive GR (blue)
    histogram_pixel_initialized ? (
      gr > 0 ? (
        y1 = max(GRAPH_Y+GRAPH_SIZE-abs(gr)*GR_PIXELS_PER_DB, GRAPH_Y);
        a1 = calc_reflection_alpha(y1, ref_y, max_dist, hist_op);
        a1 > 0.001 ? (
          acc_r += (0.2*0.7+1*0.3)*a1;
          acc_g += (0.5*0.7+1*0.3)*a1;
          acc_b += (0.7+0.3)*a1;
          acc_a += a1;
        );
      );
    );

    // Green input histogram
    input_histogram_initialized ? (
      n = input_histogram_max_samples;
      age2 = floor((w-1-i)*(n-1)/max(w-1,1));
      iy = (input_histogram_pos-1-age2+n)%n;
      lvl = input_histogram_buffer[iy];
      lvl > GRAPH_MIN_DB ? (
        y2 = max(HISTOGRAM_Y_OFFSET-lvl*DB_TO_PIXEL_SCALE, GRAPH_Y);
        a2 = calc_reflection_alpha(y2, ref_y, max_dist, hist_op);
        a2 > 0.001 ? (
          acc_r+=a2; acc_g+=a2; acc_b+=a2; acc_a+=a2;
        );
      );
    );

    // White curve points
    point_i = 1;
    while (point_i < num_points-1) (
      idx = point_i*2;
      px = db_to_graph_x(graph_points[idx]);
      py = db_to_graph_y(graph_points[idx+1]);
      abs(px-(GRAPH_X+i))<=2 ? (
        pa = calc_reflection_alpha(py, ref_y, max_dist, base_op);
        pa > 0.001 ? (
          acc_r+=pa; acc_g+=pa; acc_b+=pa; acc_a+=pa;
        );
      );
      point_i += 1;
    );

    // Input dot (pastel green)
    (play_state==1||play_state==5) ? (
      ddb = clamp(input_histogram_db, GRAPH_MIN_DB, GRAPH_MAX_DB);
      dx = db_to_graph_x(ddb);
      dy = db_to_graph_y(ddb);
      abs(dx-(GRAPH_X+i))<=2 ? (
        da = calc_reflection_alpha(dy, ref_y, max_dist, base_op);
        da > 0.001 ? (
          acc_r += (0.5*0.7+1*0.3)*da;
          acc_g += (0.9*0.7+1*0.3)*da;
          acc_b += (0.5*0.7+1*0.3)*da;
          acc_a += da;
        );
      );
    );

    // Draw if visible
    acc_a > 0.001 ? (
      draw_reflection_gradient(GRAPH_X + i, refl_y, acc_r, acc_g, acc_b, acc_a);
    );

    i += 1;
  );
);

// =============================
// Histogram Drawing Helpers
// =============================

function draw_input_histogram_line(buffer, pos, max_samples, r, g, b, a) (
  w = GRAPH_SIZE; step = max(1, floor(w/200));
  i = 0;
  loop(w,
    age = floor((w-1-i)*(max_samples-1)/(w-1));
    si = (pos-1-age+max_samples)%max_samples;
    lvl = buffer[si];
    lvl > GRAPH_MIN_DB ? (
      f = i < 100 ? (i/100) : 1;
      fa = a*f;
      gfx_set(r, g, b, fa);
      x = GRAPH_X + i;
      y = max(HISTOGRAM_Y_OFFSET - lvl*DB_TO_PIXEL_SCALE, GRAPH_Y);
      gfx_line(x, GRAPH_Y+GRAPH_SIZE, x, y, 1);
    );
    i += step;
  );
);

function draw_gr_histogram_line_pixel(buffer, r_neg, g_neg, b_neg, a_neg, r_pos, g_pos, b_pos, a_pos) (
  w = GRAPH_SIZE; n = histogram_pixel_max_samples; i = 0;
  loop(w,
    age = floor((w-1-i)*(n-1)/max(w-1,1));
    bi = (histogram_pixel_idx-age+n)%n;
    v = buffer[bi];
    f = i<100 ? (i/100) : 1;
    v < 0 ? (
      fa = a_neg * f;
      gfx_set(r_neg, g_neg, b_neg, fa);
      x = GRAPH_X+i;
      y = min(GRAPH_Y+abs(v)*GR_PIXELS_PER_DB, GRAPH_Y+GRAPH_SIZE);
      gfx_line(x, GRAPH_Y, x, y, 1);
    )
    : v > 0 ? (
      fa = a_pos * f;
      gfx_set(r_pos, g_pos, b_pos, fa);
      x = GRAPH_X+i;
      y = max(GRAPH_Y+GRAPH_SIZE-abs(v)*GR_PIXELS_PER_DB, GRAPH_Y);
      gfx_line(x, GRAPH_Y+GRAPH_SIZE, x, y, 1);
    );
    i += 1;
  );
);

// ==================
// Input Histogram
// ==================
function draw_input_histogram(opacity) (
  INPUT_HISTOGRAM_ENABLED && input_histogram_initialized && opacity>0 ?
    draw_input_histogram_line(input_histogram_buffer, input_histogram_pos, input_histogram_max_samples, INPUT_HISTOGRAM_COLOR_R, INPUT_HISTOGRAM_COLOR_G, INPUT_HISTOGRAM_COLOR_B, opacity);
);

// ===============
// Histogram
// ===============
function draw_histogram(opacity) (
  HISTOGRAM_ENABLED && histogram_pixel_initialized && opacity>0 ? (
    draw_gr_histogram_line_pixel(histogram_pixel_buffer, 1,0.5,0,opacity,   0.2,0.5,1,opacity);
    draw_histogram_reflection_unified_pixel(opacity);
  );
);
