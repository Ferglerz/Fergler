// UI Graph Meter Render Module
// Gain reduction meter rendering functions
// Depends on: 
//   - UI_General/00_ui_constants.jsfx-inc
//   - UI_General/07_coordinate_conversion.jsfx-inc
//   - UI_General/06_threshold_lines.jsfx-inc

@init

//==============================================================================
// METER REFLECTION
//==============================================================================

function draw_meter_reflection(meter_x, meter_y, meter_w, meter_h) local(
  reflection_y, meter_weight, meter_alpha, acc_r, acc_g, acc_b,
  blue_weight, orange_weight, blue_opacity, orange_opacity, total_opacity,
  middle_alpha, edge_alpha, mid_edge_alpha
) (
  reflection_y = GRAPH_Y + GRAPH_SIZE + 61; // Reflection 45px below meter base

  // Normalize gain reduction for color/alpha determination
  meter_weight = min(1, abs(current_gr_db) / 20);
  meter_alpha = 0.28125 * meter_weight; // 50% of 0.5625

  // Only render if visible
  meter_alpha > 0.001 ? (
    current_gr_db < 0 ? (
      // Compression (orange blending to blue)
      blue_weight    = 1 - meter_weight * 0.7;
      orange_weight  = 1 - blue_weight;
      blue_opacity   = meter_alpha * blue_weight * 1.5;
      orange_opacity = meter_alpha * orange_weight;
      total_opacity  = blue_opacity + orange_opacity;

      acc_r      = (1*orange_opacity + 0.2*blue_opacity) / max(total_opacity,0.001);
      acc_g      = (0.5*orange_opacity + 0.5*blue_opacity) / max(total_opacity,0.001);
      acc_b      = (0*orange_opacity + 1*blue_opacity) / max(total_opacity,0.001);
      meter_alpha = total_opacity; // Use combined opacity
    ) : current_gr_db > 0 ? (
      // Gain addition (blue)
      acc_r = 0.2; acc_g = 0.5; acc_b = 1.0;
    ) : (
      // Zero GR (invisible)
      acc_r = 0.2; acc_g = 0.5; acc_b = 1.0; meter_alpha=0;
    );

    // White tint (70% color, 30% white)
    acc_r = acc_r * 0.7 + 0.3; acc_g = acc_g * 0.7 + 0.3; acc_b = acc_b * 0.7 + 0.3;

    // Simple 5-pixel vertical gradient: 50%, 75%, 100%, 75%, 50% opacity
    middle_alpha = meter_alpha;
    edge_alpha = meter_alpha * 0.5;
    mid_edge_alpha = meter_alpha * 0.75;
    gfx_set(acc_r, acc_g, acc_b, edge_alpha);     gfx_rect(meter_x, reflection_y + 0, meter_w, 1);
    gfx_set(acc_r, acc_g, acc_b, mid_edge_alpha); gfx_rect(meter_x, reflection_y + 1, meter_w, 1);
    gfx_set(acc_r, acc_g, acc_b, middle_alpha);   gfx_rect(meter_x, reflection_y + 2, meter_w, 1);
    gfx_set(acc_r, acc_g, acc_b, mid_edge_alpha); gfx_rect(meter_x, reflection_y + 3, meter_w, 1);
    gfx_set(acc_r, acc_g, acc_b, edge_alpha);     gfx_rect(meter_x, reflection_y + 4, meter_w, 1);
  );
);

//==============================================================================
// METERING BUTTON
//==============================================================================

// Draws a small 10x10px Metering button below the meter (5px gap)
function draw_metering_button(meter_x, meter_y, meter_w, meter_h) local(bx, by, is_enabled) (
  bx = meter_x + (meter_w - 10) * 0.5;
  by = meter_y + meter_h + 5;
  is_enabled = slider(38) > 0.5;
  // Background: white if enabled, dark gray if not
  gfx_set(is_enabled ? 1 : 0.3, is_enabled ? 1 : 0.3, is_enabled ? 1 : 0.3, 0.75);
  gfx_rect(bx, by, 10,10);
  // Border
  gfx_set(0.6,0.6,0.6,0.75);
  gfx_line(bx,by, bx+10,by, 1);
  gfx_line(bx+10,by, bx+10,by+10, 1);
  gfx_line(bx+10,by+10, bx,by+10, 1);
  gfx_line(bx,by+10, bx,by, 1);
);

// Returns true if (x,y) is inside the Metering button
function is_point_in_metering_button(x, y) local(mx, my, mw, mh, bx, by) (
  mx = get_meter_x(); my = get_meter_y(); mw = get_meter_w(); mh = get_meter_h();
  bx = mx + (mw-10) * 0.5; by = my+mh+5;
  x >= bx && x <= bx+10 && y >= by && y <= by+10;
);

// Toggle metering on Metering button click
function handle_metering_button_click() (
  slider(38) = slider(38) > 0.5 ? 0 : 1;
  sliderchange(1<<(38-1));
);

//==============================================================================
// GAIN REDUCTION METER
//==============================================================================

function draw_gain_reduction_meter() local(x, y, w, h, gr_height, is_audio_active) (
  x = get_meter_x(); y = get_meter_y(); w = get_meter_w(); h = get_meter_h();

  // Meter background
  gfx_set(0.2, 0.2, 0.2, 0.5);
  gfx_rect(x, y, w, h);

  // Only draw meter fill if metering enabled and audio is active
  if (slider(38) > 0.5 && ((play_state == 1) || (play_state == 5))) (
    gr_height = abs(current_gr_db) * GR_PIXELS_PER_DB;
    gr_height = min(gr_height, h);
    current_gr_db < 0 ? (
      gfx_set(1, 0.5, 0, 1);
      gfx_rect(x, y, w, gr_height);
    ) : current_gr_db > 0 ? (
      gfx_set(0.2, 0.5, 1, 1);
      gfx_rect(x, y + h - gr_height, w, gr_height);
    );
  );

  // Meter threshold lines when on graph page
  should_render_page(PAGE_GRAPH) ? (
    render_gr_blend_threshold_line(x, y, w, h);
    render_rate_change_threshold_line(x, y, w, h);
  );

  // Draw reflection and metering button
  draw_meter_reflection(x, y, w, h);
  draw_metering_button(x, y, w, h);
);
