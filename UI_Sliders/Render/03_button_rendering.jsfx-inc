// Button Rendering Module
// Handles rendering of button controls
// Dependencies: 01_Utils/00_constants.jsfx-inc

@init

//==============================================================================
// BUTTON RENDERING
//==============================================================================
//
// This module provides button rendering for toggle/switch controls.
// It handles:
// - On/Off state visualization (different colors)
// - Border rendering
// - Label text rendering inside button
//
// USAGE:
//   draw_generic_button(x, y, w, h, is_on, "Label");
//
// BUTTON STATES:
//   is_on = 0 - Off state (darker color)
//   is_on = 1 - On state (brighter color)
//

//==============================================================================
// BUTTON STYLE CONFIGURATION (Module-level variables)
//==============================================================================

// Style configuration variables - set these before rendering
// Button colors: yellow from sliders (0.8, 0.6, 0.2) at 66% opacity when active, 25% when inactive
button_style_on_r = 0.528; button_style_on_g = 0.396; button_style_on_b = 0.132;  // 66% opacity of yellow
button_style_off_r = 0.2; button_style_off_g = 0.15; button_style_off_b = 0.05;  // 25% opacity of yellow
button_style_text_r = 1.0; button_style_text_g = 1.0; button_style_text_b = 1.0;
button_style_border_r = 0.6; button_style_border_g = 0.6; button_style_border_b = 0.6;

//==============================================================================
// BUTTON RENDERING HELPER FUNCTIONS
//==============================================================================

// Draw button background with appropriate color based on state
// Parameters:
//   x, y: Position
//   w, h: Dimensions
//   is_on: Button state (0=off, 1=on)
function draw_button_background(x, y, w, h, is_on) local() (
  is_on ? (
    gfx_set(button_style_on_r, button_style_on_g, button_style_on_b, 1);
  ) : (
    gfx_set(button_style_off_r, button_style_off_g, button_style_off_b, 1);
  );
  gfx_rect(x, y, w, h);
);

// Draw button border
// Parameters:
//   x, y: Position
//   w, h: Dimensions
function draw_button_border(x, y, w, h) local() (
  gfx_set(button_style_border_r, button_style_border_g, button_style_border_b, 1);
  gfx_rect(x, y, w, h, 0);
);

// Draw button text with standard padding
// Parameters:
//   x, y: Position
//   label: Button label text (string slot or string literal)
function draw_button_text(x, y, label) local() (
  gfx_set(button_style_text_r, button_style_text_g, button_style_text_b, 1);
  gfx_x = x + 8; gfx_y = y + 8;
  gfx_drawstr(label);
);

//==============================================================================
// BUTTON RENDERING FUNCTION
//==============================================================================

// Draw button control - uses style configuration variables
function draw_generic_button(x, y, w, h, is_on, label) local() (
  draw_button_background(x, y, w, h, is_on);
  draw_button_border(x, y, w, h);
  draw_button_text(x, y, label);
);

//==============================================================================
// IMAGE-BASED TOGGLE RENDERING
//==============================================================================

// Draw image-based toggle button
// Parameters:
//   x, y: Position (button top-left corner)
//   w, h: Dimensions (button size)
//   is_on: Toggle state (0=off/left, 1=on/right)
//   image_left_index: Image index for left/off state
//   image_right_index: Image index for right/on state
//   image_scale: Ignored (images are already correct size)
//   label: Label string slot (0 or empty string = no label)
// Note: Images are 84x56 pixels, no scaling needed
function draw_image_toggle_button(x, y, w, h, is_on, image_left_index, image_right_index, image_scale, label) local(img_index, img_w, img_h, label_height, label_w, label_h, label_x) (
  // Draw label above button only if label is provided (non-zero string slot)
  label > 0 ? (
    label_height = 11;  // Same as dropdown label height
    gfx_set(button_style_text_r, button_style_text_g, button_style_text_b, 1);
    // Measure label to center it
    gfx_measurestr(label, label_w, label_h);
    label_x = x + (w - label_w) / 2;  // Center label horizontally
    gfx_x = label_x;
    gfx_y = y - label_height;
    gfx_drawstr(label);
  );
  
  // Select image based on state
  img_index = is_on ? image_right_index : image_left_index;
  
  // Image dimensions (84x56 for toggle buttons, 109x81 for feedforward/feedback)
  // Use button dimensions to determine image size (button w/h should match image size)
  img_w = w;  // Use button width (image should match button size)
  img_h = h;  // Use button height (image should match button size)
  
  // Position image at button's top-left corner (x, y)
  // This ensures the image starts at the button's X position, not centered
  // x, y are the button's coordinates (already include group offset from dispatcher)
  // gfx_blit uses gfx_x and gfx_y as the position for the image's top-left corner
  gfx_x = x;
  gfx_y = y;
  gfx_blit(img_index, 1, 0);  // Scale 1.0 = no scaling
);

//==============================================================================
// MOMENTARY BUTTON RENDERING
//==============================================================================

// Draw momentary button (shows depressed image only when clicked)
// Parameters:
//   x, y: Position (button top-left corner)
//   w, h: Dimensions (button size)
//   is_pressed: 1 = button is currently pressed, 0 = not pressed
//   image_normal_index: Image index for normal state
//   image_depressed_index: Image index for depressed/pressed state
//   label: Label string slot (0 or empty string = no label)
//   label_offset_y: Y offset for label (negative = above button)
// Note: Images are 76x76 pixels
function draw_momentary_button(x, y, w, h, is_pressed, image_normal_index, image_depressed_index, label, label_offset_y) local(img_index, img_w, img_h, label_w, label_h, label_x, image_scale, scaled_w, scaled_h) (
  // Draw label above button only if label is provided (non-zero string slot)
  label > 0 ? (
    gfx_set(button_style_text_r, button_style_text_g, button_style_text_b, 1);
    // Measure label to center it
    gfx_measurestr(label, label_w, label_h);
    label_x = x + (w - label_w) / 2;  // Center label horizontally
    gfx_x = label_x;
    gfx_y = y + label_offset_y;  // Position label with offset (negative = above)
    gfx_drawstr(label);
  );
  
  // Select image based on pressed state
  img_index = is_pressed ? image_depressed_index : image_normal_index;
  
  // Image dimensions (76x76) - scale to 0.5 for 38x38 button
  img_w = 76;
  img_h = 76;
  image_scale = 0.5;  // Half size to match 38x38 button
  
  // Center the scaled image within the button
  scaled_w = img_w * image_scale;
  scaled_h = img_h * image_scale;
  gfx_x = x + (w - scaled_w) / 2;
  gfx_y = y + (h - scaled_h) / 2;
  gfx_blit(img_index, image_scale, 0);  // Scale 0.5 = half size
);

