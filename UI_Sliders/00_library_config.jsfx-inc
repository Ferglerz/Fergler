// UI_Sliders Library Configuration Interface
// This file documents the interface contract between the library and host plugin
// The host plugin must provide a configuration file that defines these constants and arrays
// before importing this library
//
// IMPORTANT: This file should be imported by the host plugin's config file, not directly
// The host plugin's config file (e.g., UI_Sliders_Config.jsfx-inc) should:
// 1. Define all required constants and arrays
// 2. Import this file to verify the interface
// 3. Be imported before any UI_Sliders library modules

@init

//==============================================================================
// REQUIRED CONSTANTS (Host plugin must define these)
//==============================================================================

// NUM_CONTROLS: Maximum number of controls (typically 256, matching JSFX slider limit)
// Must be defined by host plugin before library modules are imported
// Example: NUM_CONTROLS = 256;

// NUM_GROUPS: Maximum number of control groups
// Must be defined by host plugin before library modules are imported
// Example: NUM_GROUPS = 7;

//==============================================================================
// REQUIRED MEMORY ARRAYS (Host plugin must allocate and set these)
//==============================================================================

// control_defs: Control definitions array (11 values per control)
// Host plugin must allocate: control_defs = freemem; freemem += NUM_CONTROLS * 11;
// Must be set before library modules use it

// group_defs: Group definitions array (6 values per group)
// Host plugin must allocate: group_defs = freemem; freemem += NUM_GROUPS * 6;
// Must be set before library modules use it

// slider_properties_base: Slider properties array (4 values per control)
// Host plugin must allocate: slider_properties_base = freemem; freemem += NUM_CONTROLS * 4;
// Must be set before library modules use it

// Step-point arrays (for step-point functionality):
// step_points_arrays_base: Base of all step-point arrays
// Host plugin must allocate: step_points_arrays_base = freemem; freemem += NUM_CONTROLS * MAX_STEP_POINTS_PER_PARAM;
// step_points_bases: Array of base addresses (one per parameter)
// Host plugin must allocate: step_points_bases = freemem; freemem += NUM_CONTROLS;
// step_points_counts: Array of step-point counts (one per parameter)
// Host plugin must allocate: step_points_counts = freemem; freemem += NUM_CONTROLS;
// Must be set before step-point functions are used

// Knob/Parallax arrays (for knob and parallax fader functionality):
// knob_image_indices, knob_image_widths, knob_image_heights, knob_image_offsets_x, 
// knob_image_offsets_y, knob_image_scales, knob_slider_configs, knob_line_offsets
// parallax_depths, parallax_y_offsets, parallax_x_offsets, parallax_scales, parallax_slider_configs
// Host plugin must allocate these arrays (NUM_CONTROLS elements each)

//==============================================================================
// OPTIONAL FUNCTIONS (Host plugin can provide these for custom behavior)
//==============================================================================

// draw_group(group_index, fade_amount)
// If provided by host plugin, library will use it for group rendering
// If not provided, library uses simple rendering
// Parameters: group_index (0-based), fade_amount (0-1)
// Example implementation:
//   function draw_group(idx, fade) local(gx, gy, gw, gh, show_title, title_ptr, tw, th, tx, ty) (
//     gx = group_defs[idx*6]; gy = group_defs[idx*6 + 1];
//     gw = group_defs[idx*6 + 2]; gh = group_defs[idx*6 + 3];
//     show_title = group_defs[idx*6 + 4]; title_ptr = group_defs[idx*6 + 5];
//     fade <= 0 ? fade = 1;
//     // ... rendering code ...
//   );

// is_control_interactive(control_index)
// If provided by host plugin, library will use it to determine if control should be interactive
// If not provided, all controls are always interactive (default behavior)
// Parameters: control_index (0-based)
// Returns: 1 if control should be interactive, 0 otherwise
// Example implementation:
//   function is_control_interactive(i) (
//     // Check if control is on a page that should be visible
//     is_control_on_filters_page(i) ? should_render_page(PAGE_FILTERS) :
//     is_control_on_settings_page(i) ? should_render_page(PAGE_SETTINGS) :
//     1;
//   );

// update_pdc_if_needed(param_index)
// If provided by host plugin, library will call it when certain parameters change
// If not provided, no PDC updates are performed (default behavior)
// Parameters: param_index (1-based JSFX slider number)
// Example implementation:
//   function update_pdc_if_needed(param) (
//     param == 13 ? (
//       pdc_delay = min(lookahead_ms * 0.001 * srate, max_lookahead_samples) | 0;
//       pdc_delay > 0 ? (pdc_bot_ch = 0; pdc_top_ch = 2; );
//     );
//   );

//==============================================================================
// OPTIONAL CONSTANTS (Host plugin can provide these, library has defaults)
//==============================================================================

// VALUE_COLOR_R, VALUE_COLOR_G, VALUE_COLOR_B: Color for value text display
// Default values (host plugin can override):
VALUE_COLOR_R = 1.0;
VALUE_COLOR_G = 1.0;
VALUE_COLOR_B = 1.0;

//==============================================================================
// LIBRARY INITIALIZATION
//==============================================================================

// The library expects the host plugin to:
// 1. Allocate all required memory arrays
// 2. Set all required constants
// 3. Optionally provide custom functions
// 4. Import this config file
// 5. Then import library modules in the correct order

// Library module import order:
// 1. Core/00_file_reading.jsfx-inc
// 2. Core/01_slider_constants.jsfx-inc
// 3. Core/02_control_definitions.jsfx-inc
// 4. Core/03_value_formatting.jsfx-inc
// 5. Core/04_value_text_rendering.jsfx-inc
// 6. Core/05_step_points.jsfx-inc
// 7. Core/06_control_utils.jsfx-inc
// 8. Core/07_radio_buttons.jsfx-inc
// 9. Render modules
// 10. Runtime modules
// 11. Interaction modules
