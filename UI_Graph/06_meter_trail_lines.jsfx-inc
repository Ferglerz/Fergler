// UI Meter Trail Lines Module - Fading line trail visualization for gain reduction meter
// Shows hotspots of gain reduction over the last 2.5 seconds
// Depends on: 
//   - 01_Utils/00_constants.jsfx-inc
//   - 01_Utils/02_math_utils.jsfx-inc
//   - UI_General/07_coordinate_conversion.jsfx-inc (for get_meter_x, get_meter_y, get_meter_w, get_meter_h, GR_PIXELS_PER_DB)
//   - 03_Compression/02_graph_data_core.jsfx-inc
//   - UI_Graph/04_trail_utils.jsfx-inc (for shared trail utilities)

@init

//==============================================================================
// TRAIL LINES STATE INITIALIZATION
//==============================================================================

function init_meter_trail_lines_state() (
  // Meter trail lines state
  // meter_trail_buffer is allocated in allocate_memory() - DO NOT reset it here!
  // meter_trail_max_lines is set in allocate_memory() and should not be reset here
  meter_trail_count = 0; // Current number of active trail lines (also used as write position)
  meter_trail_initialized = 0; // Flag to track initialization
  meter_trail_fade_duration_samples = 2.5 * srate; // 2.5 seconds in samples
  
  // Initialize trail buffer if enabled
  meter_trail_max_lines > 0 ? (
    // Clear trail buffer using shared utility
    clear_trail_buffer(meter_trail_buffer, meter_trail_max_lines, 3);
    meter_trail_count = 0;
    meter_trail_initialized = 1;
  ) : (
    meter_trail_initialized = 0;
  );
);

// Update fade duration when sample rate changes
function update_meter_trail_fade_duration() (
  meter_trail_fade_duration_samples = 2.5 * srate; // 2.5 seconds in samples
);

//==============================================================================
// TRAIL LINE CREATION AND MANAGEMENT
//==============================================================================

// Create a new trail line from current gain reduction value
// Called once per buffer from @block
// Only creates a line if there's actual GR (non-zero) to avoid wasting buffer space
// Uses shifting array approach: new items appended at end, expired items removed by shifting
function create_meter_trail_line(gr_value_db) (
  meter_trail_initialized && abs(gr_value_db) > 0.01 ? (
    // If buffer is full, remove oldest item by shifting all items left
    meter_trail_count >= meter_trail_max_lines ? (
      // Shift all items left by one position (remove oldest)
      i = 0;
      while (i < (meter_trail_max_lines - 1) * 3) (
        meter_trail_buffer[i] = meter_trail_buffer[i + 3];
        i += 1;
      );
      meter_trail_count = meter_trail_max_lines - 1;
    );
    
    // Write new item at the end (position = count)
    idx = meter_trail_count * 3;
    meter_trail_buffer[idx] = gr_value_db; // Store GR value (determines position and color)
    meter_trail_buffer[idx + 1] = 0; // Age in samples
    meter_trail_buffer[idx + 2] = meter_trail_fade_duration_samples; // Max age in samples (2.5 seconds)
    meter_trail_count += 1;
  );
);

// Update all trail lines (age them and remove expired ones)
// Called from @gfx section
function update_meter_trail_lines() (
  meter_trail_initialized ? (
    samples_per_frame = get_samples_per_frame();
    // Use shared utility for aging and expiration (returns new count)
    // Age index = 1, max_age index = 2 (for 3-value structure: gr_value, age, max_age)
    meter_trail_count = update_trail_items_generic(meter_trail_buffer, meter_trail_count, 3, 1, 2, samples_per_frame);
  );
);

// Render all active trail lines on the meter
// Called from @gfx section after draw_gain_reduction_meter()
function render_meter_trail_lines() (
  meter_trail_initialized && meter_trail_count > 0 && slider(38) > 0.5 ? (
    gr_meter_x = get_meter_x();
    gr_meter_y = get_meter_y();
    gr_meter_w = get_meter_w();
    gr_meter_h = get_meter_h();
    meter_center_y = gr_meter_y + gr_meter_h / 2;
    
    i = 0;
    while (i < meter_trail_count) (
      line_idx = i * 3;
      gr_value_db = meter_trail_buffer[line_idx];
      line_age = meter_trail_buffer[line_idx + 1];
      line_max_age = meter_trail_buffer[line_idx + 2];
      
      // Calculate fade alpha using exponential decay (0.0833 at creation, 0.0 at max_age)
      // Exponential decay: faster decay at start, slows down as it fades (exp(-k*t) behavior)
      // Decay rate of 2.5 provides smooth exponential fade over 2.5 seconds
      // Starting opacity reduced to 1/3rd of 0.25 = 0.0833 for very subtle trail lines
      alpha = calculate_trail_alpha_exponential(line_age, line_max_age, 0.0833, 2.5);
      
      alpha > 0.01 ? (
        // Calculate line position based on GR value
        gr_value_db < 0 ? (
          // Negative GR (compression) - orange line from top
          gr_height = abs(gr_value_db) * GR_PIXELS_PER_DB;
          gr_height = min(gr_height, gr_meter_h);
          line_y = gr_meter_y + gr_height;
          line_y = min(line_y, meter_center_y); // Don't cross center line
          
          // Orange color: (1, 0.5, 0) - draw 3-pixel tall line for better blending
          gfx_set(1, 0.5, 0, alpha);
          gfx_rect(gr_meter_x, line_y - 1, gr_meter_w, 3);
        ) : gr_value_db > 0 ? (
          // Positive GR (gain addition) - blue line from bottom
          gr_height = abs(gr_value_db) * GR_PIXELS_PER_DB;
          gr_height = min(gr_height, gr_meter_h);
          line_y = gr_meter_y + gr_meter_h - gr_height;
          line_y = max(line_y, meter_center_y); // Don't cross center line
          
          // Blue color: (0.2, 0.5, 1) - draw 3-pixel tall line for better blending
          gfx_set(0.2, 0.5, 1, alpha);
          gfx_rect(gr_meter_x, line_y - 1, gr_meter_w, 3);
        );
      );
      i += 1;
    );
  );
);

function update_and_render_meter_trail_lines() (
  // Always update (age lines) so they fade out even when audio stops
  // This ensures lines don't disappear abruptly when meter early exits
  update_meter_trail_lines();
  
  // Always render if there are lines to render (regardless of audio state)
  // This allows lines to continue fading after playback stops
  // The render function itself checks for metering enabled (slider(38))
  render_meter_trail_lines();
);

