desc:Flattery (WIP)
// Frequency-domain "leveling" based on adjacent FFT bins.
// Pre (feedforward) analysis only. Modular includes live under this folder.

options:gfx_hz=30

// --- User parameters  ---
// Core
slider1:fft_size_sel=3<0,8,1{8,16,32,64,128,256,512,1024,2048}>FFT Size
slider2:wet=100<0,100,1>Wet (%)
slider3:strength=1<0,2,0.01>Strength
slider4:max_adjust_db=12<0,48,0.1>Max Adjust (dB)

// Nearby bins logic
slider5:neighbor_radius=1<1,12,1>Radius (bins)
slider6:neighbor_mode=0<0,1,1{Mean,Median}>Neighbor Mode
slider7:stereo_link=100<0,100,1>Stereo Link (%)
slider8:ms_mode=0<0,1,1{LR,MS}>Process Domain

// Timing
slider9:attack_ms=10<0.1,200,0.1>Attack (ms)
slider10:release_ms=100<1,2000,1>Release (ms)
slider54:input_rms_ms=0<0,2000,1>Input RMS (ms)

// Operating range + cut band
slider11:min_operate_db=-80<-120,0,0.1>Operate Min (dB)
slider12:max_operate_db=0<-120,0,0.1>Operate Max (dB)
slider13:low_cut_hz=20<20,20000,1>Low Cut (Hz)
slider14:high_cut_hz=20000<20,20000,1>High Cut (Hz)

// Target curve shaping
slider15:tilt_db_per_oct=0<-12,12,0.1>Tilt (dB/oct)
slider16:tilt_pivot_hz=1000<20,20000,1>-Tilt Pivot (Hz)

// Delta shaping + noise handling
slider17:delta_knee_db=6<0,24,0.1>Delta Knee (soften small deltas, dB)
slider18:delta_shape_exp=2<1,4,0.1>Delta Shape (exp>1 steeper near knee)
slider19:no_boost_below_db=-90<-150,0,1>No-Boost Below (dB)

// Eco mode
slider20:eco_mode=0<0,1,1{Off,On}>Eco Mode
slider21:eco_blend=0.25<0,1,0.01>Eco Blend
slider22:eco_interval=2<1,8,1>Eco Interval (hops)

// Transient protection
slider23:transient_protect_pct=0<0,100,1>Transient Protect (%)
slider24:transient_sensitivity=2<0,10,0.1>Transient Sensitivity
slider25:transient_fast_ms=1<0.1,20,0.1>-Transient Fast (ms)
slider26:transient_slow_ms=30<1,200,1>-Transient Slow (ms)

// --- Future 4-band split points (hidden for now, but editable) ---
slider27:band_split1_hz=100<20,20000,1>-Band Split 1 (Hz)
slider28:band_split2_hz=1000<20,20000,1>-Band Split 2 (Hz)
slider29:band_split3_hz=2000<20,20000,1>-Band Split 3 (Hz)

// Future per-band enable/strength/radius/tilt offsets (hidden)
slider30:band1_enabled=1<0,1,1>-Band1 Enabled
slider31:band2_enabled=1<0,1,1>-Band2 Enabled
slider32:band3_enabled=1<0,1,1>-Band3 Enabled
slider33:band4_enabled=1<0,1,1>-Band4 Enabled

slider34:band1_strength_mul=1<0,2,0.01>-Band1 Strength Mul
slider35:band2_strength_mul=1<0,2,0.01>-Band2 Strength Mul
slider36:band3_strength_mul=1<0,2,0.01>-Band3 Strength Mul
slider37:band4_strength_mul=1<0,2,0.01>-Band4 Strength Mul

slider38:band1_radius_mul=1<0.25,4,0.01>-Band1 Radius Mul
slider39:band2_radius_mul=1<0.25,4,0.01>-Band2 Radius Mul
slider40:band3_radius_mul=1<0.25,4,0.01>-Band3 Radius Mul
slider41:band4_radius_mul=1<0.25,4,0.01>-Band4 Radius Mul

slider42:band1_tilt_offset_db_per_oct=0<-12,12,0.1>-Band1 Tilt Offset (dB/oct)
slider43:band2_tilt_offset_db_per_oct=0<-12,12,0.1>-Band2 Tilt Offset (dB/oct)
slider44:band3_tilt_offset_db_per_oct=0<-12,12,0.1>-Band3 Tilt Offset (dB/oct)
slider45:band4_tilt_offset_db_per_oct=0<-12,12,0.1>-Band4 Tilt Offset (dB/oct)

// Per-band operate ranges (hidden; used only if we later stop mirroring globals)
slider46:band1_min_db=-80<-120,0,0.1>-Band1 Min (dB)
slider47:band1_max_db=0<-120,0,0.1>-Band1 Max (dB)
slider48:band2_min_db=-80<-120,0,0.1>-Band2 Min (dB)
slider49:band2_max_db=0<-120,0,0.1>-Band2 Max (dB)
slider50:band3_min_db=-80<-120,0,0.1>-Band3 Min (dB)
slider51:band3_max_db=0<-120,0,0.1>-Band3 Max (dB)
slider52:band4_min_db=-80<-120,0,0.1>-Band4 Min (dB)
slider53:band4_max_db=0<-120,0,0.1>-Band4 Max (dB)

// --- Future 4-band split points (hidden for now, but editable) ---
slider19:band_split1_hz=100<20,20000,1>-Band Split 1 (Hz)
slider20:band_split2_hz=1000<20,20000,1>-Band Split 2 (Hz)
slider21:band_split3_hz=2000<20,20000,1>-Band Split 3 (Hz)

// Per-band operate ranges (hidden; currently use same defaults)
slider22:band1_min_db=-80<-120,0,0.1>-Band1 Min (dB)
slider23:band1_max_db=0<-120,0,0.1>-Band1 Max (dB)
slider24:band2_min_db=-80<-120,0,0.1>-Band2 Min (dB)
slider25:band2_max_db=0<-120,0,0.1>-Band2 Max (dB)
slider26:band3_min_db=-80<-120,0,0.1>-Band3 Min (dB)
slider27:band3_max_db=0<-120,0,0.1>-Band3 Max (dB)
slider28:band4_min_db=-80<-120,0,0.1>-Band4 Min (dB)
slider29:band4_max_db=0<-120,0,0.1>-Band4 Max (dB)

slider30:band1_enabled=1<0,1,1>-Band1 Enabled
slider31:band2_enabled=1<0,1,1>-Band2 Enabled
slider32:band3_enabled=1<0,1,1>-Band3 Enabled
slider33:band4_enabled=1<0,1,1>-Band4 Enabled

slider34:band1_strength_mul=1<0,2,0.01>-Band1 Strength Mul
slider35:band2_strength_mul=1<0,2,0.01>-Band2 Strength Mul
slider36:band3_strength_mul=1<0,2,0.01>-Band3 Strength Mul
slider37:band4_strength_mul=1<0,2,0.01>-Band4 Strength Mul

// --- Imports (relative to this .jsfx file) ---
import 01_Utils/01_constants.jsfx-inc
import 01_Utils/02_math_utils.jsfx-inc

import 02_FFT/01_fft_memory.jsfx-inc
import 02_FFT/02_fft_core.jsfx-inc

import 03_Processing/05_param_cache.jsfx-inc
import 03_Processing/00_transient_protect.jsfx-inc
import 03_Processing/01_band_config.jsfx-inc
import 03_Processing/02_attack_release.jsfx-inc
import 03_Processing/03_surround_logic.jsfx-inc
import 03_Processing/04_stft_process.jsfx-inc
import 03_Processing/06_output_mix.jsfx-inc

import 04_UI/01_ui.jsfx-inc

@init
  sff_allocate_memory();

  // Set initial FFT size from enum selection
  sff_set_fft_size(8 << (fft_size_sel|0));

  // Latency/pipeline: keep simple fixed latency = fft_size samples
  sff_latency = fft_size|0;

  // Transient protection init
  transient_env_fast = 0;
  transient_env_slow = 0;
  transient_amount = 0;
  transient_strength_scale = 1;
  sff_init_param_trackers();

@slider
  // Derive FFT size from selection
  desired_fft = 8 << (fft_size_sel|0);
  desired_fft != (fft_size|0) ? (
    sff_set_fft_size(desired_fft);
    sff_latency = fft_size|0;
  );

  sff_update_band_ranges_from_global();
  sff_order_band_splits();
  sff_update_cutoff_bins();
  sff_update_tilt_if_needed_with_offsets();

  // Cache noise-floor boost cutoff
  no_boost_below_lin = sff_db_to_linear(no_boost_below_db);

  // Cache wet mix for @sample
  wet_mix = wet * 0.01;
  sff_update_delta_recompute_flag();

  // Transient protect normalized
  transient_protect = transient_protect_pct * 0.01;

  // PDC (unconditional, per rules)
  pdc_delay = sff_latency|0;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

@block
  // Update hop-time-based smoothing coeffs
  sff_update_time_coeffs();
  sff_update_transient_coeffs();

@sample
  // Update transient detector (scales effective strength)
  sff_transient_tick(spl0, spl1);

  // Read scheduled output and clear slot (overlap-add accumulator)
  outn = out_buf_size|0;
  outL = sff_out_ring_L[sff_out_read_pos];
  outR = sff_out_ring_R[sff_out_read_pos];
  sff_out_ring_L[sff_out_read_pos] = 0;
  sff_out_ring_R[sff_out_read_pos] = 0;

  // Push new input into analysis ring
  n = fft_size|0;
  // Dry path must be delayed by same latency as wet (avoid comb filtering)
  dryL = sff_in_ring_L[sff_ring_pos];
  dryR = sff_in_ring_R[sff_ring_pos];
  sff_in_ring_L[sff_ring_pos] = spl0;
  sff_in_ring_R[sff_ring_pos] = spl1;

  // Advance positions
  sff_ring_pos = (sff_ring_pos + 1) % n;
  sff_out_read_pos = (sff_out_read_pos + 1) % outn;

  // Hop trigger
  sff_hop_counter += 1;
  sff_hop_counter >= hop_size ? (
    sff_hop_counter = 0;
    sff_process_stereo_frame();
  );

  // Output
  spl0 = sff_mix_dry_wet(dryL, outL, wet_mix);
  spl1 = sff_mix_dry_wet(dryR, outR, wet_mix);

@gfx 900 260
  sff_ui_draw();

