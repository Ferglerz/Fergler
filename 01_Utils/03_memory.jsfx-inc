// Memory Management Module
// Pure memory allocation and management functions
// No dependencies - contains memory layout constants

@init

//==============================================================================
// MEMORY ALLOCATION FUNCTIONS
//==============================================================================

function allocate_memory() (
  // Initialize automatic memory allocation
  // freemem is initialized in Composure.jsfx before read_slider_definitions
  // and incremented by read_slider_definitions, so we continue from there.
  
  // Allocate graph points memory (2 values per point: x,y)
  graph_points = freemem;
  freemem += MAX_POINTS * 2;
  
  // Allocate curve amounts memory (1 value per point)
  curve_amounts = freemem;
  freemem += MAX_POINTS;
  
  // Allocate compression lookup table (560 entries for -120dB to +20dB at 0.25dB granularity)
  comp_lut = freemem;
  freemem += COMP_LUT_SIZE;
  





  // Always allocate audio buffers (these can be reallocated safely)
  // Allocate based on lookahead slider's maximum value (slider12)
  // Convert from milliseconds to samples: max_ms * 0.001 * srate
  lookahead_max_ms = get_slider_max(10); // Get max from slider definition
  lookahead_needed_samples = ceil(lookahead_max_ms * 0.001 * srate);
  
  // OPTIMIZATION: Round up to next power of 2 for efficient bit masking instead of modulo
  // This allows using (index & mask) instead of (index % size) in circular buffer
  max_lookahead_samples = 1;
  while(max_lookahead_samples < lookahead_needed_samples) (
    max_lookahead_samples *= 2;
  );
  lookahead_mask = max_lookahead_samples - 1; // For bit masking: (pos & mask) == (pos % size)
  
  lookahead_buffer_l = freemem; freemem += max_lookahead_samples;
  lookahead_buffer_r = freemem; freemem += max_lookahead_samples;

  // Utilize FerglerUI library to allocate memory for UI components
  // Passing NUM_CONTROLS and NUM_GROUPS as they are defined in Composure constants
  FerglerUI_allocate_memory(NUM_CONTROLS, NUM_GROUPS);


  
  // Trail buffer allocation (4 values per dot: x, y, age, max_age)
  // Fixed settings: fade 600ms, interval 20ms → ~30 dots; allocate generous headroom
  // Store original allocated size to prevent buffer overflow
  // Use conditional allocation pattern to preserve buffer address when ext_noinit=1
  !trail_max_dots_allocated ? (
    trail_max_dots_allocated = 4096; // Large headroom for high dot density / long fades
  );
  trail_max_dots = trail_max_dots_allocated; // Current limit (may be reduced in @slider)
  trail_buffer = freemem;
  freemem += trail_max_dots_allocated * 4;
  
  // Meter trail lines buffer allocation (3 values per line: gr_value_db, age, max_age)
  // Allocate based on 2.5 second fade duration with one line per buffer
  // Worst case: smallest buffer size (128 samples) at highest sample rate (192kHz)
  // Buffers per second: 192000 / 128 = 1500
  // Buffers in 2.5 seconds: 1500 * 2.5 = 3750
  // Add 20% buffer for safety: 3750 * 1.2 = 4500
  // Using freemem to ensure proper memory management and avoid conflicts with other UI components
  // Use conditional allocation pattern to preserve buffer address when ext_noinit=1
  !meter_trail_max_lines_allocated ? (
    meter_trail_max_lines_allocated = 4500; // Maximum size based on worst case scenario (2.5 seconds)
  );
  meter_trail_max_lines = meter_trail_max_lines_allocated; // Current limit
  meter_trail_buffer = freemem;
  freemem += meter_trail_max_lines_allocated * 3;
  
  // Page button system memory allocation
  // Button state array (4 fields per button * 16 max buttons = 64 slots)
  button_state = freemem;
  freemem += 64;
  
  // Page fade amounts array (NUM_PAGES slots, NUM_PAGES = 4)
  page_fade_amounts = freemem;
  freemem += 4;  // NUM_PAGES = 4
  
  // Page blur amounts array (NUM_PAGES slots, NUM_PAGES = 4)
  page_blur_amounts = freemem;
  freemem += 4;  // NUM_PAGES = 4
  
  // Page button position arrays (NUM_PAGE_BUTTONS = 4)
  page_button_x_base = freemem;
  freemem += 4;  // NUM_PAGE_BUTTONS = 4
  
  page_button_y_base = freemem;
  freemem += 4;  // NUM_PAGE_BUTTONS = 4
  
  // Settings button position arrays (NUM_SETTINGS_BUTTONS = 2, Debug button moved to invisible top-left)
  settings_button_x_base = freemem;
  freemem += 2;  // NUM_SETTINGS_BUTTONS = 2

  settings_button_y_base = freemem;
  freemem += 2;  // NUM_SETTINGS_BUTTONS = 2
  

);

