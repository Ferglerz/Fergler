// Mathematical Utilities Module
// Composure-specific mathematical functions and utilities
// Dependencies: MathUtils/00_core_math.jsfx-inc (for clamp, tanh, db_to_linear, linear_to_db, eps, LOG10_20, LOG_10_20)

import ../MathUtils/00_core_math.jsfx-inc

@init


//==============================================================================
// CONSTANT INITIALIZATION FUNCTIONS
//==============================================================================

// Initialize limiter normalization constant (depends on tanh function)
function init_limiter_constants() (
  LIMITER_TANH_NORM = 1.0 / tanh(0.95);  // ≈ 1.343
);




