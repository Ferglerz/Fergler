// Surround FFT Flattener - Parameter caching helpers (DRY + fast)

@init

function sff_init_param_trackers() (
  // Delta-affecting trackers
  sff_prev_neighbor_radius = neighbor_radius;
  sff_prev_neighbor_mode = neighbor_mode;
  sff_prev_low_cut_hz = low_cut_hz;
  sff_prev_high_cut_hz = high_cut_hz;

  // Force at least one recompute after load
  sff_force_recompute_deltas = 1;
);

function sff_order_band_splits() (
  band_split2_hz < band_split1_hz ? (band_split2_hz = band_split1_hz;) : 0;
  band_split3_hz < band_split2_hz ? (band_split3_hz = band_split2_hz;) : 0;
);

function sff_update_band_ranges_from_global() (
  // Map single operate range sliders into all band ranges for now
  band1_min_db = band2_min_db = band3_min_db = band4_min_db = min_operate_db;
  band1_max_db = band2_max_db = band3_max_db = band4_max_db = max_operate_db;

  // Precompute per-band linear thresholds (for fast gating)
  band1_min_lin = sff_db_to_linear(band1_min_db);
  band1_max_lin = sff_db_to_linear(band1_max_db);
  band2_min_lin = sff_db_to_linear(band2_min_db);
  band2_max_lin = sff_db_to_linear(band2_max_db);
  band3_min_lin = sff_db_to_linear(band3_min_db);
  band3_max_lin = sff_db_to_linear(band3_max_db);
  band4_min_lin = sff_db_to_linear(band4_min_db);
  band4_max_lin = sff_db_to_linear(band4_max_db);
);

function sff_update_cutoff_bins() local(nyq) (
  nyq = 0.5 * srate;
  low_cut_hz = sff_clamp(low_cut_hz, 0, nyq);
  high_cut_hz = sff_clamp(high_cut_hz, 0, nyq);
  high_cut_hz < low_cut_hz ? (high_cut_hz = low_cut_hz;) : 0;

  low_cut_bin = sff_hz_to_bin(low_cut_hz);
  high_cut_bin = sff_hz_to_bin(high_cut_hz);

  low_cut_bin = sff_clamp(low_cut_bin, 0, (pos_bin_count-1));
  high_cut_bin = sff_clamp(high_cut_bin, 0, (pos_bin_count-1));
  high_cut_bin < low_cut_bin ? (high_cut_bin = low_cut_bin;) : 0;
);

function sff_update_delta_recompute_flag() (
  // If parameters affecting delta calc changed, force a delta recompute next hop
  (neighbor_radius != sff_prev_neighbor_radius ||
   neighbor_mode != sff_prev_neighbor_mode ||
   low_cut_hz != sff_prev_low_cut_hz ||
   high_cut_hz != sff_prev_high_cut_hz) ? (
    sff_force_recompute_deltas = 1;
    sff_prev_neighbor_radius = neighbor_radius;
    sff_prev_neighbor_mode = neighbor_mode;
    sff_prev_low_cut_hz = low_cut_hz;
    sff_prev_high_cut_hz = high_cut_hz;
  ) : 0;
);

