// Surround FFT Flattener - Transient protection (cheap time-domain)

@init

function sff_update_transient_coeffs() local(f_s, s_s) (
  f_s = max(transient_fast_ms, 0.1) * 0.001;
  s_s = max(transient_slow_ms, 0.1) * 0.001;

  // per-sample one-pole coeffs
  transient_fast_coeff = exp(-1 / ((f_s * srate) + eps));
  transient_slow_coeff = exp(-1 / ((s_s * srate) + eps));
);

function sff_transient_tick(xL, xR) local(x, fast, slow, diff, ratio, amt) (
  // Use mono sum for detection
  x = 0.5 * (abs(xL) + abs(xR));

  fast = transient_env_fast + (x - transient_env_fast) * (1 - transient_fast_coeff);
  slow = transient_env_slow + (x - transient_env_slow) * (1 - transient_slow_coeff);
  transient_env_fast = fast;
  transient_env_slow = slow;

  diff = max(fast - slow, 0);
  ratio = diff / (slow + eps);

  // Scale and clamp to 0..1
  amt = sff_clamp(ratio * transient_sensitivity, 0, 1);
  transient_amount = amt;

  // Convert to a strength scale (1..(1-transient_protect))
  transient_strength_scale = 1 - (transient_protect * amt);
);

