// Surround FFT Flattener - Core "surrounding bins" logic
// Computes the *ideal* delta (dB) between current bin magnitude and a neighbor-based target.
// Strength/attack/release are applied elsewhere.

@init

function sff_median_sort_buf(count) local(i, j, tmp) (
  // Insertion sort (small window, deterministic)
  i = 1;
  loop(max(count-1, 0),
    j = i;
    while(j > 0 && sff_median_buf[j-1] > sff_median_buf[j]) (
      tmp = sff_median_buf[j-1];
      sff_median_buf[j-1] = sff_median_buf[j];
      sff_median_buf[j] = tmp;
      j -= 1;
    );
    i += 1;
  );
  sff_median_buf[(count*0.5)|0];
);

function sff_median_target_lin(mag_base, bin, radius) local(npos, rad, d, idx, count) (
  npos = pos_bin_count|0;
  rad = sff_clamp(radius, 1, SFF_MAX_MEDIAN_RADIUS);
  // Exclude current bin - only use neighbors for target calculation
  count = 0;
  d = -rad;
  loop(rad*2 + 1,
    d != 0 ? (  // Skip current bin (d=0)
      idx = bin + d;
      idx = idx < 0 ? 0 : (idx >= npos ? (npos-1) : idx);
      sff_median_buf[count] = mag_base[idx];
      count += 1;
    ) : 0;
    d += 1;
  );
  count > 0 ? sff_median_sort_buf(count) : mag_base[bin];
);

function sff_median_target_lin_stereo(magL_base, magR_base, bin, radius) local(npos, rad, d, idx, count) (
  npos = pos_bin_count|0;
  rad = sff_clamp(radius, 1, SFF_MAX_MEDIAN_RADIUS);
  // Exclude current bin - only use neighbors for target calculation
  count = 0;
  d = -rad;
  loop(rad*2 + 1,
    d != 0 ? (  // Skip current bin (d=0)
      idx = bin + d;
      idx = idx < 0 ? 0 : (idx >= npos ? (npos-1) : idx);
      sff_median_buf[count] = 0.5 * (magL_base[idx] + magR_base[idx]);
      count += 1;
    ) : 0;
    d += 1;
  );
  count > 0 ? sff_median_sort_buf(count) : (0.5 * (magL_base[bin] + magR_base[bin]));
);

function sff_neighbor_target_lin(mag_base, bin, radius) local(npos, d, sum, sumw, w, idxL, idxR) (
  neighbor_mode == 1 ? (
    // Median over current radius (2*radius+1 window)
    sff_median_target_lin(mag_base, bin, radius);
  ) : (
    npos = pos_bin_count|0;
    sum = 0;
    sumw = 0;
    d = 1;
    loop(radius,
      w = 1.0 / (d + eps);

      idxL = bin - d;
      idxL >= 0 ? (
        sum += mag_base[idxL] * w;
        sumw += w;
      ) : 0;

      idxR = bin + d;
      idxR < npos ? (
        sum += mag_base[idxR] * w;
        sumw += w;
      ) : 0;

      d += 1;
    );
    sumw > 0 ? (sum / sumw) : mag_base[bin];
  );
);

function sff_neighbor_target_lin_stereo(magL_base, magR_base, bin, radius) local(npos, d, sum, sumw, w, idxL, idxR, v) (
  neighbor_mode == 1 ? (
    sff_median_target_lin_stereo(magL_base, magR_base, bin, radius);
  ) : (
    npos = pos_bin_count|0;
    sum = 0;
    sumw = 0;
    d = 1;
    loop(radius,
      w = 1.0 / (d + eps);

      idxL = bin - d;
      idxL >= 0 ? (
        v = 0.5 * (magL_base[idxL] + magR_base[idxL]);
        sum += v * w;
        sumw += w;
      ) : 0;

      idxR = bin + d;
      idxR < npos ? (
        v = 0.5 * (magL_base[idxR] + magR_base[idxR]);
        sum += v * w;
        sumw += w;
      ) : 0;

      d += 1;
    );
    sumw > 0 ? (sum / sumw) : (0.5 * (magL_base[bin] + magR_base[bin]));
  );
);

function sff_bin_is_active(bin, mag_lin) local(hz, band, min_lin, max_lin) (
  // Band-pass processing: bins outside cutoff range are dry
  (bin < low_cut_bin || bin > high_cut_bin) ? 0 : (
    hz = bin * bin_hz;
    band = sff_get_band_index_for_hz(hz);

    sff_get_band_enabled(band) ? (
      min_lin = sff_get_band_min_lin(band);
      max_lin = sff_get_band_max_lin(band);
      (mag_lin >= min_lin && mag_lin <= max_lin) ? 1 : 0;
    ) : 0;
  );
);

function sff_compute_delta_db_for_bin(mag_base, bin, radius) local(mag_lin, target_lin, tilt, ratio, hz, band, radius_eff, delta, knee, expv, a) (
  mag_lin = mag_base[bin];
  sff_bin_is_active(bin, mag_lin) ? (
    // Per-band radius scaling (ignored by median modes, but used by weighted mean)
    hz = bin * bin_hz;
    band = sff_get_band_index_for_hz(hz);
    radius_eff = floor(max(1, radius * sff_get_band_radius_mul(band)) + 0.5);
    radius_eff = sff_clamp(radius_eff, 1, 24);

    target_lin = sff_neighbor_target_lin(mag_base, bin, radius_eff);
    tilt = sff_tilt_lin[bin];
    ratio = (target_lin * tilt) / (mag_lin + eps);
    delta = sff_linear_to_db(max(ratio, eps));

    // Noise-floor boost protection
    (delta > 0 && mag_lin < no_boost_below_lin) ? (delta = 0;) : 0;

    // Delta shaping: reduce subtle deltas, leave big deltas
    knee = max(delta_knee_db, 0);
    expv = max(delta_shape_exp, 1);
    (knee > 0 && expv > 1) ? (
      a = abs(delta);
      a < knee ? (
      a = a * pow(a / (knee + eps), expv - 1);
        delta = delta < 0 ? -a : a;
      ) : 0;
    ) : 0;

    delta;
  ) : 0;
);

function sff_compute_delta_db_for_bin_link(magL_base, magR_base, bin, radius) local(mag_lin, target_lin, tilt, ratio, hz, band, radius_eff, delta, knee, expv, a) (
  mag_lin = 0.5 * (magL_base[bin] + magR_base[bin]);
  sff_bin_is_active(bin, mag_lin) ? (
    hz = bin * bin_hz;
    band = sff_get_band_index_for_hz(hz);
    radius_eff = floor(max(1, radius * sff_get_band_radius_mul(band)) + 0.5);
    radius_eff = sff_clamp(radius_eff, 1, 24);

    target_lin = sff_neighbor_target_lin_stereo(magL_base, magR_base, bin, radius_eff);
    tilt = sff_tilt_lin[bin];
    ratio = (target_lin * tilt) / (mag_lin + eps);
    delta = sff_linear_to_db(max(ratio, eps));
    (delta > 0 && mag_lin < no_boost_below_lin) ? (delta = 0;) : 0;

    knee = max(delta_knee_db, 0);
    expv = max(delta_shape_exp, 1);
    (knee > 0 && expv > 1) ? (
      a = abs(delta);
      a < knee ? (
      a = a * pow(a / (knee + eps), expv - 1);
        delta = delta < 0 ? -a : a;
      ) : 0;
    ) : 0;

    delta;
  ) : 0;
);

