// Envelope Utilities Module
// Shared utilities and constants for envelope processing
// No dependencies

@init

//==============================================================================
// ENVELOPE STATE INITIALIZATION
//==============================================================================

function init_envelope_state() (
  // Hold state variables
  hold_counter_samples = 0;  // Counts down from hold_ms in samples
  hold_target_gr_db = 0;     // The held gain reduction value
  hold_baseline_gr_db = 0;   // Baseline gain reduction used to detect new holds
  
  // Global smoothed gain reduction (envelope follower output)
  global_smoothed_gain_db = 0;
  
  // Global smoothed gain reduction before strength (for ghost line visualization)
  global_smoothed_gain_db_before_strength = 0;
  
  // Program release state
  base_fast_s = 0.05;  // 50ms
  base_med_s = 0.3;    // 300ms
  base_slow_s = 1.0;   // 1000ms
  
  // Min() envelope mode state variables (currently unused - may be for future feature)
  min_env_yR = 0;  // Release filter state
  min_env_yA = 0;  // Attack filter state
);

//==============================================================================
// CURVE SHAPING CONSTANTS
//==============================================================================

CURVE_CALIBRATION_DB = 10.0;
CURVE_FAST_MULTIPLIER = 1.5;
CURVE_SLOW_MULTIPLIER = 1.5;

curve_fast_coeff_cached = 0;
curve_slow_coeff_cached = 0;
rel_input_fast_cached = 0;

//==============================================================================
// UTILITY FUNCTIONS
//==============================================================================

//--- Helper: Clamp coefficient to [0, 1] range ---
function clamp_coeff(value) (
  max(0, min(1, value))
);

//--- Helper: Blend between two coefficients based on normalized weights ---
function blend_two_coefficients(coef1, coef2, blend_factor) (
  coef1 * (1 - blend_factor) + coef2 * blend_factor
);

//--- Helper: Normalized blend using fast/slow weights ---
function normalized_blend(blend_fast, blend_slow, coef_fast, coef_slow) local(sum) (
  sum = blend_fast + blend_slow;
  sum > EPS ? (
    (blend_fast * coef_fast + blend_slow * coef_slow) / sum
  ) : (
    coef_fast
  )
);

//--- Helper: Apply exponential smoothing envelope update ---
// CRITICAL: Coefficients must be in valid range [EPS, 1-EPS] to prevent clicks
// Coefficients outside this range cause instant jumps (coeff=0) or no movement (coeff=1)
function apply_envelope_smoothing(coeff, target_value) local(valid_coeff) (
  // Clamp coefficient to valid range to prevent discontinuities
  // EPS prevents instant jumps, 1-EPS prevents no movement
  valid_coeff = max(EPS, min(1 - EPS, coeff));
  global_smoothed_gain_db = valid_coeff * global_smoothed_gain_db + (1 - valid_coeff) * target_value;
  global_smoothed_gain_db;
);

//--- Helper: Apply linear dB reduction envelope update ---
// Uses linear dB-per-sample reduction instead of exponential smoothing
// db_per_sample: dB to reduce per sample (positive value means reducing GR magnitude)
// NOTE: This function is only called during release phase, so we always apply linear reduction
function apply_linear_envelope_smoothing(db_per_sample, target_value) (
  // Linear reduction: reduce GR magnitude by fixed dB amount per sample until reaching target
  // For negative GR values (typical case): target is less negative (closer to 0) than current
  // For positive GR values: target is less positive (closer to 0) than current
  // We need to move towards 0, which means:
  // - For negative GR: add db_per_sample (make less negative)
  // - For positive GR: subtract db_per_sample (make less positive)
  abs(target_value) < abs(global_smoothed_gain_db) ? (
    // Releasing: target has less GR (closer to 0) than current
    // Move towards target by reducing GR magnitude
    global_smoothed_gain_db > 0 ? (
      // Positive GR: subtract to move towards 0
      global_smoothed_gain_db = global_smoothed_gain_db - db_per_sample;
    ) : (
      // Negative GR: add to move towards 0 (make less negative)
      global_smoothed_gain_db = global_smoothed_gain_db + db_per_sample;
    );
  ) : (
    // Attack: target has more GR (further from 0) than current
    // This shouldn't happen in release phase, but handle gracefully
    global_smoothed_gain_db = target_value;
  );
  global_smoothed_gain_db;
);

//--- Helper: Apply linear dB reduction envelope update for pre-strength GR ---
// Uses linear dB-per-sample reduction for pre-strength tracking
// NOTE: This function is only called during release phase, so we always apply linear reduction
function apply_linear_envelope_smoothing_before_strength(db_per_sample, target_value) (
  // Linear reduction: reduce GR magnitude by fixed dB amount per sample until reaching target
  abs(target_value) < abs(global_smoothed_gain_db_before_strength) ? (
    // Releasing: target has less GR (closer to 0) than current
    global_smoothed_gain_db_before_strength > 0 ? (
      // Positive GR: subtract to move towards 0
      global_smoothed_gain_db_before_strength = global_smoothed_gain_db_before_strength - db_per_sample;
    ) : (
      // Negative GR: add to move towards 0 (make less negative)
      global_smoothed_gain_db_before_strength = global_smoothed_gain_db_before_strength + db_per_sample;
    );
  ) : (
    // Attack: target has more GR (further from 0) than current
    // This shouldn't happen in release phase, but handle gracefully
    global_smoothed_gain_db_before_strength = target_value;
  );
  global_smoothed_gain_db_before_strength;
);

//--- Helper: Apply exponential smoothing envelope update for pre-strength GR (ghost line) ---
// Uses same coefficient as main envelope to keep smoothing behavior synchronized
function apply_envelope_smoothing_before_strength(coeff, target_value) local(valid_coeff) (
  // Clamp coefficient to valid range to prevent discontinuities
  valid_coeff = max(EPS, min(1 - EPS, coeff));
  global_smoothed_gain_db_before_strength = valid_coeff * global_smoothed_gain_db_before_strength + (1 - valid_coeff) * target_value;
  global_smoothed_gain_db_before_strength;
);



