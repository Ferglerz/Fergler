//==============================================================================
// AUDIO PROCESSING CHAIN FUNCTIONS
//==============================================================================

@init

//==============================================================================
// HELPER FUNCTIONS
//==============================================================================

// Track maximum value for block-level statistics
function update_block_max(value, max_var) (
  value > max_var ? value : max_var
);

// Calculate peak level from stereo signals
function calculate_peak_level(left, right) (
  max(abs(left), abs(right))
);

// Get detection signal based on mode and sidechain state
// Returns detect_l and detect_r values based on feedforward/feedback mode
function get_detection_signal(has_stereo, has_sidechain_l, has_sidechain_r, input_l, input_r, feedback_l, feedback_r) local(mode, result_l, result_r) (
  mode = detection_mode > 0.5;
  mode ? (
    // Feedforward mode: use input or sidechain
    result_l = has_sidechain_l ? spl2 : input_l;
    result_r = has_sidechain_r ? spl3 : (has_stereo ? input_r : input_l);
  ) : (
    // Feedback mode: use output or sidechain
    result_l = has_sidechain_l ? spl2 : feedback_l;
    result_r = has_sidechain_r ? spl3 : feedback_r;
  );
  detect_l = result_l;
  detect_r = result_r;
);

//==============================================================================
// RMS STATE INITIALIZATION
//==============================================================================

function init_rms_state() (
  rms_max = 0.5;
  peak_for_normalize_smooth = 0;
  rms_smoothed_squared = 0;
  rms_size_ms_prev = -999;
  rms_samples = floor(rms_size_ms * 0.001 * srate);
  rms_samples < 1 ? rms_samples = 1;
  // Initialize target coefficients (will be set by update_rms_coefficient)
  rms_smoothing_coeff_target = 0;
  rms_smoothing_one_minus_target = 1;
  // Initialize actual coefficients to match targets
  rms_smoothing_coeff = 0;
  rms_smoothing_one_minus = 1;
);

//==============================================================================
// AUDIO PROCESSING STATE INITIALIZATION
//==============================================================================

function init_audio_processing_state() (
  final_l_prev = 0;
  final_r_prev = 0;
  current_input_db = GRAPH_MIN_DB;
  current_gr_db = 0;
  current_gr_db_before_strength = 0;  // Still needed for envelope processing
  detector_level_block_max = MIN_DETECTOR_LEVEL;
  gr_db_block_max = 0;
  gr_processing_skipped = 0;
  program_release_timer = 0;
  prev_detector_db = GRAPH_MIN_DB;  // Initialize for rate-of-change release mode
  listen_crossfade = 0;
  listen_crossfade_prev = 0;
  listen_reinit_pending = 0;
  listen_preview_drag_active = 0;
  // Denormal / deep-silence line flush (see process_complete_audio_chain)
  denormal_quiet_i = 0;
  denormal_flush_done = 0;
  denormal_flush_hold_samples = max(256, floor(srate * 0.05));
  // Track brickwall slider for limiter prev-sample stale reset on enable
  brickwall_limiter_slider_prev = -1;
);

// After sustained near-silence on the processed input path, flush filter + RMS states
// to avoid denormal CPU cost and stale tiny accumulators (matches init_rms_state defaults)
function flush_line_level_denormal_state() (
  flush_detection_filter_denormal_states();
  rms_max = 0.5;
  peak_for_normalize_smooth = 0;
  rms_smoothed_squared = 0;
  detect_squared_l = 0;
  detect_squared_r = 0;
  detect_squared = 0;
);

//==============================================================================
// COMPLETE AUDIO PROCESSING CHAIN
//==============================================================================

function process_complete_audio_chain() (
  debug_profiling_enabled > 0.5 ? debug_counter_audio_chain += 1;

  input_l_orig = spl0;
  input_r_orig = spl1;
  has_stereo = (num_ch >= 2);
  has_sidechain_l = (use_sidechain && num_ch >= 3);
  has_sidechain_r = (use_sidechain && num_ch >= 4);

  proc_l = input_l_orig;
  proc_r = input_r_orig;
  mid_side_mode > 0.5 && has_stereo ? (
    proc_l = (input_l_orig + input_r_orig) * 0.5;
    proc_r = (input_l_orig - input_r_orig) * 0.5;
  );

  // Near-silence hold: flush biquad + RMS detector state once per silence episode (denormal hygiene)
  max(abs(proc_l), abs(proc_r)) < 1e-10 ? (
    denormal_quiet_i += 1;
    denormal_quiet_i >= denormal_flush_hold_samples && denormal_flush_done < 0.5 ? (
      flush_line_level_denormal_state();
      denormal_flush_done = 1;
    );
  ) : (
    denormal_quiet_i = 0;
    denormal_flush_done = 0;
  );

  get_detection_signal(has_stereo, has_sidechain_l, has_sidechain_r, proc_l, proc_r, final_l_prev, final_r_prev);

  (hp_filter_enabled || lp_filter_enabled) ? (
    apply_detection_filters(detect_l, detect_r);
    detect_l = filtered_l;
    detect_r = filtered_r;
  );

  listen_fade_target = (sc_adjust_preview_enabled > 0.5 && listen_preview_drag_active > 0.5) ? 1 : 0;
  listen_crossfade = listen_crossfade + (listen_fade_target - listen_crossfade) * listen_fade_one_minus;
  (listen_crossfade_prev > 0.05 && listen_crossfade < 0.05) ? listen_reinit_pending = 1;
  listen_crossfade_prev = listen_crossfade;

  lf = listen_crossfade;
  need_prog = lf <= 0.999;

  need_prog ? (
    listen_reinit_pending > 0.5 ? (
      global_smoothed_gain_db = 0;
      global_smoothed_gain_db_before_strength = 0;
      hold_counter_samples = 0;
      rms_max = 0.5;
      pl_seed = calculate_peak_level(detect_l, detect_r);
      peak_for_normalize_smooth = pl_seed;
      detect_squared_l = detect_l * detect_l;
      detect_squared_r = detect_r * detect_r;
      detect_squared = (detect_squared_l + detect_squared_r) * 0.5;
      rms_smoothed_squared = detect_squared;
      prev_detector_db = clamp(linear_to_db(max(pl_seed, MIN_DETECTOR_LEVEL)) + input_offset_db, MIN_DETECTOR_DB_FLOOR, MAX_CURVE_INPUT_DB);
      limiter_prev_l = 0;
      limiter_prev_r = 0;
      flush_detection_filter_denormal_states();
      listen_reinit_pending = 0;
    );

    detect_squared_l = detect_l * detect_l;
    detect_squared_r = detect_r * detect_r;
    
    rms_size_ms > 0 ? (
      detect_squared = (detect_squared_l + detect_squared_r) * 0.5;
      rms_smoothed_squared = rms_smoothed_squared * rms_smoothing_coeff + detect_squared * rms_smoothing_one_minus;
      rms_level = sqrt(rms_smoothed_squared);
    ) : (
      rms_level = calculate_peak_level(detect_l, detect_r);
    );

    rms_normalization > 0.5 ? (
      rms_max = rms_level > rms_max ? rms_level : (rms_max * 0.9999);
      normalized_rms = rms_level / (rms_max + eps);
      peak_level = calculate_peak_level(detect_l, detect_r);
      norm_peak_c = rms_size_ms > 0 ? rms_smoothing_coeff : exp(-1.0 / (0.02 * srate));
      norm_peak_1m = 1.0 - norm_peak_c;
      peak_for_normalize_smooth = peak_for_normalize_smooth * norm_peak_c + peak_level * norm_peak_1m;
      detector_level = normalized_rms * peak_for_normalize_smooth;
    ) : (
      detector_level = rms_size_ms > 0 ? rms_level : calculate_peak_level(detect_l, detect_r);
    );

    detector_level = min(detector_level, MAX_DETECTOR_LINEAR);
    detector_level_db = clamp(linear_to_db(max(detector_level, MIN_DETECTOR_LEVEL)), MIN_DETECTOR_DB_FLOOR, MAX_DETECTOR_DB);
    curve_input_db = clamp(detector_level_db + input_offset_db, MIN_DETECTOR_DB_FLOOR, MAX_CURVE_INPUT_DB);
    can_skip_compression = (
      curve_input_db < comp_curve_min_threshold_db &&
      global_smoothed_gain_db > -0.01 &&
      global_smoothed_gain_db < 0.01
    );
    
    can_skip_compression ? (
      target_gr_db = 0;
      target_gr_db_before_strength = 0;
      gr_processing_skipped = 1;
    ) : (
      target_gr_db = calculate_gain_reduction_from_db(detector_level_db);
    );
    
    detector_level_block_max = update_block_max(detector_level, detector_level_block_max);

    // Skip envelope processing only when:
    // Case 1: Both target GR and current GR are 0 (or near 0) - already at rest
    // Case 2: Target GR is 0 AND we are within the release towards 0 (current GR near 0)
    // 
    // Do NOT skip when actively releasing (target GR = 0 but current GR > threshold)
    // This ensures smooth release transitions without clicks
    // 
    // The condition checks: target is 0 AND current is near 0
    // This covers both cases: both at rest, or releasing and near 0
    can_skip_envelope = (
      abs(target_gr_db) < 0.01 &&
      abs(global_smoothed_gain_db) < 0.01
    );
    
    can_skip_envelope ? (
      global_smoothed_gain_db = 0;
      global_smoothed_gain_db_before_strength = 0;
    ) : (
      // curve_input_db = detector + input offset (same abscissa as curve / graph); input-dependent thresholds align with UI
      process_envelope_following(target_gr_db, curve_input_db);
    );
    
    // Update previous detector level for rate-of-change release mode (same space as curve_input_db)
    prev_detector_db = curve_input_db;
    
    current_gr_db = max(-MAX_GR_DB, min(MAX_GR_DB, global_smoothed_gain_db));
    abs(current_gr_db) > abs(gr_db_block_max) ? (
      gr_db_block_max = current_gr_db;
    );
    
    // Track smoothed pre-strength GR for visualization (ghost line)
    // This represents the "true" GR used in calculations before strength multiplier
    current_gr_db_before_strength = global_smoothed_gain_db_before_strength;

    lookahead_ms > 0 ? (
      process_lookahead_audio(proc_l, proc_r);
      audio_to_compress_l = lookahead_out_l;
      audio_to_compress_r = lookahead_out_r;
    ) : (
      audio_to_compress_l = proc_l;
      audio_to_compress_r = proc_r;
    );

    abs(current_gr_db) < 0.000001 ? (
      processed_l = audio_to_compress_l;
      processed_r = audio_to_compress_r;
    ) : (
      gain_reduction_linear = db_to_linear(current_gr_db);
      processed_l = audio_to_compress_l * gain_reduction_linear;
      processed_r = audio_to_compress_r * gain_reduction_linear;
    );

    harmonic_mix > 0.0001 && abs(target_gr_db) > 0.0001 ? (
      harmonic_envelope_amount = abs(global_smoothed_gain_db) / 30.0;
      harmonic_abs_gr = abs(target_gr_db);
      harmonic_envelope_factor = 1 + harmonic_envelope_amount * 0.2;
      harmonic_combined_factor = harmonic_abs_gr * 0.3 * harmonic_envelope_factor;
      harmonic_intensity = harmonic_abs_gr * 0.15 * (1 + harmonic_envelope_amount * 0.2);
      
      processed_l = apply_harmonic_processing(processed_l, target_gr_db, harmonic_envelope_amount, detector_level,
                                             harmonic_type, harmonic_drive, harmonic_mix, 
                                             harmonic_even_boost, harmonic_odd_boost);
      processed_r = apply_harmonic_processing(processed_r, target_gr_db, harmonic_envelope_amount, detector_level,
                                             harmonic_type, harmonic_drive, harmonic_mix, 
                                             harmonic_even_boost, harmonic_odd_boost);
    );

    final_l = processed_l * makeup_gain_linear;
    final_r = processed_r * makeup_gain_linear;

    brickwall_limiter > 0.5 ? (
      abs_final_l = abs(final_l);
      abs_final_r = abs(final_r);
      (abs_final_l > 0.944 || abs_final_r > 0.944) ? (
        final_l = soft_clip_limiter(final_l, limiter_prev_l);
        final_r = soft_clip_limiter(final_r, limiter_prev_r);
      );
      limiter_prev_l = final_l;
      limiter_prev_r = final_r;
    );

    mid_side_mode > 0.5 && has_stereo ? (
      prog_spl0 = final_l + final_r;
      prog_spl1 = final_l - final_r;
    ) : (
      prog_spl0 = final_l;
      prog_spl1 = final_r;
    );

    debug_profiling_enabled > 0.5 ? (
      debug_counter_samples += 1;
      debug_counter_samples >= debug_counter_reset_interval ? (
        debug_display_audio_chain = debug_counter_audio_chain;
        debug_display_gain_reduction = debug_counter_gain_reduction;
        debug_display_envelope = debug_counter_envelope;
        debug_display_min_envelope = debug_counter_min_envelope;
        debug_display_lookahead = debug_counter_lookahead;
        debug_display_harmonics = debug_counter_harmonics;
        debug_display_limiter = debug_counter_limiter;
        debug_display_curve_interp = debug_counter_curve_interp;
        debug_display_lut_lookup = debug_counter_lut_lookup;
        debug_display_db_to_linear = debug_counter_db_to_linear;
        debug_display_linear_to_db = debug_counter_linear_to_db;
        debug_display_clamp = debug_counter_clamp;
        debug_display_prog_release = debug_counter_prog_release;
        debug_display_single_envelope = debug_counter_single_envelope;
        debug_display_ui_curves = debug_counter_ui_curves;
        debug_display_ui_histogram = debug_counter_ui_histogram;
        debug_display_graph_bg = debug_counter_graph_bg;
        debug_display_grid = debug_counter_grid;
        
        debug_counter_audio_chain = 0;
        debug_counter_gain_reduction = 0;
        debug_counter_envelope = 0;
        debug_counter_min_envelope = 0;
        debug_counter_lookahead = 0;
        debug_counter_harmonics = 0;
        debug_counter_limiter = 0;
        debug_counter_curve_interp = 0;
        debug_counter_lut_lookup = 0;
        debug_counter_db_to_linear = 0;
        debug_counter_linear_to_db = 0;
        debug_counter_clamp = 0;
        debug_counter_prog_release = 0;
        debug_counter_single_envelope = 0;
        debug_counter_ui_curves = 0;
        debug_counter_ui_histogram = 0;
        debug_counter_graph_bg = 0;
        debug_counter_grid = 0;
        debug_counter_samples = 0;
      );
    );
  ) : (
    gr_db_block_max = 0;
  );

  lf > 0.999 ? (
    spl0 = detect_l;
    has_stereo ? spl1 = detect_r;
    detector_level = calculate_peak_level(detect_l, detect_r);
    detector_level = min(detector_level, MAX_DETECTOR_LINEAR);
    detector_level_block_max = update_block_max(detector_level, detector_level_block_max);
    gr_db_block_max = 0;
  ) : lf < 0.001 ? (
    spl0 = prog_spl0;
    spl1 = prog_spl1;
  ) : (
    listen_crossfade_omn = 1 - lf;
    spl0 = prog_spl0 * listen_crossfade_omn + detect_l * lf;
    spl1 = prog_spl1 * listen_crossfade_omn + detect_r * lf;
  );

  final_l_prev = spl0;
  final_r_prev = spl1;
);
