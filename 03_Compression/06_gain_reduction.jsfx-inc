// Gain Reduction Calculation Module
// Calculates gain reduction based on compression curve and input level

@init

//==============================================================================
// GAIN REDUCTION CALCULATION HELPERS
//==============================================================================

// Calculate GR from canonical curve-space abscissa (detector dB + input offset)
function calculate_gr_from_curve(curve_input_db) local(target_output_db, target_gr_db) (
  target_output_db = lookup_compression_lut(curve_input_db);
  target_gr_db = target_output_db - curve_input_db;
  target_gr_db
);

//==============================================================================
// MAIN GAIN REDUCTION CALCULATION
//==============================================================================

// Accepts dB directly (avoids redundant conversion).
// Below comp_curve_min_threshold_db the built LUT is unity (within scan tolerance), so GR=0
// avoids redundant LUT work and matches the identity band. Threshold is derived from the LUT
// grid in calculate_compression_threshold() (not control knots), so it stays aligned with Bezier audio.
function calculate_gain_reduction_from_db(input_level_db) local(curve_input_db) (
  debug_profiling_enabled > 0.5 ? debug_counter_gain_reduction += 1;
  curve_input_db = clamp(input_level_db + input_offset_db, MIN_DETECTOR_DB_FLOOR, MAX_CURVE_INPUT_DB);
  
  curve_input_db < comp_curve_min_threshold_db ? (
    gr_processing_skipped = 1;
    target_gr_db_before_strength = 0;
    0
  ) : (
    gr_processing_skipped = 0;
    target_gr_db_before_strength = calculate_gr_from_curve(curve_input_db);
    target_gr_db = target_gr_db_before_strength * strength_multiplier;
    target_gr_db = max(-MAX_GR_DB, min(MAX_GR_DB, target_gr_db));
    target_gr_db
  )
);


