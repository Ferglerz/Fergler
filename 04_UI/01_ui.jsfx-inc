// Surround FFT Flattener - Minimal UI (bars follow current FFT size)

@init

function sff_ui_draw() local(i, j, x0, y0, w, h, v, db, y, y_base, avail_w, draw_bins, bin_w, x_offset, bins_per_group, start_idx, end_idx, mag_sum_lin, mag_count, mag_avg_db, gain_sum, gain_count, gain_avg_db) (
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);

  x0 = 10; y0 = 10;
  w = gfx_w - 20;
  h = gfx_h - 20;

  // Frame
  gfx_set(0.22, 0.22, 0.24, 1);
  gfx_rect(x0, y0, w, h);

  // Bars area
  gfx_set(0.12, 0.12, 0.13, 1);
  gfx_rect(x0+2, y0+2, w-4, h-4);

  // Always use full available width, grouping bins as needed
  avail_w = max(w-4, 1);
  draw_bins = avail_w;  // Always use full width
  bin_w = 1;  // Each bar is 1px wide
  bins_per_group = sff_display_bin_count / max(draw_bins, 1);
  x_offset = 0;  // No offset needed, using exact width
  y_base = y0 + h - 4;

  // Draw magnitude bars (averaged from grouped bins)
  i = 0;
  loop(draw_bins,
    start_idx = (i * bins_per_group)|0;
    end_idx = ((i + 1) * bins_per_group)|0;
    end_idx = min(end_idx, sff_display_bin_count);
    mag_sum_lin = 0;
    mag_count = end_idx - start_idx;
    mag_count > 0 ? (
      j = 0;
      loop(mag_count,
        mag_sum_lin += sff_db_to_linear(sff_display_mag_db[start_idx + j]);
        j += 1;
      );
      mag_avg_db = sff_linear_to_db(mag_sum_lin / (mag_count + eps));
    ) : (
      mag_avg_db = -120;
    );
    
    // Map -120..0 dB to 0..1
    v = sff_clamp((mag_avg_db + 120) / 120, 0, 1);
    y = v * (h-8);

    gfx_set(0.25, 0.55, 0.95, 1);
    gfx_rect(x0 + 2 + x_offset + i*bin_w, y_base - y, bin_w, y);

    i += 1;
  );

  // Minimal overlay: applied gain (dB) as a thin yellow line (averaged from grouped bins)
  gfx_set(0.95, 0.85, 0.20, 1);
  i = 0;
  loop(draw_bins,
    start_idx = (i * bins_per_group)|0;
    end_idx = ((i + 1) * bins_per_group)|0;
    end_idx = min(end_idx, sff_display_bin_count);
    gain_sum = 0;
    gain_count = end_idx - start_idx;
    gain_count > 0 ? (
      j = 0;
      loop(gain_count,
        gain_sum += sff_display_gain_db[start_idx + j];
        j += 1;
      );
      gain_avg_db = gain_sum / (gain_count + eps);
    ) : (
      gain_avg_db = 0;
    );
    
    // Map -max_adjust_db..+max_adjust_db into 0..1 of the graph height
    v = sff_clamp((gain_avg_db + max_adjust_db) / (2*max_adjust_db + eps), 0, 1);
    y = v * (h-8);
    x1 = x0 + 2 + x_offset + i*bin_w;
    x2 = x0 + 2 + x_offset + (i+1)*bin_w;
    gfx_line(x1, y_base - y, x2, y_base - y, 1);
    i += 1;
  );

);

