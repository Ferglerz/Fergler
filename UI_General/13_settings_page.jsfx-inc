// Settings Page Module
// Settings page with menu items converted to custom buttons
// Dependencies: UI_General/00_ui_constants.jsfx-inc, UI_General/01_drawing_primitives.jsfx-inc, UI_General/12_page_buttons.jsfx-inc

@init

//==============================================================================
// SETTINGS BUTTON DEFINITIONS
//==============================================================================

// Number of settings buttons (menu items)
NUM_SETTINGS_BUTTONS = 1;  // 1 button: Brickwall Limiter (Debug moved to top-left invisible button)

// Button definitions (reordered)
// Button 0: Brickwall Limiter (Row 0, centered full width)
// Debug button moved to top-left invisible button (handled separately)
// Feedforward/Feedback and Milliseconds/Microseconds are rendered by control system (controls 23-26)
// Metering moved to small button below meter
// Use Sidechain moved to Input page
// Preview Filters moved to Input page

// Button dimensions (matching Input page layout)
// Calculate directly to avoid dependency on control_layout.jsfx-inc execution order
// FILTER_HP_LP_SLIDER_W = (SLIDER_W * 2) / 2 - 5 = SLIDER_W - 5
SETTINGS_BUTTON_W = SLIDER_W - 5;  // Same as HP/LP sliders
SETTINGS_BUTTON_H = BUTTON_H;
SETTINGS_BUTTON_GAP = 10;  // 10px gap (same as HP/LP)
// FILTER_SLIDER_SPACING = FILTER_SLIDER_H + 24, where FILTER_SLIDER_H = SLIDER_H * 2
SETTINGS_ROW_SPACING = (SLIDER_H * 2) + 24;  // Same row spacing as Input page

// Button positions (will be calculated in @gfx)
// Allocate arrays for button positions
settings_button_x_base = 0;  // Base address for settings_button_x array
settings_button_y_base = 0;  // Base address for settings_button_y array

// Button label strings (use string slots 64-67)
#settings_button_label_0 = 64;  // "Brickwall Limiter"

//==============================================================================
// STATE INITIALIZATION
//==============================================================================

function init_settings_page() (
  // Memory allocation is done in allocate_memory() - just initialize values here
  // Initialize button labels
  strcpy(#settings_button_label_0, "Brickwall Limiter");
);

//==============================================================================
// BUTTON POSITIONING
//==============================================================================

// Calculate settings button positions (arranged in rows like Input page)
function update_settings_button_positions() local(area_center_x, two_button_total_width, two_button_start_x, row_y, full_width_start_x) (
  // Center horizontally in graph/meter area
  // Graph area: GRAPH_X to GRAPH_X + GRAPH_SIZE
  // Meter area: extends to meter_x + meter_w
  meter_x = get_meter_x();
  meter_w = get_meter_w();
  area_right = meter_x + meter_w;
  area_center_x = (GRAPH_X + area_right) / 2;
  
  // Start at same Y as Input page
  row_y = GRAPH_Y + 10;
  
  // ============================================================================
  // ROW 0: Brickwall Limiter (centered, full width like Input Offset)
  // ============================================================================
  // FILTER_SLIDER_W = SLIDER_W * 2 (from control_layout.jsfx-inc)
  full_width_start_x = area_center_x - (SLIDER_W * 2) / 2;
  settings_button_x_base[0] = full_width_start_x;
  settings_button_y_base[0] = row_y;
);

//==============================================================================
// BUTTON RENDERING
//==============================================================================

// Draw a settings button
// Parameters:
//   button_index: Button index (0-5)
//   x, y: Position
//   w, h: Dimensions
//   is_enabled: 1 = enabled/on, 0 = disabled/off
//   label: Button label text
function draw_settings_button(button_index, x, y, w, h, is_enabled, label) local() (
  draw_button_background(x, y, w, h, is_enabled);
  draw_button_border(x, y, w, h);
  draw_button_text(x, y, label);
  
  // Draw checkmark if enabled
  is_enabled ? (
    gfx_set(button_style_on_r, button_style_on_g, button_style_on_b, 1);
    gfx_x = x + w - 15;
    gfx_y = y + 8;
    gfx_drawstr("v");  // Checkmark
  );
);

// Render settings page
function render_settings_page() (
  // Only render if Settings page should be visible
  should_render_page(PAGE_SETTINGS) ? (
    // Get page opacity for fade transitions
    page_opacity = get_page_fade_amount(PAGE_SETTINGS);
    page_opacity > 0.01 ? (
      // Update positions
      gfx_w > 0 ? (
        update_settings_button_positions();
        
        // Apply opacity
        gfx_a = page_opacity;
        
        // Draw all settings buttons
        i = 0;
        while (i < NUM_SETTINGS_BUTTONS) (
          // Get button state (using sliders for Brickwall Limiter)
          is_enabled = (i == 0 && slider(26) > 0.5);  // Brickwall Limiter (slider26)
          
          // Get label string slot based on button index
          i == 0 ? label_slot = #settings_button_label_0 : 0;
          
          // Button width: full width for all buttons (centered, full width like Input Offset)
          // FILTER_SLIDER_W = SLIDER_W * 2 (from control_layout.jsfx-inc)
          button_w = SLIDER_W * 2;
          
          // Draw button
          draw_settings_button(i, settings_button_x_base[i], settings_button_y_base[i], 
                              button_w, SETTINGS_BUTTON_H, 
                              is_enabled, label_slot);
          i += 1;
        );
        
        // Reset opacity
        gfx_a = 1.0;
      );
    );
  );
);

//==============================================================================
// BUTTON INTERACTION
//==============================================================================

// Check if point is inside a settings button
function is_point_in_settings_button(x, y, button_index) local(button_w) (
  settings_button_x_base[button_index] >= 0 && settings_button_y_base[button_index] >= 0 ? (
    // Button width: full width for all buttons (centered, full width like Input Offset)
    // FILTER_SLIDER_W = SLIDER_W * 2 (from control_layout.jsfx-inc)
    button_w = SLIDER_W * 2;
    x >= settings_button_x_base[button_index] && x <= settings_button_x_base[button_index] + button_w &&
    y >= settings_button_y_base[button_index] && y <= settings_button_y_base[button_index] + SETTINGS_BUTTON_H;
  ) : (
    0;
  );
);

// Handle click on a settings button
// Parameters:
//   button_index: Button index that was clicked (0)
function handle_settings_button_click(button_index) (
  button_index == 0 ? (
    // Toggle brickwall limiter (slider26)
    slider(26) = slider(26) > 0.5 ? 0 : 1;
    brickwall_limiter = slider(26);
    sliderchange(1 << (26 - 1));
  );
);

// Process mouse input for settings buttons
// Returns: 1 if a settings button was clicked, 0 otherwise
// Note: Only processes if Settings page is visible (skip click detection for invisible UI as requested)
function process_settings_button_input() local(clicked, i) (
  clicked = 0;
  // Only process if Settings page should be visible
  should_render_page(PAGE_SETTINGS) ? (
    gfx_w > 0 ? (
      update_settings_button_positions();
      
      MOUSE_LEFT_BUTTON && !settings_mouse_down ? (
        settings_mouse_down = 1;
        
        // Check each button
        i = 0;
        while (i < NUM_SETTINGS_BUTTONS && !clicked) (
          is_point_in_settings_button(mouse_x, mouse_y, i) ? (
            handle_settings_button_click(i);
            clicked = 1;
          );
          i += 1;
        );
      ) : !MOUSE_LEFT_BUTTON ? (
        settings_mouse_down = 0;
      );
    );
  );
  clicked;
);

// Settings button mouse state
settings_mouse_down = 0;

