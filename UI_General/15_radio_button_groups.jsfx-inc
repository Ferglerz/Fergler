// Radio Button Groups Module
// Generic radio button group management for DRY principle
// Dependencies: UI_Sliders/02_control_definitions.jsfx-inc (for control_defs access)

@init

//==============================================================================
// RADIO BUTTON GROUP HELPERS
//==============================================================================

// Handle radio button click - sets the slider value for the clicked button
// Note: Other buttons in the group automatically become inactive because
// their rendering checks if current_value == min_val, and since we set
// the slider to target_value, only the matching button will be active
// Parameters:
//   clicked_control_index: Control index that was clicked
//   param_index: Slider parameter index that all buttons in group control
//   target_value: Value to set for the clicked button
function handle_radio_button_click(clicked_control_index, param_index, target_value) (
  // Set the slider value for the clicked button
  slider(param_index) = target_value;
  sliderchange(1 << (param_index - 1));
);

// Check if a control is part of a radio button group
// Parameters:
//   control_index: Control index to check
// Returns: 1 if it's a radio button (min == max), 0 otherwise
function is_radio_button(control_index) local(min_val, max_val) (
  min_val = control_defs[control_index*11 + 6];
  max_val = control_defs[control_index*11 + 7];
  min_val == max_val;
);

// Get the target value for a radio button
// Parameters:
//   control_index: Control index
// Returns: The target value (min_val, which equals max_val for radio buttons)
function get_radio_button_target_value(control_index) local(min_val) (
  min_val = control_defs[control_index*11 + 6];
  min_val;  // For radio buttons, min == max, so return min
);

