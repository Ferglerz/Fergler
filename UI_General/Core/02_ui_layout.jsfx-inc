// UI Layout Constants Module (Part 3 of UI Constants)
// Display constants, histogram configuration, control dimensions, spacing, and slider properties
// Dependencies: UI_General/00_ui_constants.jsfx-inc (for layout positioning constants)

@init

// === UI DISPLAY CONSTANTS ===

MAX_GR_DISPLAY_DB = 40; // Gain reduction meter range

// === DISPLAY MODE CONSTANTS ===
DISPLAY_NORMAL = 0;        // Normal display (value shown with optional suffix)
DISPLAY_HIDE_VALUE = 2;    // Hide value display (e.g., Attack Curve)

// === DRAG MODE CONSTANTS ===
DRAG_MODE_HORIZONTAL = 0;
DRAG_MODE_VERTICAL = 1;
DRAG_MODE_BIDIRECTIONAL = 2;

// === HISTOGRAM CONFIGURATION ===
HISTOGRAM_ENABLED = 1; // Set to 0 to disable histogram completely
HISTOGRAM_WINDOW_SECONDS = 3; // 3-second window for history
HISTOGRAM_MAX_HEIGHT = 15; // 20 * 0.75 = 15 (maximum height in pixels for histogram bars)
HISTOGRAM_OPACITY = 0.6; // 60% opacity for histogram visualization
HISTOGRAM_UPDATE_RATE = 1; // Update every N frames (1 = every frame, 2 = every other frame, etc.)
HISTOGRAM_SMOOTHING = 1; // Enable smoothing to reduce flickering (1 = on, 0 = off)

// === INPUT HISTOGRAM CONFIGURATION ===
INPUT_HISTOGRAM_ENABLED = 1; // Set to 0 to disable input histogram completely
INPUT_HISTOGRAM_OPACITY = 0.25; // 25% opacity for input histogram visualization (white)
INPUT_HISTOGRAM_COLOR_R = 1.0; // White color for input signal
INPUT_HISTOGRAM_COLOR_G = 1.0;
INPUT_HISTOGRAM_COLOR_B = 1.0;

// === GRAPH CURVE CONFIGURATION ===
BEZIER_STEPS = 20; // Number of line segments to approximate Bezier curves

// Control Dimensions (75% of original)
SLIDER_W = 123;  // 101 + 22 (increased by 22 pixels)
SLIDER_H = 15;   // 20 * 0.75
SLIDER_W_VERTICAL = 15;  // 20 * 0.75
SLIDER_H_VERTICAL = 101; // 135 * 0.75 = 101.25 rounded down
BUTTON_W = 60;   // 80 * 0.75
BUTTON_H = 27;   // Increased from 19 to add more padding (8px top + ~11px text + 8px bottom)
DROPDOWN_W = 90; // 120 * 0.75
DROPDOWN_H = 19; // 25 * 0.75 = 18.75 rounded up

// Spacing (75% of original)
CONTROL_SPACING_Y = 44;  // Reduced by 4px from 48 for tighter spacing
CONTROL_SPACING_X = 135; // 180 * 0.75
LABEL_HEIGHT = 11;       // 15 * 0.75 = 11.25 rounded down

//==============================================================================
// SLIDER PROPERTIES SYSTEM
//==============================================================================

// Slider fill directions
FILL_LEFT_TO_RIGHT = 0;    // Normal: fill from left to fader
FILL_RIGHT_TO_LEFT = 1;    // Reverse: fill from right to fader  
FILL_CENTER_OUT = 2;       // Centered: fill from middle to fader (both directions)

// Slider property structure (per control):
// [0] = increment (0 = no rounding, > 0 = round to this increment)
// [1] = fill_direction (0=left-to-right, 1=right-to-left, 2=center-out)
// [2] = format_as_frequency (0=no, 1=yes - shows "k" suffix if > 999)
// [3] = reserved for future use

//==============================================================================
// SLIDER CONFIGURATION SYSTEM - EXPLICIT EXCLUSIVE PARAMETERS
//==============================================================================

// Slider orientation - EXCLUSIVE (only one can be active)
ORIENTATION_HORIZONTAL = 0;    // Standard horizontal slider
ORIENTATION_VERTICAL = 1;      // Vertical slider

// Slider formatting - EXCLUSIVE (only one can be active)
FORMAT_NORMAL = 0;             // Standard numeric formatting
FORMAT_K = 1;                 // K suffix formatting (2.1k style)
FORMAT_NONE = 2;              // No formatting (use display mode only)

// Additional format options (can be combined with formatting)
OPTION_ROUNDED = 0x01;         // Bit 0: Apply rounding to any format
OPTION_AUTO_STEP = 0x02;       // Bit 1: Auto-step for enumerated options
OPTION_BIDIRECTIONAL = 0x04;   // Bit 2: Enable bidirectional drag (up/down and left/right)
OPTION_REVERSE = 0x08;         // Bit 3: Reverse the slider direction/fill
OPTION_HIDE_LABEL = 0x10;     // Bit 4: Hide the slider label/title

// NOTE: create_ui_control() is now defined in UI_Sliders/01_slider_constants.jsfx-inc
// with 7 parameters (adds suffix_str and control_index for suffix string storage)
// This allows suffix strings to be stored per-control in string slots (61+)
