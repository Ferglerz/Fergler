@init

// Dependencies:
//   - ../FerglerUI/Core/09_layout_utils.jsfx-inc (for layout utility functions)
//   - ../FerglerUI/Core/01_slider_constants.jsfx-inc (for OPTION_HIDE_LABEL)

#forward_button_label = 90;
#feedback_button_label = 91;

function init_radio_button_labels() (
  strcpy(#feedback_button_label, get_dropdown_option(12, 0));
  strcpy(#forward_button_label, get_dropdown_option(12, 1));
);

function setup_control_layout() local(group_x, group_y, rel_x, rel_y, group_w, group_h, group_spacing, rel_x_slider, rel_x_button, rel_x_dropdown, groups_start_x, groups_end_x, total_width, group_width, current_y, control_h, control_spacing) (
  init_radio_button_labels();
  group_y = UI_PANEL_Y + 15;
  group_spacing = 15;
  group_h = GRAPH_SIZE;
  group_w = 260; // Fixed width for paged groups
  group_x = GRAPH_X - group_w - 20; // 20px gap from graph

  // --- GROUP 3: ENVELOPE (Left Panel) ---
  define_group(3, UI_PANEL_X, group_y - 26, group_w, group_h, 1, "ENVELOPE");
  set_control_group(3);
  env_current_y = rel_y;
  
  // Columns for Attack and Release
  ENV_COL_W = (group_w - 20) / 2;
  ENV_CENTER_LEFT = UI_PANEL_X + 10 + ENV_COL_W/2;
  ENV_CENTER_RIGHT = UI_PANEL_X + 10 + ENV_COL_W + ENV_COL_W/2;
  
  // Attack Time (Knob 0) & Release Time (Knob 2)
  KNOB_SIZE = ENV_COL_W * 0.8;
  define_knob(0, ENV_CENTER_LEFT - KNOB_SIZE/2, env_current_y, KNOB_SIZE, KNOB_SIZE, 1, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 0), 11, 163, 163, 0, 0, 0.49, 24);
  define_knob(2, ENV_CENTER_RIGHT - KNOB_SIZE/2, env_current_y, KNOB_SIZE, KNOB_SIZE, 3, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 2), 11, 163, 163, 0, 0, 0.49, 24);
  
  env_current_y += KNOB_SIZE + 15;
  
  // Attack Curve (Slider 1) & Release Curve (Slider 3) - Bidirectional Sliders
  CURVE_SLIDER_W = ENV_COL_W - 10;
  // Attack Curve
  define_slider(1, ENV_CENTER_LEFT - CURVE_SLIDER_W/2, env_current_y, CURVE_SLIDER_W, SLIDER_H, 2, 
    create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_CENTER_OUT, FORMAT_NORMAL, OPTION_BIDIRECTIONAL, "", 1)
  );
  // Release Curve
  define_slider(3, ENV_CENTER_RIGHT - CURVE_SLIDER_W/2, env_current_y, CURVE_SLIDER_W, SLIDER_H, 4, 
    create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_CENTER_OUT, FORMAT_NORMAL, OPTION_BIDIRECTIONAL, "", 3)
  );
  

  // --- GROUP 0: INPUT (Page 1) ---
  define_group(0, group_x, group_y - 26, group_w, group_h, 1, "INPUT");
  set_control_group(0);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 5;
  current_y = rel_y;
  
  // Filters (copied from later in file)
  FILTER_SLIDER_W = group_w - 20;
  FILTER_SLIDER_H = SLIDER_H;
  FILTER_SLIDER_SPACING = FILTER_SLIDER_H + 20;
  REL_X_FULL = center_in_group_x(group_w, FILTER_SLIDER_W);
  
  FILTER_HP_LP_W = (FILTER_SLIDER_W / 2) - 5;
  define_slider(16, REL_X_FULL, current_y, FILTER_HP_LP_W, FILTER_SLIDER_H, 13, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_K, 0, " Hz", 16));
  define_slider(17, REL_X_FULL + FILTER_HP_LP_W + 10, current_y, FILTER_HP_LP_W, FILTER_SLIDER_H, 14, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_RIGHT_TO_LEFT, FORMAT_K, 0, " Hz", 17));
  current_y += FILTER_SLIDER_SPACING;

  // Listen / Auto-preview / Use Sidechain row
  BTN_GAP = 5;
  BTN_W = (FILTER_SLIDER_W - BTN_GAP * 2) / 3;
  define_button(18, REL_X_FULL, current_y, BTN_W, BUTTON_H, 12);
  // Slot for auto-preview (rendered separately in 02_input_page.jsfx-inc)
  define_button(19, REL_X_FULL + (BTN_W + BTN_GAP) * 2, current_y, BTN_W, BUTTON_H, 11);
  current_y += BUTTON_H + 20;

  define_slider(20, REL_X_FULL, current_y, FILTER_HP_LP_W, FILTER_SLIDER_H, 7, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 20));
  define_button(21, REL_X_FULL + FILTER_HP_LP_W + 10, current_y, FILTER_HP_LP_W, BUTTON_H, 8);
  current_y += FILTER_SLIDER_SPACING;

  // Lookahead & Input Offset side-by-side
  define_slider(22, REL_X_FULL, current_y, FILTER_HP_LP_W, FILTER_SLIDER_H, 10, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 22));
  define_slider(23, REL_X_FULL + FILTER_HP_LP_W + 10, current_y, FILTER_HP_LP_W, FILTER_SLIDER_H, 15, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " dB", 23));
  current_y += FILTER_SLIDER_SPACING;

  // Attack / Release Knobs moved to Group 3

  // --- GROUP 1: SETTINGS (Page 2) ---
  define_group(1, group_x, group_y - 26, group_w, group_h, 1, "SETTINGS");
  set_control_group(1);
  current_y = rel_y;
  
  KNOB_W = group_w * 0.4;
  define_knob(4, center_in_group_x(group_w, KNOB_W), current_y, KNOB_W, KNOB_W, 6, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NONE, 0, " %", 4), 11, 163, 163, 0, 0, 0.49075, 24);
  current_y += KNOB_W + 10;
  define_knob(5, center_in_group_x(group_w, KNOB_W), current_y, KNOB_W, KNOB_W, 5, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 5), 11, 163, 163, 0, 0, 0.49075, 24);
  current_y += KNOB_W + 10;

  // Detection Mode Image Buttons
  IMG_W = 100; IMG_H = 75;
  IMG_X = (group_w - IMG_W * 2 - 10) / 2;
  define_image_button(24, IMG_X, current_y, IMG_W, IMG_H, 9, 7, 8, 1);
  ui_set_label(24, #feedback_button_label);
  ui_set_range(24, 1, 1); // Radio Button: Feedforward (Value 1)
  
  define_image_button(25, IMG_X + IMG_W + 10, current_y, IMG_W, IMG_H, 9, 9, 10, 1);
  ui_set_label(25, #forward_button_label);
  ui_set_range(25, 0, 0); // Radio Button: Feedback (Value 0)
  current_y += IMG_H + 15;

  // Program Release Mode
  RADIO_W = (group_w - 30) / 2;
  REL_X_RADIO = center_in_group_x(group_w, RADIO_W * 2 + 10);
  define_button(6, REL_X_RADIO, current_y, RADIO_W, BUTTON_H, 22);
  ui_set_label(6, "Input Dep");
  ui_set_range(6, 0, 0); // Radio Button: Input Dependent (Value 0)
  
  define_button(7, REL_X_RADIO + RADIO_W + 10, current_y, RADIO_W, BUTTON_H, 22);
  ui_set_label(7, "GR Dep");
  ui_set_range(7, 1, 1); // Radio Button: GR Dependent (Value 1)
  current_y += BUTTON_H + 15;

  define_button(8, center_in_group_x(group_w, 100), current_y, 100, BUTTON_H, 23);
  ui_set_label(8, get_slider_name(23));
  current_y += BUTTON_H + 15;
  
  define_slider(9, center_in_group_x(group_w, 150), current_y, 150, SLIDER_H, 24, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NONE, 0, " %", 9));
  current_y += SLIDER_H + 24;

  // Brickwall Limiter & Linear Modes (newly added to group)
  define_button(30, REL_X_FULL, current_y, FILTER_SLIDER_W, BUTTON_H, 25);
  ui_set_label(30, "Brickwall Limiter");
  current_y += BUTTON_H + 10;
  define_button(31, REL_X_FULL, current_y, FILTER_SLIDER_W, BUTTON_H, 28);
  ui_set_label(31, "Linear Prog Release");


  group_x = GRAPH_X + GRAPH_SIZE + 15 + 23 + 8 + 6 + 15 + 16;
  group_w = 150;
  group_h = GRAPH_SIZE;
  define_group(2, group_x, group_y - 26, group_w, group_h, 1, "HARMONICS");
  set_control_group(2);
  rel_x_slider = center_in_group_x(group_w, SLIDER_W);
  rel_x_dropdown = center_in_group_x(group_w, DROPDOWN_W);
  TOGGLE_BUTTON_W = 84;  // Toggle button image width
  TOGGLE_BUTTON_H = 56;  // Toggle button image height
  rel_x_button = center_in_group_x(group_w, TOGGLE_BUTTON_W);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  harmonic_type_y = current_y;
  define_image_button(10, rel_x_button, harmonic_type_y, TOGGLE_BUTTON_W, TOGGLE_BUTTON_H, 16, 1, 2, 1);
  ui_set_label(10, get_slider_name(16));
  current_y = advance_group_row_y(harmonic_type_y, TOGGLE_BUTTON_H, 0);
  control_h = SLIDER_H;
  define_parallax_fader(11, rel_x_slider, current_y, SLIDER_W, control_h, 17, 3, 4, 36, 45, 4, 11, -2, 1.0, "", FORMAT_NORMAL, 0, DISPLAY_NORMAL);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(12, rel_x_slider, current_y, SLIDER_W, control_h, 18, 3, 5, 36, 45, 4, 11, 4, 1.0, " %", FORMAT_NONE, 0, DISPLAY_NORMAL);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(13, rel_x_slider, current_y, SLIDER_W, control_h, 19, 3, 4, 36, 45, 4, 11, -2, 1.0, " %", FORMAT_NONE, 0, DISPLAY_NORMAL);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(14, rel_x_slider, current_y, SLIDER_W, control_h, 20, 3, 5, 36, 45, 4, 11, 4, 1.0, " %", FORMAT_NONE, 0, DISPLAY_NORMAL);
  current_y = advance_group_row_y(current_y, control_h, 0);
  
  // Makeup knob: advance by its actual size (1.5x half-size knob = 0.75x full size)
  control_h = SLIDER_W * 0.75;
  makeup_knob_format_options = OPTION_BIDIRECTIONAL | OPTION_HIDE_LABEL;
  makeup_knob_y = current_y + get_label_hidden_row_start_offset(makeup_knob_format_options);
  makeup_knob_w = SLIDER_W * 0.75;
  makeup_knob_x = center_in_group_x(group_w, makeup_knob_w);
  define_knob(15, makeup_knob_x, makeup_knob_y, makeup_knob_w, SLIDER_H * 0.75, 21, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, makeup_knob_format_options, " dB", 15), 11, 163, 163, 0, 0, 0.566, 24);

  // Groups are now consolidated, removing legacy definitions
);

