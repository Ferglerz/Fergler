@init

// Dependencies:
//   - ../FerglerUI/Core/09_layout_utils.jsfx-inc (for layout utility functions)
//   - ../FerglerUI/Core/01_slider_constants.jsfx-inc (for OPTION_HIDE_LABEL)

#forward_button_label = 90;
#feedback_button_label = 91;

function init_radio_button_labels() (
  strcpy(#feedback_button_label, get_dropdown_option(12, 0));
  strcpy(#forward_button_label, get_dropdown_option(12, 1));
);

function setup_control_layout() local(group_x, group_y, rel_x, rel_y, group_w, group_h, group_spacing, rel_x_slider, rel_x_button, rel_x_dropdown, groups_start_x, groups_end_x, total_width, group_width, current_y, control_h, control_spacing) (
  init_radio_button_labels();
  group_y = UI_PANEL_Y + 15;
  group_spacing = 15;
  group_h = GRAPH_SIZE;
  groups_start_x = UI_PANEL_X + 15;
  groups_end_x = GRAPH_X - 40;
  total_width = groups_end_x - groups_start_x;
  group_width = (total_width - (2 * group_spacing)) / 3;

  group_x = groups_start_x;
  group_w = group_width;
  define_group(4, group_x, group_y - 26, group_w, group_h, 0, "ENVELOPE");
  set_control_group(4);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  control_h = SLIDER_W * 1.0;
  attack_knob_format_options = OPTION_HIDE_LABEL;
  attack_knob_y = current_y + get_label_hidden_row_start_offset(attack_knob_format_options);
  attack_knob_w = SLIDER_W * 1.0;
  attack_knob_x = center_in_group_x(group_w, attack_knob_w);
  define_knob(0, attack_knob_x, attack_knob_y, attack_knob_w, SLIDER_H * 1.0, 1, S1.min, S1.max, S1.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, attack_knob_format_options, " dB/s", 0), 11, 163, 163, 0, 0, 0.755, 24);
  current_y = advance_group_row_y(attack_knob_y, control_h, 40);
  control_h = SLIDER_H;
  slider_w = SLIDER_W;
  slider_x = center_in_group_x(group_w, slider_w);
  define_parallax_fader(1, slider_x, current_y, slider_w, control_h, 2, S2.min, S2.max, S2.label, sm_fader_left.image_top_index, sm_fader_left.image_bot_index, sm_fader_left.image_w, sm_fader_left.image_h, sm_fader_left.para_depth - 3, sm_fader_left.y_offset, sm_fader_left.x_offset, sm_fader_left.image_scale, "", FORMAT_NORMAL, OPTION_HIDE_LABEL, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 40);
  control_h = SLIDER_H;
  slider_w = SLIDER_W;
  slider_x = center_in_group_x(group_w, slider_w);
  define_parallax_fader(4, slider_x, current_y, slider_w, control_h, 5, S5.min, S5.max, S5.label, sm_fader_left.image_top_index, sm_fader_left.image_bot_index, sm_fader_left.image_w, sm_fader_left.image_h, sm_fader_left.para_depth - 1, sm_fader_left.y_offset, sm_fader_left.x_offset, sm_fader_left.image_scale, "", FORMAT_NORMAL, OPTION_HIDE_LABEL, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 40);
  control_h = SLIDER_W * 1.0;
  release_knob_format_options = OPTION_HIDE_LABEL;
  release_knob_y = current_y + get_label_hidden_row_start_offset(release_knob_format_options);
  release_knob_w = SLIDER_W * 1.0;
  release_knob_x = center_in_group_x(group_w, release_knob_w);
  define_knob(3, release_knob_x, release_knob_y, release_knob_w, SLIDER_H * 1.0, 4, S4.min, S4.max, S4.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, release_knob_format_options, " dB/s", 3), 11, 163, 163, 0, 0, 0.755, 24);

  group_x = groups_start_x + group_width + group_spacing;
  group_w = group_width;
  define_group(0, group_x, group_y - 26, group_w, group_h, 0, "ENVELOPE");
  set_control_group(0);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  control_h = SLIDER_W * 0.65;
  strength_knob_format_options = 0;
  strength_knob_y = current_y + get_label_hidden_row_start_offset(strength_knob_format_options);
  strength_knob_w = SLIDER_W * 0.65;
  strength_knob_x = center_in_group_x(group_w, strength_knob_w);
  define_knob(11, strength_knob_x, strength_knob_y, strength_knob_w, SLIDER_H * 0.65, 9, S9.min, S9.max, S9.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NONE, strength_knob_format_options, " %", 11), 11, 163, 163, 0, 0, 0.49075, 24);
  current_y = advance_group_row_y(strength_knob_y, control_h, 0);
  control_h = SLIDER_W * 0.65;
  hold_knob_format_options = 0;
  hold_knob_y = current_y + get_label_hidden_row_start_offset(hold_knob_format_options);
  hold_knob_w = SLIDER_W * 0.65;
  hold_knob_x = center_in_group_x(group_w, hold_knob_w);
  define_knob(2, hold_knob_x, hold_knob_y, hold_knob_w, SLIDER_H * 0.65, 3, S3.min, S3.max, S3.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, hold_knob_format_options, " ms", 2), 11, 163, 163, 0, 0, 0.49075, 24);
  current_y = advance_group_row_y(hold_knob_y, control_h, 0);
  dropdown_w = DROPDOWN_W;
  rel_x_dropdown = center_in_group_x(group_w, dropdown_w);
  control_h = DROPDOWN_H;
  define_dropdown(5, rel_x_dropdown, current_y - 10, dropdown_w, control_h, 6, S6.min, S6.max, S6.label);
  current_y = advance_group_row_y(current_y, control_h, 0);
  TOGGLE_BUTTON_W = 84;
  TOGGLE_BUTTON_H = 56;
  rel_x_button = center_in_group_x(group_w, TOGGLE_BUTTON_W);
  prog_release_inverse_label_slot = S7.label;
  prog_release_inverse_y = current_y;
  define_image_button(28, rel_x_button, prog_release_inverse_y, TOGGLE_BUTTON_W, TOGGLE_BUTTON_H, 7, S7.min, S7.max, prog_release_inverse_label_slot, 1, 2, 1);
  current_y = advance_group_row_y(prog_release_inverse_y, TOGGLE_BUTTON_H, 0);
  control_h = SLIDER_W * 0.65;
  prog_release_blend_knob_format_options = 0;
  prog_release_blend_knob_y = current_y + get_label_hidden_row_start_offset(prog_release_blend_knob_format_options);
  prog_release_blend_knob_w = SLIDER_W * 0.65;
  prog_release_blend_knob_x = center_in_group_x(group_w, prog_release_blend_knob_w);
  define_knob(29, prog_release_blend_knob_x, prog_release_blend_knob_y, prog_release_blend_knob_w, SLIDER_H * 0.65, 8, S8.min, S8.max, S8.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NONE, prog_release_blend_knob_format_options, " %", 29), 11, 163, 163, 0, 0, 0.49075, 24);
  current_y = advance_group_row_y(prog_release_blend_knob_y, control_h, 0);

  group_x = GRAPH_X + GRAPH_SIZE + 15 + 23 + 8 + 6 + 15 + 16;
  group_w = 150;
  group_h = GRAPH_SIZE;
  define_group(3, group_x, group_y - 26, group_w, group_h, 1, "HARMONICS");
  set_control_group(3);
  rel_x_slider = center_in_group_x(group_w, SLIDER_W);
  rel_x_dropdown = center_in_group_x(group_w, DROPDOWN_W);
  TOGGLE_BUTTON_W = 84;  // Toggle button image width
  TOGGLE_BUTTON_H = 56;  // Toggle button image height
  rel_x_button = center_in_group_x(group_w, TOGGLE_BUTTON_W);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  harmonic_type_label_slot = S20.label;
  harmonic_type_y = current_y;
  define_image_button(17, rel_x_button, harmonic_type_y, TOGGLE_BUTTON_W, TOGGLE_BUTTON_H, 20, S20.min, S20.max, harmonic_type_label_slot, 1, 2, 1);
  current_y = advance_group_row_y(harmonic_type_y, TOGGLE_BUTTON_H, 0);
  control_h = SLIDER_H;
  define_parallax_fader(18, rel_x_slider, current_y, SLIDER_W, control_h, 21, S21.min, S21.max, S21.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth - 1, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, "", FORMAT_NORMAL, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(19, rel_x_slider, current_y, SLIDER_W, control_h, 22, S22.min, S22.max, S22.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth - 1, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, " %", FORMAT_NONE, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(20, rel_x_slider, current_y, SLIDER_W, control_h, 23, S23.min, S23.max, S23.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth - 1, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, " %", FORMAT_NONE, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(21, rel_x_slider, current_y, SLIDER_W, control_h, 24, S24.min, S24.max, S24.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth - 1, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, " %", FORMAT_NONE, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  
  // Makeup knob: advance by its actual size (1.5x half-size knob = 0.75x full size)
  control_h = SLIDER_W * 0.75;
  makeup_knob_format_options = OPTION_BIDIRECTIONAL | OPTION_HIDE_LABEL;
  makeup_knob_y = current_y + get_label_hidden_row_start_offset(makeup_knob_format_options);
  makeup_knob_w = SLIDER_W * 0.75;
  makeup_knob_x = center_in_group_x(group_w, makeup_knob_w);
  define_knob(22, makeup_knob_x, makeup_knob_y, makeup_knob_w, SLIDER_H * 0.75, 25, S25.min, S25.max, S25.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, makeup_knob_format_options, " dB", 22), 11, 163, 163, 0, 0, 0.566, 24);

  filters_area_x = GRAPH_X;
  filters_area_y = GRAPH_Y;
  filters_area_w = (GRAPH_X + GRAPH_SIZE + 15 + 23) - GRAPH_X;
  filters_area_h = GRAPH_SIZE;
  set_control_group(-1);
  FILTER_SLIDER_W = SLIDER_W * 2;
  FILTER_SLIDER_H = SLIDER_H * 2;
  FILTER_SLIDER_SPACING = FILTER_SLIDER_H + 24;
  filter_controls_center_x = filters_area_x + filters_area_w / 2;
  row_y = filters_area_y + 10;

  FILTER_HP_LP_SLIDER_W = (FILTER_SLIDER_W / 2) - 5;
  FILTER_HP_LP_GAP = 10;
  filter_hp_lp_total_width = FILTER_HP_LP_SLIDER_W * 2 + FILTER_HP_LP_GAP;
  filter_hp_lp_start_x = filter_controls_center_x - filter_hp_lp_total_width / 2;
  define_slider(15, filter_hp_lp_start_x, row_y, FILTER_HP_LP_SLIDER_W, FILTER_SLIDER_H, 16, S16.min, S16.max, S16.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_K, 0, " Hz", 15));
  define_slider(16, filter_hp_lp_start_x + FILTER_HP_LP_SLIDER_W + FILTER_HP_LP_GAP, row_y, FILTER_HP_LP_SLIDER_W, FILTER_SLIDER_H, 17, S17.min, S17.max, S17.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_RIGHT_TO_LEFT, FORMAT_K, 0, " Hz", 16));
  row_y += FILTER_SLIDER_SPACING;

  FILTER_THREE_BUTTON_W = 75;
  FILTER_THREE_BUTTON_GAP = 10;
  filter_three_button_total_width = FILTER_THREE_BUTTON_W * 3 + FILTER_THREE_BUTTON_GAP * 2;
  filter_three_button_start_x = filter_controls_center_x - filter_three_button_total_width / 2;
  define_button(9, filter_three_button_start_x, row_y, FILTER_THREE_BUTTON_W, BUTTON_H, 15, S15.min, S15.max, S15.label);
  define_button(27, filter_three_button_start_x + FILTER_THREE_BUTTON_W + FILTER_THREE_BUTTON_GAP + FILTER_THREE_BUTTON_W + FILTER_THREE_BUTTON_GAP, row_y, FILTER_THREE_BUTTON_W, BUTTON_H, 14, S14.min, S14.max, S14.label);
  row_y += FILTER_SLIDER_SPACING;

  define_slider(7, filter_hp_lp_start_x, row_y, FILTER_HP_LP_SLIDER_W, FILTER_SLIDER_H, 10, S10.min, S10.max, S10.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 7));
  define_button(8, filter_hp_lp_start_x + FILTER_HP_LP_SLIDER_W + FILTER_HP_LP_GAP, row_y, FILTER_HP_LP_SLIDER_W, BUTTON_H, 11, S11.min, S11.max, S11.label);
  row_y += FILTER_SLIDER_SPACING;

  define_slider(10, filter_controls_center_x - FILTER_SLIDER_W / 2, row_y, FILTER_SLIDER_W, FILTER_SLIDER_H, 13, S13.min, S13.max, S13.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 10));
  row_y += FILTER_SLIDER_SPACING;

  define_slider(12, filter_controls_center_x - FILTER_SLIDER_W / 2, row_y, FILTER_SLIDER_W, FILTER_SLIDER_H, 18, S18.min, S18.max, S18.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " dB", 12));

  meter_x = GRAPH_X + GRAPH_SIZE + 19;  // Moved 4 pixels to the right
  meter_w = 23;
  area_right = meter_x + meter_w;
  settings_area_center_x = (GRAPH_X + area_right) / 2;
  settings_row_spacing = FILTER_SLIDER_SPACING;
  settings_row_y = filters_area_y + 10;
  SETTINGS_IMAGE_BUTTON_W = 109;
  SETTINGS_IMAGE_BUTTON_H = 81;
  settings_standard_button_w = FILTER_HP_LP_SLIDER_W;
  settings_button_gap = FILTER_HP_LP_GAP;

  settings_two_button_total_width = settings_standard_button_w * 2 + settings_button_gap;
  settings_two_button_start_x = settings_area_center_x - settings_two_button_total_width / 2;
  settings_row_y += settings_row_spacing;

  define_image_button(23, settings_two_button_start_x, settings_row_y, SETTINGS_IMAGE_BUTTON_W, SETTINGS_IMAGE_BUTTON_H, 12, 1, 1, 0, 7, 8, 1);
  define_image_button(24, settings_two_button_start_x + SETTINGS_IMAGE_BUTTON_W + settings_button_gap, settings_row_y, SETTINGS_IMAGE_BUTTON_W, SETTINGS_IMAGE_BUTTON_H, 12, 0, 0, 0, 9, 10, 1);
  settings_row_y += SETTINGS_IMAGE_BUTTON_H + 24;
  settings_row_y += settings_row_spacing;
);

