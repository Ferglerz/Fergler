// Composure Control Layout
// Dependencies: 01_image_sets.jsfx-inc, UI_Sliders/02_control_definitions.jsfx-inc, UI_Sliders/00_file_reading.jsfx-inc

@init

#forward_button_label = 90;
#feedback_button_label = 91;
#milliseconds_button_label = 92;
#microseconds_button_label = 93;

function init_radio_button_labels() (
  strcpy(#feedback_button_label, get_dropdown_option(10, 0));
  strcpy(#forward_button_label, get_dropdown_option(10, 1));
  strcpy(#milliseconds_button_label, get_dropdown_option(7, 0));
  strcpy(#microseconds_button_label, get_dropdown_option(7, 1));
);

//==============================================================================
// GROUP ROW LAYOUT HELPERS
//==============================================================================

// Default padding between rows inside groups (bigger than previous hardcoded 15px)
GROUP_ROW_PADDING_DEFAULT = 40;

// Advance to the next row based on the *actual control height* plus padding.
// Parameters:
//   current_y: current row y (relative to group)
//   control_h: height of the control just placed (for knobs, pass the knob size)
//   padding: optional custom padding; pass 0 to use GROUP_ROW_PADDING_DEFAULT
function advance_group_row_y(current_y, control_h, padding) local(pad) (
  pad = padding > 0 ? padding : GROUP_ROW_PADDING_DEFAULT;
  current_y + control_h + pad
);

// When a control's label/title is hidden, we can start the row slightly higher
// (since the renderer won't draw the label above the control).
// Returns a negative Y offset (typically -LABEL_HEIGHT) when label is hidden.
function get_label_hidden_row_start_offset(format_options) (
  (format_options & OPTION_HIDE_LABEL) ? -LABEL_HEIGHT : 0
);

// Variant for controls that hide labels by passing label slot 0 (e.g. image toggles).
function get_label_slot_row_start_offset(label_slot) (
  label_slot > 0 ? 0 : -LABEL_HEIGHT
);

// Center a control horizontally within a group given the group's width and the control's width.
function center_in_group_x(group_w, control_w) (
  (group_w - control_w) / 2
);

function setup_control_layout() local(group_x, group_y, rel_x, rel_y, group_w, group_h, group_spacing, rel_x_slider, rel_x_button, rel_x_dropdown, groups_start_x, groups_end_x, total_width, group_width, current_y, control_h, control_spacing) (
  init_radio_button_labels();
  
  group_y = UI_PANEL_Y + 15;
  group_spacing = 15;
  group_h = GRAPH_SIZE;
  
  groups_start_x = UI_PANEL_X + 15;
  groups_end_x = GRAPH_X - 40;
  total_width = groups_end_x - groups_start_x;
  group_width = (total_width - (2 * group_spacing)) / 3;
  
  // GROUP 4: ATTACK
  group_x = groups_start_x;
  group_w = group_width;
  define_group(4, group_x, group_y, group_w, group_h, 1, "ATTACK");
  set_control_group(4);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  
  // Knob row: knobs should advance by their full size (use width as height for row spacing)
  control_h = SLIDER_W * 1.0;
  attack_knob_format_options = OPTION_HIDE_LABEL;
  attack_knob_y = current_y + get_label_hidden_row_start_offset(attack_knob_format_options);
  attack_knob_w = SLIDER_W * 1.0;
  attack_knob_x = center_in_group_x(group_w, attack_knob_w);
  define_knob(0, attack_knob_x, attack_knob_y, attack_knob_w, SLIDER_H * 1.0, 1, S1.min, S1.max, S1.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, attack_knob_format_options, " ms", 0), 11, 163, 163, 0, 0, 0.755, 24);
  current_y = advance_group_row_y(attack_knob_y, control_h, 0);
  
  control_h = SLIDER_H;
  slider_w = SLIDER_W;
  slider_x = center_in_group_x(group_w, slider_w);
  define_parallax_fader(1, slider_x, current_y, slider_w, control_h, 2, S2.min, S2.max, S2.label, sm_fader_left.image_top_index, sm_fader_left.image_bot_index, sm_fader_left.image_w, sm_fader_left.image_h, sm_fader_left.para_depth, sm_fader_left.y_offset, sm_fader_left.x_offset, sm_fader_left.image_scale, "", FORMAT_NORMAL, 0, DISPLAY_HIDE_VALUE);
  
  // GROUP 0: ENVELOPE
  group_x = groups_start_x + group_width + group_spacing;
  group_w = group_width;
  define_group(0, group_x, group_y, group_w, group_h, 1, "ENVELOPE");
  set_control_group(0);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  
  control_h = SLIDER_H;
  slider_w = SLIDER_W;
  slider_x = center_in_group_x(group_w, slider_w);
  define_parallax_fader(2, slider_x, current_y, slider_w, control_h, 3, S3.min, S3.max, S3.label, sm_fader_left.image_top_index, sm_fader_left.image_bot_index, sm_fader_left.image_w, sm_fader_left.image_h, sm_fader_left.para_depth, sm_fader_left.y_offset, sm_fader_left.x_offset, sm_fader_left.image_scale, " ms", FORMAT_NORMAL, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  dropdown_w = DROPDOWN_W;
  rel_x_dropdown = center_in_group_x(group_w, dropdown_w);
  control_h = DROPDOWN_H;
  define_dropdown(5, rel_x_dropdown, current_y - 10, dropdown_w, control_h, 6, S6.min, S6.max, S6.label);
  current_y = advance_group_row_y(current_y, control_h, 0);
  control_h = SLIDER_H;
  slider_w = SLIDER_W;
  slider_x = center_in_group_x(group_w, slider_w);
  define_parallax_fader(11, slider_x, current_y, slider_w, control_h, 13, S13.min, S13.max, S13.label, sm_fader_left.image_top_index, sm_fader_left.image_bot_index, sm_fader_left.image_w, sm_fader_left.image_h, sm_fader_left.para_depth, sm_fader_left.y_offset, sm_fader_left.x_offset, sm_fader_left.image_scale, " %", FORMAT_NONE, 0, DISPLAY_HIDE_VALUE);
  
  // GROUP 5: RELEASE
  group_x = groups_start_x + (group_width + group_spacing) * 2;
  group_w = group_width;
  define_group(5, group_x, group_y, group_w, group_h, 1, "RELEASE");
  set_control_group(5);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  
  // Knob row: advance by full knob size
  control_h = SLIDER_W * 1.0;
  release_knob_format_options = OPTION_HIDE_LABEL;
  release_knob_y = current_y + get_label_hidden_row_start_offset(release_knob_format_options);
  release_knob_w = SLIDER_W * 1.0;
  release_knob_x = center_in_group_x(group_w, release_knob_w);
  define_knob(3, release_knob_x, release_knob_y, release_knob_w, SLIDER_H * 1.0, 4, S4.min, S4.max, S4.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, release_knob_format_options, " ms", 3), 11, 163, 163, 0, 0, 0.755, 24);
  current_y = advance_group_row_y(release_knob_y, control_h, 0);
  
  control_h = SLIDER_H;
  slider_w = SLIDER_W;
  slider_x = center_in_group_x(group_w, slider_w);
  define_parallax_fader(4, slider_x, current_y, slider_w, control_h, 5, S5.min, S5.max, S5.label, sm_fader_left.image_top_index, sm_fader_left.image_bot_index, sm_fader_left.image_w, sm_fader_left.image_h, sm_fader_left.para_depth, sm_fader_left.y_offset, sm_fader_left.x_offset, sm_fader_left.image_scale, "", FORMAT_NORMAL, 0, DISPLAY_HIDE_VALUE);
  
  // GROUP 3: HARMONICS
  group_x = GRAPH_X + GRAPH_SIZE + 15 + 23 + 8 + 6 + 15 + 16;
  group_w = 150;
  group_h = GRAPH_SIZE;
  define_group(3, group_x, group_y, group_w, group_h, 1, "HARMONICS");
  set_control_group(3);
  rel_x_slider = center_in_group_x(group_w, SLIDER_W);
  rel_x_dropdown = center_in_group_x(group_w, DROPDOWN_W);
  rel_x_button = center_in_group_x(group_w, BUTTON_W);
  rel_y = GROUP_TITLE_HEIGHT + GROUP_PADDING + 15;
  current_y = rel_y;
  control_h = BUTTON_H;
  // Harmonic type: hide title above the toggle by passing label slot 0
  harmonic_type_label_slot = 0;
  harmonic_type_y = current_y + get_label_slot_row_start_offset(harmonic_type_label_slot);
  define_image_button(17, rel_x_button, harmonic_type_y, BUTTON_W, control_h, 19, S19.min, S19.max, harmonic_type_label_slot, 1, 2, 1);
  current_y = advance_group_row_y(harmonic_type_y, control_h, 0);
  control_h = SLIDER_H;
  define_parallax_fader(18, rel_x_slider, current_y, SLIDER_W, control_h, 20, S20.min, S20.max, S20.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, "", FORMAT_NORMAL, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(19, rel_x_slider, current_y, SLIDER_W, control_h, 21, S21.min, S21.max, S21.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, " %", FORMAT_NONE, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(20, rel_x_slider, current_y, SLIDER_W, control_h, 22, S22.min, S22.max, S22.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, " %", FORMAT_NONE, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  define_parallax_fader(21, rel_x_slider, current_y, SLIDER_W, control_h, 23, S23.min, S23.max, S23.label, sm_fader_rt.image_top_index, sm_fader_rt.image_bot_index, sm_fader_rt.image_w, sm_fader_rt.image_h, sm_fader_rt.para_depth, sm_fader_rt.y_offset, sm_fader_rt.x_offset, sm_fader_rt.image_scale, " %", FORMAT_NONE, 0, DISPLAY_HIDE_VALUE);
  current_y = advance_group_row_y(current_y, control_h, 0);
  
  // Makeup knob: advance by its actual size (half-size knob)
  control_h = SLIDER_W * 0.5;
  makeup_knob_format_options = OPTION_BIDIRECTIONAL | OPTION_HIDE_LABEL;
  makeup_knob_y = current_y + get_label_hidden_row_start_offset(makeup_knob_format_options);
  makeup_knob_w = SLIDER_W * 0.5;
  makeup_knob_x = center_in_group_x(group_w, makeup_knob_w);
  define_knob(22, makeup_knob_x, makeup_knob_y, makeup_knob_w, SLIDER_H * 0.5, 25, S25.min, S25.max, S25.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, makeup_knob_format_options, " dB", 22), 11, 163, 163, 0, 0, 0.377, 24);
  
  // PAGE_FILTERS: UNGROUPED CONTROLS
  filters_area_x = GRAPH_X;
  filters_area_y = GRAPH_Y;
  filters_area_w = (GRAPH_X + GRAPH_SIZE + 15 + 23) - GRAPH_X;
  filters_area_h = GRAPH_SIZE;
  set_control_group(-1);
  
  FILTER_SLIDER_W = SLIDER_W * 2;
  FILTER_SLIDER_H = SLIDER_H * 2;
  FILTER_SLIDER_SPACING = FILTER_SLIDER_H + 24;
  filter_controls_center_x = filters_area_x + filters_area_w / 2;
  
  row_y = filters_area_y + 10;
  
  // ============================================================================
  // ROW 0: Input Offset
  // ============================================================================
  define_slider(12, filter_controls_center_x - FILTER_SLIDER_W / 2, row_y, FILTER_SLIDER_W, FILTER_SLIDER_H, 14, S14.min, S14.max, S14.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " dB", 12));
  
  row_y += FILTER_SLIDER_SPACING;
  
  // ============================================================================
  // ROW 1: High Pass and Low Pass
  // ============================================================================
  FILTER_HP_LP_SLIDER_W = (FILTER_SLIDER_W / 2) - 5;
  FILTER_HP_LP_GAP = 10;
  filter_hp_lp_total_width = FILTER_HP_LP_SLIDER_W * 2 + FILTER_HP_LP_GAP;
  filter_hp_lp_start_x = filter_controls_center_x - filter_hp_lp_total_width / 2;
  
  define_slider(15, filter_hp_lp_start_x, row_y, FILTER_HP_LP_SLIDER_W, FILTER_SLIDER_H, 17, S17.min, S17.max, S17.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_K, 0, " Hz", 15));
  define_slider(16, filter_hp_lp_start_x + FILTER_HP_LP_SLIDER_W + FILTER_HP_LP_GAP, row_y, FILTER_HP_LP_SLIDER_W, FILTER_SLIDER_H, 18, S18.min, S18.max, S18.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_RIGHT_TO_LEFT, FORMAT_K, 0, " Hz", 16));
  
  row_y += FILTER_SLIDER_SPACING;
  
  // ============================================================================
  // ROW 2: Listen, Auto-preview, and Use Sidechain buttons
  // ============================================================================
  FILTER_THREE_BUTTON_W = 75;
  FILTER_THREE_BUTTON_GAP = 10;
  filter_three_button_total_width = FILTER_THREE_BUTTON_W * 3 + FILTER_THREE_BUTTON_GAP * 2;
  filter_three_button_start_x = filter_controls_center_x - filter_three_button_total_width / 2;
  
  define_button(9, filter_three_button_start_x, row_y, FILTER_THREE_BUTTON_W, BUTTON_H, 16, S16.min, S16.max, S16.label);
  define_button(27, filter_three_button_start_x + FILTER_THREE_BUTTON_W + FILTER_THREE_BUTTON_GAP + FILTER_THREE_BUTTON_W + FILTER_THREE_BUTTON_GAP, row_y, FILTER_THREE_BUTTON_W, BUTTON_H, 15, S15.min, S15.max, S15.label);
  
  row_y += FILTER_SLIDER_SPACING;
  
  // ============================================================================
  // ROW 3: RMS Window and Normalize button
  // ============================================================================
  define_slider(7, filter_hp_lp_start_x, row_y, FILTER_HP_LP_SLIDER_W, FILTER_SLIDER_H, 8, S8.min, S8.max, S8.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 7));
  define_button(8, filter_hp_lp_start_x + FILTER_HP_LP_SLIDER_W + FILTER_HP_LP_GAP, row_y, FILTER_HP_LP_SLIDER_W, BUTTON_H, 9, S9.min, S9.max, S9.label);
  
  row_y += FILTER_SLIDER_SPACING;
  
  // ============================================================================
  // ROW 4: Lookahead
  // ============================================================================
  define_slider(10, filter_controls_center_x - FILTER_SLIDER_W / 2, row_y, FILTER_SLIDER_W, FILTER_SLIDER_H, 11, S11.min, S11.max, S11.label, create_ui_control(ORIENTATION_HORIZONTAL, DISPLAY_NORMAL, FILL_LEFT_TO_RIGHT, FORMAT_NORMAL, 0, " ms", 10));
  
  // ============================================================================
  // SETTINGS PAGE
  // ============================================================================
  meter_x = GRAPH_X + GRAPH_SIZE + 15;
  meter_w = 23;
  area_right = meter_x + meter_w;
  settings_area_center_x = (GRAPH_X + area_right) / 2;
  
  settings_row_spacing = FILTER_SLIDER_SPACING;
  settings_row_y = filters_area_y + 10;
  
  SETTINGS_IMAGE_BUTTON_W = 109;
  SETTINGS_IMAGE_BUTTON_H = 81;
  
  settings_standard_button_w = FILTER_HP_LP_SLIDER_W;
  settings_button_gap = FILTER_HP_LP_GAP;
  
  // ============================================================================
  // ROW 0: Brickwall Limiter and Debug
  // ============================================================================
  settings_two_button_total_width = settings_standard_button_w * 2 + settings_button_gap;
  settings_two_button_start_x = settings_area_center_x - settings_two_button_total_width / 2;
  
  settings_row_y += settings_row_spacing;
  
  // ============================================================================
  // ROW 1: Feedforward/Feedback buttons
  // ============================================================================
  settings_image_button_total_width = SETTINGS_IMAGE_BUTTON_W * 2 + settings_button_gap;
  settings_image_button_start_x = settings_area_center_x - settings_image_button_total_width / 2;
  
  define_image_button(23, settings_image_button_start_x, settings_row_y, SETTINGS_IMAGE_BUTTON_W, SETTINGS_IMAGE_BUTTON_H, 10, 1, 1, 0, 7, 8, 1);
  define_image_button(24, settings_image_button_start_x + SETTINGS_IMAGE_BUTTON_W + settings_button_gap, settings_row_y, SETTINGS_IMAGE_BUTTON_W, SETTINGS_IMAGE_BUTTON_H, 10, 0, 0, 0, 9, 10, 1);
  
  settings_row_y += SETTINGS_IMAGE_BUTTON_H + 24;
  
  // ============================================================================
  // ROW 2: Milliseconds/Microseconds buttons
  // ============================================================================
  define_button(25, settings_two_button_start_x, settings_row_y, settings_standard_button_w, BUTTON_H, 7, 0, 0, #milliseconds_button_label);
  define_button(26, settings_two_button_start_x + settings_standard_button_w + settings_button_gap, settings_row_y, settings_standard_button_w, BUTTON_H, 7, 1, 1, #microseconds_button_label);
  
  settings_row_y += settings_row_spacing;
  
);

