// Control Rendering
// Functions for rendering all controls with page-based filtering
// Dependencies: UI_Sliders/01_control_definitions.jsfx-inc

@init

//==============================================================================
// CONTROL PAGE ASSIGNMENT
//==============================================================================

// Check if a control is on the Filters page
// Returns: 1 if control is on Filters page, 0 otherwise
// Filters page controls: 7, 8, 9, 13, 15, 16, 23, 24, 25, 26
// Note: Control 12 = Input Offset (header), Control 22 = Output Gain (header) - NOT on Filters page
function is_control_on_filters_page(control_index) (
  (control_index == 7 || control_index == 8 || control_index == 9 || control_index == 13 || control_index == 15 || control_index == 16 || control_index == 23 || control_index == 24 || control_index == 25 || control_index == 26) ? 1 : 0;
);

//==============================================================================
// CONTROL RENDERING
//==============================================================================

// Render all controls with page-based filtering and opacity
function render_all_controls_with_page_filtering() (
  i = 0;
  while (i < control_count) (
    // Input page controls - only render if Input page should be visible
    is_control_on_filters_page(i) ? (
      should_render_page(PAGE_FILTERS) ? (
        // Render with fade opacity
        render_control(i, get_page_fade_amount(PAGE_FILTERS));
      );
    ) : (
      // Other controls - render with full opacity
      render_control(i, 1.0);
    );
    i += 1;
  );
);

