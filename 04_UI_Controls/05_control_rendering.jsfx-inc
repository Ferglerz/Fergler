// Control Rendering
// Functions for rendering all controls with page-based filtering
// Dependencies: UI_Sliders/01_control_definitions.jsfx-inc

@init

//==============================================================================
// CONTROL PAGE ASSIGNMENT
//==============================================================================

// Check if a control is on the Filters (Input) page
// Returns: 1 if control is on Filters page, 0 otherwise
// Input page controls: 0-3 (Env Curves), 16-23 (Filters/Detection)
function is_control_on_filters_page(control_index) (
  (control_index >= 16 && control_index <= 23) ? 1 : 0;
);

// Check if a control is on the Settings page
// Returns: 1 if control is on Settings page, 0 otherwise
// Settings page controls: 4-9 (Env/Prog Release), 24-25 (Detection Mode), 30-31 (Brickwall/Linear)
function is_control_on_settings_page(control_index) (
  (control_index >= 4 && control_index <= 9) || (control_index >= 24 && control_index <= 25) || (control_index >= 30 && control_index <= 31) ? 1 : 0;
);



// Override library's is_control_interactive to provide page filtering
// This function overrides the default in FerglerUI/Interaction/00_control_interactions.jsfx-inc
function is_control_interactive(i)(
  is_control_on_filters_page(i) ? should_render_page(PAGE_FILTERS)
  : is_control_on_settings_page(i) ? should_render_page(PAGE_SETTINGS)
  : 1;
);

//==============================================================================
// CONTROL RENDERING
//==============================================================================

// Render all controls with page-based filtering and opacity
function render_all_controls_with_page_filtering() (
  i = 0;
  while (i < control_count) (
    // Input page controls - only render if Input page should be visible
    is_control_on_filters_page(i) ? (
      should_render_page(PAGE_FILTERS) ? (
        // Render with fade opacity
        render_control(i, page_fade_amounts[PAGE_FILTERS]);
      );
    ) : is_control_on_settings_page(i) ? (
      // Settings page controls - only render if Settings page should be visible
      should_render_page(PAGE_SETTINGS) ? (
        // Render with fade opacity
        render_control(i, page_fade_amounts[PAGE_SETTINGS]);
      );
    ) : (
      // Other controls - render with full opacity
      render_control(i, 1.0);
    );
    i += 1;
  );
);

