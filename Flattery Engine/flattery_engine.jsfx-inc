// Flattery Engine - Master Include File
// Import this file to use the Flattery Engine library
// All functions accept parameter arrays instead of reading sliders

@init

// Phase 0: Parameters and Constants
import ./01_Utils/01_parameters.jsfx-inc
import ./01_Utils/02_constants.jsfx-inc
import ./01_Utils/03_math_utils.jsfx-inc
import ./01_Utils/04_param_sync.jsfx-inc

// Phase 1: FFT and Memory
import ./02_FFT/01_fft_memory.jsfx-inc
import ./02_FFT/02_fft_core.jsfx-inc
import ./02_FFT/03_filter_bank.jsfx-inc
import ./02_FFT/04_iir_filters.jsfx-inc

// Phase 2: Processing
import ./03_Processing/05d_param_cache.jsfx-inc
import ./03_Processing/02_attack_release.jsfx-inc
import ./03_Processing/03_surround_logic.jsfx-inc
import ./03_Processing/04a_stft_spectrum.jsfx-inc
import ./03_Processing/04b_stft_deltas.jsfx-inc
import ./03_Processing/04c_stft_gains.jsfx-inc
import ./03_Processing/04d_stft_synthesis.jsfx-inc
import ./03_Processing/04_stft_process.jsfx-inc
import ./03_Processing/05a_tilt_calculation.jsfx-inc
import ./03_Processing/05b_rate_of_change.jsfx-inc
import ./03_Processing/05c_filter_mapping.jsfx-inc
import ./03_Processing/06_output_mix.jsfx-inc

// Phase 3: UI
import ./04_UI/01_ui_constants.jsfx-inc
import ./04_UI/02_ui_coordinates.jsfx-inc
import ./04_UI/03_ui_rendering_helpers.jsfx-inc
import ./04_UI/04_ui_graph_rendering.jsfx-inc
import ./04_UI/05_ui_interaction.jsfx-inc
import ./04_UI/06_ui_orchestration.jsfx-inc
import ./04_UI/01_ui.jsfx-inc

// Phase 4: Engine API (must be last - depends on everything)
import ./00_engine_api.jsfx-inc

