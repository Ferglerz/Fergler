// UI Rendering Helpers (Simplified)
@init 

// Catmull-Rom spline helper
function sff_draw_catmull_rom_spline(p0_x, p0_y, p1_x, p1_y, p2_x, p2_y, p3_x, p3_y, draw_bins, r, g, b, a) local(
  steps, t, x0, y0, x1, y1, k
)(
  steps = min(max(abs(p2_x-p1_x)|0,1),draw_bins);
  x0 = p1_x; y0 = p1_y;
  k = 1;
  loop(steps,
    t = k/steps;
    x1 = ((-0.5*p0_x+1.5*p1_x-1.5*p2_x+0.5*p3_x)*t*t*t
         +(p0_x-2.5*p1_x+2.0*p2_x-0.5*p3_x)*t*t
         +(-0.5*p0_x+0.5*p2_x)*t
         +p1_x);
    y1 = ((-0.5*p0_y+1.5*p1_y-1.5*p2_y+0.5*p3_y)*t*t*t
         +(p0_y-2.5*p1_y+2.0*p2_y-0.5*p3_y)*t*t
         +(-0.5*p0_y+0.5*p2_y)*t
         +p1_y);
    gfx_set(r,g,b,a);
    gfx_line(x0|0,y0,x1|0,y1,0);
    x0 = x1; y0 = y1; k+=1;
  );
  gfx_set(r,g,b,a);
  gfx_line(x0|0,y0,p2_x|0,p2_y,0);
);

// Catmull-Rom spline + filled area helper
function sff_draw_catmull_rom_spline_filled(
  p0_x,p0_y,p1_x,p1_y,p2_x,p2_y,p3_x,p3_y,
  draw_bins, y_base,
  rL,gL,bL,aL,rF,gF,bF,aF
) local(
  steps, t, x0, y0, x1, y1, k, sx,sxe,sw,sty,sh
)(
  steps = min(max(abs(p2_x-p1_x)|0,1),draw_bins);
  x0 = p1_x; y0 = p1_y;
  k = 1;
  loop(steps,
    t = k/steps;
    x1 = ((-0.5*p0_x+1.5*p1_x-1.5*p2_x+0.5*p3_x)*t*t*t
         +(p0_x-2.5*p1_x+2.0*p2_x-0.5*p3_x)*t*t
         +(-0.5*p0_x+0.5*p2_x)*t
         +p1_x);
    y1 = ((-0.5*p0_y+1.5*p1_y-1.5*p2_y+0.5*p3_y)*t*t*t
         +(p0_y-2.5*p1_y+2.0*p2_y-0.5*p3_y)*t*t
         +(-0.5*p0_y+0.5*p2_y)*t
         +p1_y);
    sx = min(x0|0,x1|0); sxe = max(x0|0,x1|0);
    sw=sxe-sx; sty = min(y0,y1); sh = y_base-sty;
    gfx_set(rF,gF,bF,aF); (sw>0&&sh>0) ? gfx_rect(sx,sty,sw,sh);
    gfx_set(rL,gL,bL,aL); gfx_line(x0|0,y0,x1|0,y1,0);
    x0 = x1; y0 = y1; k+=1;
  );
  sx = min(x0|0,p2_x|0); sxe = max(x0|0,p2_x|0); sw = sxe-sx; sty = min(y0,p2_y); sh = y_base-sty;
  gfx_set(rF,gF,bF,aF); (sw>0&&sh>0) ? gfx_rect(sx,sty,sw,sh);
  gfx_set(rL,gL,bL,aL); gfx_line(x0|0,y0,p2_x|0,p2_y,0);
);

// Draw downward triangle
function sff_draw_triangle(x, y, size, r,g,b) local(i,v,w)(
  i=0;
  loop(size+1,
    v = i/size; w = size*(1-v);
    gfx_set(r,g,b,1);
    gfx_line(x-w, y+i, x+w, y+i, 0);
    i+=1;
  );
);

// Draw vertical line and optional triangle on top
function sff_draw_cut_line(x, y_top, y_bottom, tri_size, r,g,b)(
  gfx_set(r,g,b,1); gfx_line(x, y_top, x, y_bottom, 0);
  tri_size>0 ? sff_draw_triangle(x, y_top, tri_size, r,g,b):0;
);

// Draw a single dB label (unit removed for cleaner axis)
function sff_draw_db_label(db, x, y_base, h, inv_scale, plus) local(y)(
  y = y_base - (db+12)*inv_scale*(h-8);
  plus && db>0 ? sprintf(#sff_tmp_str,"+%.0f",db)
               : sprintf(#sff_tmp_str,"%.0f",db);
  gfx_set(SFF_COLOR_TEXT_R,SFF_COLOR_TEXT_G,SFF_COLOR_TEXT_B,1);
  gfx_x=x; gfx_y=y-SFF_LABEL_OFFSET_Y;
  gfx_drawstr(#sff_tmp_str);
);

// Draw many dB labels
function sff_draw_db_labels(start_db, end_db, step, x, y_base, h, inv_scale, plus) local(db)(
  db=start_db;
  loop((end_db-start_db)/step+1,
    sff_draw_db_label(db, x, y_base, h, inv_scale, plus); db+=step;
  );
);

// Draw a frequency label
function sff_draw_frequency_label(f, min_f, max_f, x0, bins, y, txt) local(p, lx)(
  p = sff_freq_to_pos(f,min_f,max_f);
  lx = sff_pos_to_x(p, x0, bins);
  sprintf(#sff_tmp_str, txt);
  gfx_set(SFF_COLOR_TEXT_R,SFF_COLOR_TEXT_G,SFF_COLOR_TEXT_B,1);
  gfx_x=lx; gfx_y=y-SFF_LABEL_OFFSET_Y;
  gfx_drawstr(#sff_tmp_str);
);
