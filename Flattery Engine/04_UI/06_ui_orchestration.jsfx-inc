// Surround FFT Flattener - UI Orchestration (Main Draw Function)

@init

// Main UI draw function - orchestrates all rendering
function sff_ui_draw() local(
  x0, y0, w, h, avail_w, draw_bins, draw_bins_inv, y_base,
  min_freq, max_freq, low_cut_pos, high_cut_pos, low_cut_x, high_cut_x,
  triangle_size, triangle_top_y
) (
  // Clear background
  gfx_set(SFF_COLOR_BG_R, SFF_COLOR_BG_G, SFF_COLOR_BG_B, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);

  // Calculate layout
  x0 = SFF_UI_MARGIN;
  y0 = SFF_UI_MARGIN;
  w = gfx_w - (SFF_UI_MARGIN * 2);
  h = gfx_h - (SFF_UI_MARGIN * 2);

  // Bars area
  avail_w = max(w - (SFF_UI_INNER_MARGIN * 2), 1);
  draw_bins = avail_w;  // One bar per pixel
  draw_bins_inv = 1.0 / max(draw_bins - 1, 1);
  y_base = y0 + h - (SFF_UI_INNER_MARGIN * 2);
  
  // Frequency range: 10 Hz to Nyquist (srate/2)
  min_freq = 10;
  max_freq = srate * 0.5;

  // Draw background
  sff_draw_background(x0, y0, w, h, draw_bins, draw_bins_inv, min_freq, max_freq);

  // Calculate cut positions in logarithmic space (always from frequency - single source of truth)
  low_cut_pos = sff_freq_to_pos(low_cut_hz, min_freq, max_freq);
  high_cut_pos = sff_freq_to_pos(high_cut_hz, min_freq, max_freq);
  low_cut_x = sff_pos_to_x(low_cut_pos, x0, draw_bins);
  high_cut_x = sff_pos_to_x(high_cut_pos, x0, draw_bins);

  // Draw magnitude curve
  sff_draw_magnitude_curve(x0, y_base, h, draw_bins, min_freq, max_freq, low_cut_hz, high_cut_hz);

  // Draw filter gain curve
  sff_draw_filter_gain_curve(x0, y_base, h, draw_bins, min_freq, max_freq, low_cut_hz, high_cut_hz);

  // Draw center line
  sff_draw_center_line(x0, y_base, h, avail_w);

  // Draw tilt visualization
  sff_draw_tilt_visualization(x0, y_base, h, draw_bins, draw_bins_inv, min_freq, max_freq);

  // Triangle size and position for handles
  triangle_size = SFF_TRIANGLE_SIZE;
  triangle_top_y = y0 + SFF_UI_INNER_MARGIN;

  // Handle mouse interaction
  sff_handle_cut_line_interaction(low_cut_x, high_cut_x, triangle_top_y, h, x0, draw_bins, draw_bins_inv, min_freq, max_freq);

  // Recalculate cut positions after interaction (in case they changed)
  low_cut_pos = sff_freq_to_pos(low_cut_hz, min_freq, max_freq);
  high_cut_pos = sff_freq_to_pos(high_cut_hz, min_freq, max_freq);
  low_cut_x = sff_pos_to_x(low_cut_pos, x0, draw_bins);
  high_cut_x = sff_pos_to_x(high_cut_pos, x0, draw_bins);

  // Draw cut lines with triangles
  sff_draw_cut_lines(low_cut_x, high_cut_x, triangle_top_y, y_base, triangle_size);

  // Draw all labels
  sff_draw_labels(x0, y_base, h, draw_bins, min_freq, max_freq);
);

// Parameterized UI draw function - accepts parameter array instead of reading sliders
// params_base: parameter array (can be same as engine params or different for preview)
function sff_ui_draw_with_params(params_base) local(
  x0, y0, w, h, avail_w, draw_bins, draw_bins_inv, y_base,
  min_freq, max_freq, low_cut_pos, high_cut_pos, low_cut_x, high_cut_x,
  triangle_size, triangle_top_y, params_low_cut_hz, params_high_cut_hz
) (
  // Get cut frequencies from parameters
  params_low_cut_hz = sff_param_get_low_cut_hz(params_base);
  params_high_cut_hz = sff_param_get_high_cut_hz(params_base);
  
  // Clear background
  gfx_set(SFF_COLOR_BG_R, SFF_COLOR_BG_G, SFF_COLOR_BG_B, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);

  // Calculate layout
  x0 = SFF_UI_MARGIN;
  y0 = SFF_UI_MARGIN;
  w = gfx_w - (SFF_UI_MARGIN * 2);
  h = gfx_h - (SFF_UI_MARGIN * 2);

  // Bars area
  avail_w = max(w - (SFF_UI_INNER_MARGIN * 2), 1);
  draw_bins = avail_w;  // One bar per pixel
  draw_bins_inv = 1.0 / max(draw_bins - 1, 1);
  y_base = y0 + h - (SFF_UI_INNER_MARGIN * 2);
  
  // Frequency range: 10 Hz to Nyquist (srate/2)
  min_freq = 10;
  max_freq = srate * 0.5;

  // Draw background
  sff_draw_background(x0, y0, w, h, draw_bins, draw_bins_inv, min_freq, max_freq);

  // Calculate cut positions in logarithmic space (always from frequency - single source of truth)
  low_cut_pos = sff_freq_to_pos(params_low_cut_hz, min_freq, max_freq);
  high_cut_pos = sff_freq_to_pos(params_high_cut_hz, min_freq, max_freq);
  low_cut_x = sff_pos_to_x(low_cut_pos, x0, draw_bins);
  high_cut_x = sff_pos_to_x(high_cut_pos, x0, draw_bins);

  // Draw magnitude curve
  sff_draw_magnitude_curve(x0, y_base, h, draw_bins, min_freq, max_freq, params_low_cut_hz, params_high_cut_hz);

  // Draw filter gain curve
  sff_draw_filter_gain_curve(x0, y_base, h, draw_bins, min_freq, max_freq, params_low_cut_hz, params_high_cut_hz);

  // Draw center line
  sff_draw_center_line(x0, y_base, h, avail_w);

  // Draw tilt visualization
  sff_draw_tilt_visualization(x0, y_base, h, draw_bins, draw_bins_inv, min_freq, max_freq);

  // Triangle size and position for handles
  triangle_size = SFF_TRIANGLE_SIZE;
  triangle_top_y = y0 + SFF_UI_INNER_MARGIN;

  // Note: Mouse interaction updates global low_cut_hz/high_cut_hz, so we sync back to params if needed
  // For now, we'll use the parameter values for display
  // In a full implementation, mouse interaction would update the parameter array

  // Draw cut lines with triangles
  sff_draw_cut_lines(low_cut_x, high_cut_x, triangle_top_y, y_base, triangle_size);

  // Draw all labels
  sff_draw_labels(x0, y_base, h, draw_bins, min_freq, max_freq);
);

